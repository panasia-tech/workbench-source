/* 「今天」：照销售工作台交付包的排法（问候、三张卡、一列红黄任务），浅色 */
.swb-page .swb-head { padding: 8rpx 4rpx 0; }
.swb-page .swb-eyebrow { font-size: 24rpx; font-weight: 700; color: #2563EB; }
.swb-page .swb-hello { margin-top: 4rpx; font-size: 48rpx; font-weight: 800; color: #111827; line-height: 1.2; }
.swb-page .swb-lead { margin-top: 10rpx; font-size: 26rpx; color: #6B7280; line-height: 1.5; }
.swb-page .swb-q { display: inline-block; width: 36rpx; height: 36rpx; line-height: 36rpx; margin-left: 8rpx; text-align: center; border-radius: 50%; border: 1rpx solid #D1D5DB; color: #6B7280; font-size: 22rpx; }
.swb-page .swb-help { margin-top: 12rpx; padding: 16rpx 20rpx; border-radius: 16rpx; background: #FFFFFF; font-size: 24rpx; color: #4B5563; line-height: 1.6; }
.swb-page .swb-help view + view { margin-top: 8rpx; }

.swb-page .swb-gate { display: flex; align-items: center; gap: 20rpx; margin-top: 24rpx; padding: 22rpx 24rpx; border-radius: 20rpx; background: #FFFBEB; border: 2rpx solid #FCD34D; }
.swb-page .swb-gate__text { flex: 1; font-size: 26rpx; color: #92400E; font-weight: 600; line-height: 1.5; }
.swb-page .swb-gate__btn { flex: none; padding: 12rpx 26rpx; border-radius: 999rpx; background: #D97706; color: #FFFFFF; font-size: 26rpx; font-weight: 700; }

.swb-page .swb-cards { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; margin-top: 24rpx; }
.swb-page .swb-card { padding: 24rpx; border-radius: 24rpx; background: #FFFFFF; border: 1rpx solid #E5E7EB; box-shadow: 0 2rpx 12rpx rgba(15, 23, 42, 0.06); min-width: 0; }
.swb-page .swb-card--wide { grid-column: 1 / -1; display: grid; grid-template-columns: auto 1fr; align-items: center; column-gap: 24rpx; }
.swb-page .swb-card--wide .swb-card__k { grid-column: 1 / -1; }
.swb-page .swb-card__k { font-size: 24rpx; font-weight: 600; color: #6B7280; }
.swb-page .swb-card__big { margin-top: 6rpx; font-size: 52rpx; font-weight: 800; color: #111827; line-height: 1.15; letter-spacing: -1rpx; }
.swb-page .swb-card__unit { font-size: 24rpx; font-weight: 600; color: #6B7280; letter-spacing: 0; }
.swb-page .swb-card__k2 { margin-top: 8rpx; font-size: 22rpx; color: #6B7280; }
.swb-page .swb-card__tags { display: flex; gap: 10rpx; flex-wrap: wrap; }
.swb-page .swb-pill { padding: 4rpx 16rpx; border-radius: 999rpx; background: #F3F4F6; color: #374151; font-size: 22rpx; font-weight: 700; }
.swb-page .swb-pill--yellow { background: #FEF3C7; color: #92400E; }

.swb-page .swb-grp { display: flex; align-items: center; gap: 12rpx; margin: 36rpx 4rpx 16rpx; font-size: 32rpx; font-weight: 800; color: #111827; }
.swb-page .swb-grp__n { padding: 2rpx 16rpx; border-radius: 999rpx; background: #E5E7EB; color: #4B5563; font-size: 22rpx; font-weight: 700; }
.swb-page .swb-dot { width: 14rpx; height: 14rpx; border-radius: 50%; }
.swb-page .swb-dot--red { background: #DC2626; }
.swb-page .swb-dot--yellow { background: #D97706; }
.swb-page .swb-empty { padding: 20rpx 8rpx; color: #9CA3AF; font-size: 26rpx; }
.swb-page .swb-more { margin: 4rpx 8rpx 8rpx; font-size: 24rpx; color: #6B7280; line-height: 1.6; }
.swb-page .swb-link { color: #2563EB; font-weight: 600; }

.swb-page .swb-row { display: flex; align-items: center; gap: 18rpx; margin-bottom: 16rpx; padding: 20rpx 20rpx 20rpx 18rpx; border-radius: 24rpx; background: #FFFFFF; border-left: 10rpx solid #E5E7EB; box-shadow: 0 2rpx 12rpx rgba(15, 23, 42, 0.06); }
.swb-page .swb-row:active { opacity: 0.85; }
.swb-page .swb-row--red { border-left-color: #DC2626; }
.swb-page .swb-row--yellow { border-left-color: #D97706; }
.swb-page .swb-row__ic { flex: none; width: 44rpx; height: 44rpx; line-height: 44rpx; text-align: center; border-radius: 50%; font-size: 24rpx; font-weight: 800; }
.swb-page .swb-row--red .swb-row__ic { background: #FEE2E2; color: #DC2626; }
.swb-page .swb-row--yellow .swb-row__ic { background: #FEF3C7; color: #B45309; }
.swb-page .swb-row__th { flex: none; width: 112rpx; height: 112rpx; border-radius: 18rpx; background: #F3F4F6; }
.swb-page .swb-row__th--none { display: flex; align-items: center; justify-content: center; color: #9CA3AF; font-size: 22rpx; font-weight: 700; }
.swb-page .swb-row__mid { flex: 1; min-width: 0; }
.swb-page .swb-row__line { font-size: 28rpx; font-weight: 700; color: #111827; line-height: 1.45; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.swb-page .swb-row__sub { margin-top: 6rpx; font-size: 23rpx; color: #6B7280; line-height: 1.5; }
.swb-page .swb-tag { display: inline-block; margin-right: 10rpx; padding: 0 12rpx; border-radius: 8rpx; font-size: 21rpx; font-weight: 700; line-height: 34rpx; vertical-align: 2rpx; }
.swb-page .swb-tag--red { background: #FEE2E2; color: #B91C1C; }
.swb-page .swb-tag--yellow { background: #FEF3C7; color: #92400E; }
.swb-page .swb-row__btn { flex: none; padding: 10rpx 20rpx; border-radius: 999rpx; background: #2563EB; color: #FFFFFF; font-size: 24rpx; font-weight: 700; }
.swb-page .swb-row__btn--plain { background: #EFF6FF; color: #1D4ED8; }
.swb-page .swb-row__btn.is-off { background: #E5E7EB; color: #9CA3AF; }

.swb-page .swb-accs { margin-top: 36rpx; }

.swb-page .swb-acc {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F3F4F6;
}

.swb-page .swb-acc:last-child {
  border-bottom: none;
}

.swb-page .swb-acc__nick {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 700;
  color: #111827;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.swb-page .swb-acc__meta {
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: 600;
  color: #6B7280;
}

.swb-page .swb-acc__wait {
  color: #DC2626;
}

/* 主管：加派任务入口 */
.swb-page .swb-assign { margin-top: 20rpx; padding: 22rpx 28rpx; border-radius: 20rpx; background: #EFF6FF; border: 1rpx solid #BFDBFE; }
.swb-page .swb-assign__t { display: block; font-size: 28rpx; font-weight: 700; color: #1D4ED8; }
.swb-page .swb-assign__s { display: block; margin-top: 4rpx; font-size: 22rpx; color: #4B5563; }
.swb-page .swb-acts { display: flex; gap: 16rpx; margin-top: 20rpx; }
.swb-page .swb-act { flex: 1; padding: 18rpx 0; text-align: center; border-radius: 16rpx; border: 1rpx solid #E5E7EB; background: #FFFFFF; color: #374151; font-size: 26rpx; font-weight: 600; }
