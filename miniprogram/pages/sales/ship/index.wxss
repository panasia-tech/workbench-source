.sales-ship-page .ship-order-info {

  margin-bottom: 24rpx;

  padding: 24rpx 28rpx;

  background: #F9FAFB;

  border-radius: 24rpx;

}



.sales-ship-page .ship-order-title {

  font-size: 30rpx;

  font-weight: 700;

  color: #111827;

  margin-bottom: 8rpx;

  line-height: 1.4;

  word-break: break-all;

}



.sales-ship-page .ship-order-sub {

  font-size: 24rpx;

  color: #6B7280;

  font-weight: 600;

  line-height: 1.5;

}



.sales-ship-page .ship-mode-seg {
  margin-bottom: 16rpx;
}

.sales-ship-page .form-note {

  font-size: 24rpx;

  color: #6B7280;

  margin: 0 0 24rpx;

  font-weight: 600;

  line-height: 1.5;

}



.sales-ship-page .match-box {

  margin-bottom: 24rpx;

  padding: 20rpx 24rpx;

  background: #EFF6FF;

  border: 1rpx solid #BFDBFE;

  border-radius: 24rpx;

}



.sales-ship-page .match-box__text {

  font-size: 24rpx;

  font-weight: 600;

  color: #2563EB;

  line-height: 1.5;

  word-break: break-all;

}



.ship-review-entry {
  display: block;
  margin: 16rpx 0;
  padding: 18rpx 24rpx;
  border-radius: 12rpx;
  background: #EFF6FF;
  border: 2rpx solid #BFDBFE;
  color: #1D4ED8;
  font-size: 26rpx;
  font-weight: 600;
}

.sales-ship-page .match-err {

  color: #DC2626;

  margin-bottom: 20rpx;

}



.sales-ship-page .submit-btn {

  margin-top: 12rpx;

  height: 96rpx;

  font-size: 30rpx;

}

