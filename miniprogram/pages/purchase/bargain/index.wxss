.tabs { display: flex; gap: 12rpx; margin-bottom: 16rpx; }
.tab { flex: 1; text-align: center; padding: 16rpx 0; border-radius: 12rpx; background: #fff; color: #6B7280; font-size: 26rpx; border: 1rpx solid #E5E7EB; }
.tab--on { background: #EFF6FF; color: #1D4ED8; border-color: #BFDBFE; font-weight: 700; }
.row { display: flex; align-items: center; gap: 16rpx; padding: 24rpx 0; border-bottom: 1rpx solid #F3F4F6; }
.row-main { flex: 1; min-width: 0; }
.title { font-size: 28rpx; font-weight: 700; color: #111827; }
.sub { margin-top: 6rpx; font-size: 24rpx; color: #6B7280; }
.empty { text-align: center; padding: 48rpx 0; color: #9CA3AF; font-size: 26rpx; }
.fab-wrap { margin-top: 24rpx; }
