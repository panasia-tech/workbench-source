/* 仓库 Tab — 商品列表（公共 wh-item 基础见 app.wxss） */

.wh-page .wh-list-head {
  margin-bottom: 0;
}

.wh-page .wh-list-head .card-head-main {
  display: inline;
}

.wh-page .card-head-sub {
  font-size: 22rpx;
  color: #9CA3AF;
  font-weight: 600;
  margin-left: 8rpx;
}

.wh-page .wh-phase-scroll {
  width: 100%;
  margin: 16rpx 0 12rpx;
  white-space: nowrap;
}

.wh-page .wh-action-bar {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
  flex-wrap: wrap;
}

/* 分段 Tab（五段横向滚动） */
.wh-page .status-segment {
  display: inline-flex;
  gap: 12rpx;
  padding: 6rpx;
  background: #F9FAFB;
  border-radius: 40rpx;
  min-width: max-content;
}

.wh-page .status-seg {
  flex: 0 0 auto;
  min-width: 120rpx;
  padding: 16rpx 20rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 700;
  color: #6B7280;
  border-radius: 16rpx;
}

.wh-page .status-seg.active {
  background: #EFF6FF;
  color: #2563EB;
  box-shadow: none;
}

.wh-page .list-card {
  padding-top: 0;
}

.wh-page .list-card .card-head {
  margin-bottom: 8rpx;
}

/* 列表项 */
.wh-page .wh-item {
  display: block;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #E5E7EB;
}

.wh-page .wh-item:last-child {
  border-bottom: none;
}

.wh-page .wh-item__main {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}

.wh-page .wh-item__main:active {
  opacity: 0.72;
}

.wh-page .wh-thumb-wrap {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  flex-shrink: 0;
  overflow: hidden;
  border-radius: 16rpx;
  border: 1rpx solid #E5E7EB;
  background: #F9FAFB;
}

/* 「定位」角标：当列表项用仓库定位图代替产品图时标注,避免误当实拍主图 */
.wh-page .wh-loc-badge {
  position: absolute;
  left: 0;
  bottom: 0;
  padding: 2rpx 10rpx;
  font-size: 18rpx;
  line-height: 1.5;
  color: #fff;
  background: rgba(37, 99, 235, 0.85);
  border-top-right-radius: 10rpx;
}

.wh-page .wh-thumb-wrap media-thumb {
  width: 100%;
  height: 100%;
  display: block;
}

.wh-page .wh-thumb {
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  background: #F3F4F6;
  border: 1rpx solid #E5E7EB;
  color: #6B7280;
}

.wh-page .wh-body {
  flex: 1;
  min-width: 0;
}

.wh-page .wh-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.wh-page .wh-name {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 700;
  color: #111827;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.wh-page .wh-tag {
  flex-shrink: 0;
}

.wh-page .wh-sub {
  font-size: 22rpx;
  color: #6B7280;
  font-weight: 600;
  line-height: 1.45;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.wh-page .wh-sub--time {
  color: #9CA3AF;
  font-weight: 500;
}

.wh-page .wh-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 8rpx;
}

.wh-page .wh-loc {
  flex: 1;
  min-width: 0;
  font-size: 22rpx;
  color: #9CA3AF;
  font-weight: 600;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.wh-page .wh-price {
  flex-shrink: 0;
  font-size: 30rpx;
  font-weight: 800;
  color: #DC2626;
  line-height: 1;
}

.wh-page .wh-item__action {
  margin-top: 16rpx;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 28rpx;
  border-radius: 16rpx;
}

.wh-page .list-footer {
  padding-top: 20rpx;
}

.wh-page .filter-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.wh-page .wh-filter-hint {
  margin: 0;
  flex-shrink: 0;
  font-size: 22rpx;
}

/* 标签筛选 + 搜索按钮合并为一行：筛选框占主体，按钮紧凑靠右 */
.wh-page .wh-filter-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 12rpx 0 4rpx;
}

.wh-page .wh-filter-row .wh-search-btn {
  /* 全局 .btn 在 flex 行里会被压到不足两字宽导致文字换行，必须给定宽 */
  flex: 0 0 152rpx;
  width: 152rpx;
  margin: 0;
  padding: 0;
  height: 84rpx;
  line-height: 84rpx;
  white-space: nowrap;
}

.wh-page .wh-tag-trigger {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx;
  background: #F9FAFB;
  border: 1rpx solid #E5E7EB;
  border-radius: 24rpx;
}

.wh-page .wh-tag-trigger-label {
  font-size: 24rpx;
  font-weight: 700;
  color: #6B7280;
  flex-shrink: 0;
}

.wh-page .wh-tag-trigger-value {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  font-weight: 700;
  color: #1F2937;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.wh-page .wh-tag-trigger-value--empty {
  color: #9CA3AF;
  font-weight: 600;
}

.wh-page .wh-tag-trigger-arrow {
  font-size: 24rpx;
  color: #6B7280;
  flex-shrink: 0;
}

.wh-page .wh-tag-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 1000;
}

.wh-page .wh-tag-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 1001;
}

.wh-page .wh-tag-sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-bottom: 2rpx solid #F3F4F6;
}

.wh-page .wh-tag-sheet-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #1F2937;
}

.wh-page .wh-tag-sheet-cancel {
  font-size: 28rpx;
  font-weight: 700;
  color: #6B7280;
}

.wh-page .wh-tag-sheet-confirm {
  font-size: 28rpx;
  font-weight: 700;
  color: #2563EB;
}

.wh-page .wh-tag-sheet-body {
  padding: 24rpx 32rpx 8rpx;
  max-height: 60vh;
  overflow-y: auto;
}

.wh-page .wh-tag-sheet-hint {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #9CA3AF;
}

.wh-page .wh-tag-sheet-foot {
  padding: 16rpx 32rpx 28rpx;
}

.wh-page .tag-chip-group {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.wh-page .tag-chip {
  padding: 14rpx 26rpx;
  border-radius: 28rpx;
  background: #F9FAFB;
  border: 1rpx solid #E5E7EB;
  color: #6B7280;
  font-size: 26rpx;
  font-weight: 700;
}

.wh-page .tag-chip--active {
  background: #EFF6FF;
  border-color: #2563EB;
  color: #2563EB;
}

/* 搜索框内嵌扫码图标 */
.search-input-wrap {
  position: relative;
  flex: 1;
  display: flex;
  align-items: center;
}

.search-input-wrap .search-input--with-scan {
  flex: 1;
  width: 100%;
  padding-right: 84rpx;
}

.search-scan-icon {
  position: absolute;
  right: 8rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.search-scan-icon:active {
  opacity: 0.6;
}

.search-scan-icon .scan-frame {
  position: relative;
  width: 34rpx;
  height: 34rpx;
  /* 四角扫码框：用渐变绘制四个 L 形直角 */
  background:
    linear-gradient(#2563EB, #2563EB) left top,
    linear-gradient(#2563EB, #2563EB) left top,
    linear-gradient(#2563EB, #2563EB) right top,
    linear-gradient(#2563EB, #2563EB) right top,
    linear-gradient(#2563EB, #2563EB) left bottom,
    linear-gradient(#2563EB, #2563EB) left bottom,
    linear-gradient(#2563EB, #2563EB) right bottom,
    linear-gradient(#2563EB, #2563EB) right bottom;
  background-repeat: no-repeat;
  background-size: 12rpx 3rpx, 3rpx 12rpx;
}

.search-scan-icon .scan-line {
  position: absolute;
  left: 15rpx;
  right: 15rpx;
  height: 3rpx;
  background: #2563EB;
  border-radius: 2rpx;
}

.wh-page .entry-row { display: flex; justify-content: flex-end; gap: 16rpx; margin-bottom: 16rpx; }
.wh-page .entry-chip {
  display: inline-flex; align-items: center; gap: 10rpx;
  padding: 12rpx 24rpx; border-radius: 999rpx;
  font-size: 26rpx; font-weight: 700; color: #2563EB;
  background: #EFF6FF; border: 1rpx solid #DBEAFE;
}
.wh-page .entry-chip__dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: #2563EB; }
.wh-page .entry-chip__label { line-height: 1; }
.wh-page .entry-chip__arrow { font-size: 30rpx; line-height: 1; opacity: 0.55; }
.wh-page .entry-chip--hover { opacity: 0.7; }

/* 老系统历史记录兜底卡片(搜索无在库结果时展示,仅供核对) */
.wh-page .wh-legacy-block {
  margin-top: 8rpx;
  padding-top: 16rpx;
  border-top: 1rpx dashed #E5E7EB;
}
.wh-page .wh-legacy-head {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  padding: 8rpx 8rpx 16rpx;
}
.wh-page .wh-legacy-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #92400E;
}
.wh-page .wh-legacy-note {
  font-size: 22rpx;
  color: #B45309;
}
.wh-page .wh-legacy-item {
  background: #FFFBEB;
  border: 1rpx solid #FDE68A;
  border-radius: 16rpx;
  padding: 16rpx;
  margin-bottom: 16rpx;
}
.wh-page .wh-legacy-thumb {
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
  display: block;
}
.wh-page .wh-legacy-tip {
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx dashed #FDE68A;
  font-size: 22rpx;
  line-height: 1.5;
  color: #B45309;
}

/* 库存缺口入口 */
.wh-page .gaps-entry { display: flex; align-items: center; gap: 16rpx; margin-bottom: 16rpx; padding: 24rpx 28rpx; background: #fff; border-radius: 24rpx; border: 1rpx solid #FDE68A; }
.wh-page .gaps-entry__label { font-size: 28rpx; font-weight: 800; color: #111827; }
.wh-page .gaps-entry__count { flex: 1; font-size: 26rpx; font-weight: 700; color: #B45309; }
.wh-page .gaps-entry__count--zero { color: #9CA3AF; font-weight: 500; }
.wh-page .gaps-entry__arrow { font-size: 32rpx; color: #9CA3AF; }
