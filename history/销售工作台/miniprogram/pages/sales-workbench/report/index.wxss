/* 遇到没见过的情况：上面报，下面等主管回的 / 我报的 / 记成规则的 */
.rp-page .rp-tip { font-size: 24rpx; color: #6B7280; line-height: 1.6; }
.rp-page .rp-gap { margin-top: 16rpx; }
.rp-page .rp-item { padding: 20rpx 0; border-top: 1rpx solid #F3F4F6; }
.rp-page .rp-item__t { font-size: 28rpx; color: #111827; line-height: 1.5; white-space: pre-wrap; }
.rp-page .rp-item__m { margin-top: 6rpx; font-size: 22rpx; color: #9CA3AF; }
.rp-page .rp-wait { color: #B45309; }
.rp-page .rp-ans { margin-top: 10rpx; padding: 14rpx 18rpx; border-radius: 12rpx; background: #ECFDF5; color: #065F46; font-size: 26rpx; line-height: 1.6; white-space: pre-wrap; }
.rp-page .rp-row { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.rp-page .rp-check { font-size: 24rpx; color: #6B7280; }
.rp-page .rp-check.is-on { color: #1D4ED8; font-weight: 600; }
.rp-page .rp-btn { margin: 0; width: auto; padding: 0 32rpx; }
