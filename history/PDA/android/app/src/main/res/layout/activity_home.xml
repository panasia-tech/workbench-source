<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp">

    <TextView
        android:id="@+id/tv_who"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textSize="16sp"
        android:paddingBottom="40dp" />

    <Button
        android:id="@+id/btn_stock"
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:text="盘 点"
        android:textSize="24sp" />

    <Button
        android:id="@+id/btn_migrate"
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:layout_marginTop="24dp"
        android:text="条码迁移 / 查询"
        android:textSize="24sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:text="扫描功率"
        android:textSize="16sp" />

    <RadioGroup
        android:id="@+id/rg_power"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/rb_power_high"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="高"
            android:textSize="18sp" />

        <RadioButton
            android:id="@+id/rb_power_midhigh"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="较高"
            android:textSize="18sp" />

        <RadioButton
            android:id="@+id/rb_power_mid"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="中"
            android:textSize="18sp" />

        <RadioButton
            android:id="@+id/rb_power_low"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="低"
            android:textSize="18sp" />
    </RadioGroup>

    <Button
        android:id="@+id/btn_logout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:text="退出登录"
        style="?android:attr/borderlessButtonStyle" />
</LinearLayout>
