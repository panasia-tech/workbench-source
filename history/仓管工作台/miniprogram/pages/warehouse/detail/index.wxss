/* ---------- 底部常驻入口：和商品卡 CTA 同一套琥珀色 ---------- */
.pd-detail-page .pd-xianyu-bar {
  backdrop-filter: blur(10rpx);
}

.pd-detail-page .pd-xianyu-bar-btn {
  color: #5B2E00;
  background: linear-gradient(180deg, #FFD25E 0%, #FFB02E 100%);
  box-shadow: 0 8rpx 20rpx rgba(255, 176, 46, 0.3);
}

/* ================================================================ 对齐效果图：灰色图表面板 + 细进度条 + 涨跌按钮 */
.pd-detail-page .pd-market-panel {
  margin-top: 6rpx;
  padding: 0;
  border-radius: 0;
  background: transparent;
  overflow: visible;
}

.pd-detail-page .pd-chart-stage {
  margin: 0;
  background: transparent;
}

.pd-detail-page .pd-chart-stage price-trend-chart {
  display: block;
  width: 100%;
}

.pd-detail-page .pd-price-note {
  margin: 4rpx 2rpx 0;
  font-size: 20rpx;
  line-height: 1.5;
  color: #8C8C8C;
}

.pd-detail-page .pd-senti {
  margin-top: 14rpx;
  padding: 0;
  border-radius: 0;
  background: transparent;
}

.pd-detail-page .pd-senti-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 16rpx;
  margin-bottom: 10rpx;
  font-size: 21rpx;
  font-weight: 400;
}

.pd-detail-page .pd-senti-up-t { color: #F73880; }
.pd-detail-page .pd-senti-down-t { color: #0D80F7; }

.pd-detail-page .pd-senti-bar {
  display: flex;
  gap: 8rpx;
  height: 7rpx;
  overflow: visible;
  border-radius: 0;
  background: transparent;
}

.pd-detail-page .pd-senti-up {
  height: 7rpx;
  border-radius: 999rpx;
  background: #F73880;
}

.pd-detail-page .pd-senti-down {
  height: 7rpx;
  border-radius: 999rpx;
  background: #0D80F7;
}

.pd-detail-page .pd-senti-actions {
  display: flex;
  margin: 16rpx 12rpx 0;
  border-radius: 12rpx;
  overflow: hidden;
  background: #F7F7F7;
}

.pd-detail-page .pd-senti-btn {
  flex: 1;
  height: 66rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 0 22rpx;
  font-size: 23rpx;
  font-weight: 400;
  letter-spacing: 1rpx;
  color: #FFFFFF;
}

.pd-detail-page .pd-senti-btn--up {
  background: linear-gradient(180deg, #F73880 0%, #F86A90 100%);
  justify-content: flex-start;
  -webkit-clip-path: polygon(0 0, 100% 0, calc(100% - 12px) 100%, 0 100%);
  clip-path: polygon(0 0, 100% 0, calc(100% - 12px) 100%, 0 100%);
}

.pd-detail-page .pd-senti-btn--down {
  background: linear-gradient(180deg, #0D80F7 0%, #2E99F6 100%);
  justify-content: flex-end;
  -webkit-clip-path: polygon(12px 0, 100% 0, 100% 100%, 0 100%);
  clip-path: polygon(12px 0, 100% 0, 100% 100%, 0 100%);
}

.pd-detail-page .pd-senti-ic {
  flex: none;
  width: 28rpx;
  height: 28rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: 100% 100%;
}

.pd-detail-page .pd-senti-ic--up {
  background-image: url("data:image/svg+xml;base64,");
}

.pd-detail-page .pd-senti-ic--down {
  background-image: url("data:image/svg+xml;base64,");
}

.pd-detail-page .pd-senti-empty {
  margin: 12rpx 0 0;
  font-size: 20rpx;
  color: #8C8C8C;
}
