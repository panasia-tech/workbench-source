@import "../../gc-chat/icons.wxss";

.pd-detail-page .pd-edit-link {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-primary);
  flex-shrink: 0;
}

.pd-detail-page .pd-img-label {
  font-size: 24rpx;
  font-weight: 600;
  color: #6B7280;
  margin-bottom: 12rpx;
}

.pd-detail-page .pd-gallery--last {
  margin-bottom: 0;
}

.pd-detail-page .pd-img-empty {
  height: 140rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed #D1D5DB;
  border-radius: 20rpx;
  color: #9CA3AF;
  font-size: 26rpx;
  margin-bottom: 24rpx;
  background: #F9FAFB;
}

.pd-detail-page .pd-img-empty:last-child {
  margin-bottom: 0;
}

.pd-detail-page .pd-edit-btn {
  margin-top: 24rpx;
  white-space: nowrap;
}

.pd-detail-page .pd-split-entry {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 24rpx;
  padding: 22rpx 24rpx;
  background: #F8FAFC;
  border: 1rpx solid #E5E7EB;
  border-radius: 16rpx;
}

.pd-detail-page .pd-split-entry--hover {
  background: #EFF6FF;
  border-color: #BFDBFE;
}

.pd-detail-page .pd-split-icon {
  flex: none;
  width: 64rpx;
  height: 64rpx;
  border-radius: 14rpx;
  background: #EFF6FF;
  color: #2563EB;
  font-size: 30rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
}

.pd-detail-page .pd-split-text {
  flex: 1;
  min-width: 0;
}

.pd-detail-page .pd-split-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #111827;
}

.pd-detail-page .pd-split-hint {
  font-size: 22rpx;
  color: #6B7280;
  margin-top: 4rpx;
  line-height: 1.4;
}

.pd-detail-page .pd-split-arrow {
  flex: none;
  font-size: 32rpx;
  color: #9CA3AF;
  font-weight: 600;
}

.pd-detail-page .pd-shop-card .pd-shop-meta {
  font-size: 24rpx;
  color: #6B7280;
  font-weight: 600;
  margin: -8rpx 0 20rpx;
}

/* 店铺多了不把整页拉长：大约露出 4 个，其余在框里滚 */
.pd-detail-page .pd-shop-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  max-height: 760rpx;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}

.pd-detail-page .pd-shop-row {
  padding: 20rpx 24rpx;
  border-radius: 28rpx;
  background: #F9FAFB;
  border: 1rpx solid #E5E7EB;
}

.pd-detail-page .pd-shop-main {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.pd-detail-page .pd-shop-body {
  flex: 1;
  min-width: 0;
}

.pd-detail-page .pd-shop-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #111827;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pd-detail-page .pd-shop-code {
  font-size: 22rpx;
  color: #6B7280;
  font-weight: 600;
  margin-top: 6rpx;
  line-height: 1.3;
}

.pd-detail-page .pd-shop-tag {
  flex-shrink: 0;
}

.pd-detail-page .pd-shop-err {
  font-size: 22rpx;
  color: #DC2626;
  font-weight: 600;
  margin-top: 12rpx;
  line-height: 1.4;
  word-break: break-all;
}

.pd-detail-page .pd-shop-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}

.pd-detail-page .pd-shop-action-btn {
  flex: 1;
  margin: 0;
  min-width: 0;
}

/* 历史迁移商品「待核验」横幅 */
.pd-legacy-banner {
  margin-bottom: 16rpx;
  padding: 20rpx 24rpx;
  background: #FFFBEB;
  border: 1rpx solid #FDE68A;
  border-radius: 16rpx;
}
.pd-legacy-banner-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #92400E;
  margin-bottom: 8rpx;
}
.pd-legacy-banner-text {
  font-size: 24rpx;
  line-height: 1.6;
  color: #B45309;
}


/* ---------------------------------------------------------------- 顶部摘要（效果图：大图 + 名称/型号 + 成色/行情 + 前往闲鱼） */
.pd-detail-page .pd-sum {
  padding: 28rpx;
}

.pd-detail-page .pd-sum-top {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}

.pd-detail-page .pd-sum-img {
  flex: none;
  width: 150rpx;
  height: 150rpx;
  border-radius: 20rpx;
  background: #F3F4F6;
}

.pd-detail-page .pd-sum-img--ph {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #9CA3AF;
}

.pd-detail-page .pd-sum-info {
  flex: 1;
  min-width: 0;
}

.pd-detail-page .pd-sum-name {
  display: -webkit-box;
  overflow: hidden;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.3;
  color: #0F172A;
  word-break: break-all;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.pd-detail-page .pd-sum-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 1.45;
  color: #64748B;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pd-detail-page .pd-sum-pills {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 12rpx;
}

.pd-detail-page .pd-sum-pill {
  padding: 3rpx 12rpx;
  border-radius: 999rpx;
  font-size: 19rpx;
  line-height: 1.6;
}

.pd-detail-page .pd-sum-pill--grade {
  color: #92400E;
  background: #FFF7ED;
  border: 1rpx solid #FDE68A;
}

.pd-detail-page .pd-sum-pill--market {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  color: #047857;
  background: #ECFDF5;
  border: 1rpx solid #A7F3D0;
}

.pd-detail-page .pd-sum-pill-dot {
  width: 9rpx;
  height: 9rpx;
  border-radius: 50%;
  background: #10B981;
  box-shadow: 0 0 0 4rpx rgba(16, 185, 129, 0.15);
}

.pd-detail-page .pd-sum-side {
  flex: none;
  display: flex;
  align-items: center;
  padding-top: 4rpx;
}

.pd-detail-page .pd-sum-cta {
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  font-weight: 700;
  white-space: nowrap;
  color: #5B2E00;
  background: linear-gradient(180deg, #FFD25E 0%, #FFB02E 100%);
  box-shadow: 0 8rpx 18rpx rgba(255, 176, 46, 0.28);
}

.pd-detail-page .pd-sum-cta--off {
  color: #FFFFFF;
  background: #CBD5E1;
  box-shadow: none;
  opacity: 0.8;
}

.pd-detail-page .pd-sum-cta-arrow {
  margin-left: 2rpx;
  font-size: 20rpx;
  line-height: 1;
}

.pd-detail-page .pd-sum-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 22rpx;
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #F1F5F9;
  font-size: 20rpx;
  color: #94A3B8;
}

.pd-detail-page .pd-sum-meta-v {
  margin-left: 4rpx;
  font-weight: 600;
  color: #475569;
}

.pd-detail-page .pd-sum-meta-v--state {
  color: #059669;
}

/* 有闲鱼商品链接时给底部常驻入口让位 */
.pd-detail-page.pd-detail-page--jump {
  padding-bottom: calc(150rpx + env(safe-area-inset-bottom));
}

.pd-detail-page .pd-xianyu-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 90;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 16rpx 28rpx calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.97);
  border-top: 1rpx solid #EEF0F3;
  box-shadow: 0 -8rpx 28rpx rgba(17, 24, 39, 0.07);
}

.pd-detail-page .pd-xianyu-bar-info {
  flex: 1;
  min-width: 0;
}

.pd-detail-page .pd-xianyu-bar-t {
  font-size: 22rpx;
  font-weight: 700;
  color: #111827;
}

.pd-detail-page .pd-xianyu-bar-d {
  margin-top: 2rpx;
  overflow: hidden;
  font-size: 20rpx;
  color: #6B7280;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pd-detail-page .pd-xianyu-bar-btn {
  flex: none;
  padding: 18rpx 34rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #FFFFFF;
  background: linear-gradient(90deg, #FF7A2E 0%, #FF3D2E 100%);
  box-shadow: 0 8rpx 20rpx rgba(255, 61, 46, 0.24);
}

.pd-detail-page .pd-xianyu-bar-arrow {
  margin-left: 4rpx;
  font-size: 24rpx;
}

/* ---------------------------------------------------------------- 价格历史 / 行情价 */
.pd-detail-page .pd-price-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.pd-detail-page .pd-price-title {
  padding-left: 18rpx;
  border-left: 8rpx solid var(--color-primary);
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.2;
  color: #111827;
}

.pd-detail-page .pd-price-src {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 24rpx;
  color: #6B7280;
}

.pd-detail-page .pd-price-src-ic {
  width: 28rpx;
  height: 28rpx;
}

.pd-detail-page .pd-price-state {
  padding: 40rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: #9CA3AF;
}

.pd-detail-page .pd-price-state--loading {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.pd-detail-page .pd-price-spinner {
  width: 26rpx;
  height: 26rpx;
  border: 4rpx solid #DBEAFE;
  border-top-color: var(--color-primary);
  border-radius: 50%;
  animation: pd-spin 0.8s linear infinite;
}

@keyframes pd-spin {
  to { transform: rotate(360deg); }
}

.pd-detail-page .pd-price-retry {
  display: inline-block;
  margin-top: 18rpx;
  padding: 10rpx 32rpx;
  border: 1rpx solid #BFDBFE;
  border-radius: 999rpx;
  font-size: 23rpx;
  font-weight: 600;
  color: var(--color-primary);
  background: #EFF6FF;
}

.pd-detail-page .pd-price-tabs {
  display: flex;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.pd-detail-page .pd-price-tab {
  flex: 1;
  height: 60rpx;
  line-height: 60rpx;
  text-align: center;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #4B5563;
  background: #F3F4F6;
  white-space: nowrap;
}

.pd-detail-page .pd-price-tab--on {
  font-weight: 600;
  color: #FFFFFF;
  background: var(--color-primary);
}

.pd-detail-page .pd-chart-box {
  padding: 16rpx 12rpx 8rpx;
  border-radius: 20rpx;
  background: #F8FAFC;
}

.pd-detail-page .pd-chart-unit {
  padding-left: 12rpx;
  font-size: 20rpx;
  color: #9CA3AF;
}

.pd-detail-page .pd-chart {
  display: block;
  width: 100%;
}

.pd-detail-page .pd-chart-empty {
  padding: 56rpx 24rpx;
  text-align: center;
  font-size: 24rpx;
  color: #9CA3AF;
}

.pd-detail-page .pd-price-note {
  margin-top: 16rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: #6B7280;
}

.pd-detail-page .pd-price-summary {
  display: flex;
  gap: 18rpx;
  margin-bottom: 18rpx;
  padding: 20rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #FFF7F0 0%, #FFF2F2 100%);
}

.pd-detail-page .pd-price-avg {
  flex: 1;
  min-width: 0;
}

.pd-detail-page .pd-price-avg-k {
  font-size: 22rpx;
  color: #9A5A3A;
}

.pd-detail-page .pd-price-avg-v {
  margin-top: 2rpx;
  font-size: 46rpx;
  font-weight: 800;
  line-height: 1.15;
  color: #F23030;
}

.pd-detail-page .pd-price-yen {
  font-size: 26rpx;
  margin-right: 2rpx;
}

.pd-detail-page .pd-price-avg-d {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #DC2626;
}

.pd-detail-page .pd-price-avg-d--down {
  color: #2563EB;
}

.pd-detail-page .pd-price-avg-d--muted {
  color: #9CA3AF;
}

.pd-detail-page .pd-price-avg-dk {
  color: #9CA3AF;
}

.pd-detail-page .pd-price-band {
  flex: 1;
  min-width: 0;
  padding-left: 18rpx;
  border-left: 1rpx solid #FED7AA;
}

.pd-detail-page .pd-price-band-k {
  font-size: 22rpx;
  color: #9A5A3A;
}

.pd-detail-page .pd-price-band-v {
  margin-top: 4rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #7C2D12;
  white-space: nowrap;
}

.pd-detail-page .pd-price-band-d {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #9A5A3A;
}

.pd-detail-page .pd-price-summary-empty {
  margin-bottom: 18rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  background: #F8FAFC;
  text-align: center;
  font-size: 22rpx;
  color: #9CA3AF;
}

.pd-detail-page .pd-senti {
  margin-top: 18rpx;
}

.pd-detail-page .pd-senti-bar {
  display: flex;
  height: 28rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #EEF2F7;
}

.pd-detail-page .pd-senti-up {
  background: linear-gradient(90deg, #FF7A59 0%, #FF3D6E 100%);
}

.pd-detail-page .pd-senti-down {
  background: linear-gradient(90deg, #2F6BFF 0%, #5B8DFF 100%);
}

.pd-detail-page .pd-senti-legend {
  display: flex;
  justify-content: space-between;
  margin-top: 8rpx;
  font-size: 20rpx;
}

.pd-detail-page .pd-senti-up-t {
  color: #E11D48;
}

.pd-detail-page .pd-senti-down-t {
  color: #2563EB;
}

.pd-detail-page .pd-senti-empty {
  margin-top: 16rpx;
  font-size: 21rpx;
  color: #9CA3AF;
}

.pd-detail-page .pd-insight {
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid #D6E6FF;
  border-radius: 16rpx;
  background: #F0F6FF;
}

.pd-detail-page .pd-insight-head {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.pd-detail-page .pd-insight-badge {
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  font-size: 20rpx;
  color: #FFFFFF;
  background: #2563EB;
}

.pd-detail-page .pd-insight-sub {
  font-size: 20rpx;
  color: #6B7280;
}

.pd-detail-page .pd-insight-text {
  margin-top: 8rpx;
  font-size: 23rpx;
  line-height: 1.65;
  color: #1F2937;
}

.pd-detail-page .pd-stats {
  display: flex;
  gap: 12rpx;
  margin-top: 20rpx;
}

.pd-detail-page .pd-stat {
  flex: 1;
  min-width: 0;
  padding: 16rpx 8rpx;
  border-radius: 16rpx;
  background: #F8FAFC;
  text-align: center;
}

.pd-detail-page .pd-stat-k {
  font-size: 22rpx;
  color: #6B7280;
}

.pd-detail-page .pd-stat-v {
  margin-top: 8rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #111827;
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
}

.pd-detail-page .pd-stat-d {
  margin-top: 6rpx;
  font-size: 20rpx;
  white-space: nowrap;
}

.pd-detail-page .pd-stat-d--down {
  color: var(--color-success);
}

.pd-detail-page .pd-stat-d--up {
  color: var(--color-danger);
}

.pd-detail-page .pd-stat-d--muted {
  color: #9CA3AF;
}

.pd-detail-page .pd-stat-dk {
  color: #9CA3AF;
}

.pd-detail-page .pd-rec-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 32rpx 0 12rpx;
}

.pd-detail-page .pd-rec-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #111827;
}

.pd-detail-page .pd-rec-more {
  font-size: 24rpx;
  color: var(--color-primary);
}

.pd-detail-page .pd-rec-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F1F3F6;
}

.pd-detail-page .pd-rec-img {
  flex: none;
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  background: #F3F4F6;
}

.pd-detail-page .pd-rec-img--none {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #9CA3AF;
}

.pd-detail-page .pd-rec-main {
  flex: 1;
  min-width: 0;
  margin: 0 20rpx;
}

.pd-detail-page .pd-rec-name {
  display: -webkit-box;
  overflow: hidden;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.45;
  color: #111827;
  word-break: break-all;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.pd-detail-page .pd-rec-sub,
.pd-detail-page .pd-rec-when {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #6B7280;
}

.pd-detail-page .pd-rec-side {
  flex: none;
  text-align: right;
}

.pd-detail-page .pd-rec-label {
  font-size: 20rpx;
  color: #9CA3AF;
}

.pd-detail-page .pd-rec-price {
  margin-top: 4rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #111827;
}

.pd-detail-page .pd-rec-price--sold {
  color: #DC2626;
}

.pd-detail-page .pd-rec-on {
  color: var(--color-success);
}

.pd-detail-page .pd-rec-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 6rpx;
}

.pd-detail-page .pd-rec-tag {
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  font-size: 19rpx;
  line-height: 1.5;
  color: #6B7280;
  background: #F3F4F6;
}

.pd-detail-page .pd-rec-tag--on {
  color: #059669;
  background: #E8F7EE;
}

.pd-detail-page .pd-rec-tag--sold {
  color: #DC2626;
  background: #FEF2F2;
}

/* 库存库龄 / 自动上架 */
.pd-detail-page .pd-sum-state { font-size: 24rpx; font-weight: 700; color: #059669; }
.pd-detail-page .pd-age-c--target, .pd-detail-page .pd-age-c--normal { color: #059669; }
.pd-detail-page .pd-age-c--clearance { color: #F97316; }
.pd-detail-page .pd-age-c--stale { color: #DC2626; }

.pd-detail-page .pd-age-head, .pd-detail-page .pd-shop-top { display: flex; align-items: center; margin-bottom: 20rpx; }
.pd-detail-page .pd-age-head-ic { width: 40rpx; height: 40rpx; flex: none; margin-right: 12rpx; }
.pd-detail-page .pd-age-title { font-size: 30rpx; font-weight: 800; color: #111827; flex: none; }
.pd-detail-page .pd-age-sub { font-size: 22rpx; color: #6B7280; flex: none; }
.pd-detail-page .pd-age-help { width: 28rpx; height: 28rpx; flex: none; margin-left: 4rpx; padding: 6rpx; background-origin: content-box; background-clip: content-box; }
.pd-detail-page .pd-age-days { margin-left: auto; font-size: 22rpx; color: #6B7280; white-space: nowrap; }
.pd-detail-page .pd-age-days-n { font-size: 34rpx; font-weight: 800; margin: 0 4rpx; }
.pd-detail-page .pd-age-cal { flex: none; margin-left: 12rpx; width: 52rpx; height: 52rpx; border-radius: 12rpx; background: #F3F4F6; display: flex; align-items: center; justify-content: center; }
.pd-detail-page .pd-age-cal-ic { width: 32rpx; height: 32rpx; }

.pd-detail-page .pd-age-cards, .pd-detail-page .pd-auto-cards { display: flex; gap: 12rpx; }
