.page { padding: 20rpx; }

.filter-bar { display: flex; gap: 16rpx; padding: 8rpx 4rpx 20rpx; }
.filter-chip {
  padding: 10rpx 28rpx; border-radius: 999rpx; font-size: 26rpx;
  background: #f0f1f3; color: #555;
}
.filter-chip--on { background: #1565C0; color: #fff; }

.hint { text-align: center; color: #999; padding: 80rpx 0; }

.rec { padding: 24rpx; margin-bottom: 18rpx; }
.rec-head { display: flex; justify-content: space-between; align-items: center; }
.rec-no { font-size: 30rpx; font-weight: 600; }
.rec-status { font-size: 24rpx; color: #1565C0; }
.rec-meta { font-size: 26rpx; color: #666; margin-top: 10rpx; }
.rec-stats { display: flex; gap: 28rpx; margin-top: 14rpx; }
.rs { font-size: 28rpx; color: #333; }
.rs-danger { color: #d32f2f; }
.rs-warn { color: #e08600; }
.rec-time { font-size: 24rpx; color: #999; margin-top: 12rpx; }
