<wxs module="fmt" src="../../../utils/format.wxs" />

<!-- 货号更换（电脑版）：分类 tab + 搜索 + 表格 + 页码；换号弹层改成居中对话框 -->
<view class="dk-page">
  <view class="dk-head">
    <view>
      <view class="dk-title">货号更换</view>
      <view class="dk-sub">共 {{total}} 条 · {{tab === 'pending' ? '仅显示在库且未换新号商品' : '新号以前缀 51321154 判断'}}</view>
    </view>
  </view>

  <view class="dk-card">
    <view class="dk-toolbar">
      <view class="dk-tabs">
        <view
          wx:for="{{tabs}}"
          wx:key="key"
          class="dk-tab {{tab === item.key ? 'dk-tab--on' : ''}}"
          data-tab="{{item.key}}"
          bindtap="switchTab"
        >{{item.label}}</view>
      </view>
      <input
        class="dk-input dk-search"
        placeholder="货号 / 商品名 / 库位"
        value="{{q}}"
        bindinput="onSearchInput"
        confirm-type="search"
        bindconfirm="onSearch"
      />
      <view class="dk-btn" bindtap="onScanSearch">扫码搜</view>
      <view class="dk-btn dk-btn--primary" bindtap="onSearch">搜索</view>
    </view>

    <view class="dk-table-wrap">
      <table class="dk-table">
        <thead>
          <tr>
            <th>货号</th>
            <th>商品</th>
            <th>库位</th>
            <th>状态</th>
            <th>更换</th>
            <th>{{tab === 'pending' ? '入库时间' : '最近更换'}}</th>
            <th wx:if="{{tab === 'done'}}">更换人</th>
            <th class="dk-ops">操作</th>
          </tr>
        </thead>
        <tbody>
          <tr wx:for="{{list}}" wx:key="id" class="dk-tr--click" data-code="{{item.sku_code}}" bindtap="openDetail">
            <td class="dk-nowrap dk-cell-main">{{item.sku_code}}</td>
            <td>
              <view class="dk-ellipsis" title="{{item.product_name}}">{{item.product_name}}</view>
              <view class="dk-cell-sub">{{item.spec || '—'}}</view>
            </td>
            <td class="dk-nowrap">{{item.location_code || '未分配'}}</td>
            <td class="dk-nowrap">{{fmt.statusLabel(item.status)}}</td>
            <td class="dk-nowrap"><text class="dk-tag {{item.migration_status === 'DONE' ? 'tag-success' : 'tag-warning'}}">{{item.migration_status === 'DONE' ? '已更换' : '待更换'}}</text></td>
            <td class="dk-nowrap">{{tab === 'pending' ? fmt.datetime(item.inbound_at) : (item.last_recode_at ? fmt.datetime(item.last_recode_at) : '按前缀识别为已更换')}}</td>
            <td wx:if="{{tab === 'done'}}" class="dk-nowrap">
              {{item.last_recode_operator_name ? item.last_recode_operator_name : '无历史更换记录'}}<text wx:if="{{item.last_recode_source}}" class="dk-muted"> · {{item.last_recode_source}}</text>
            </td>
            <td class="dk-ops">
              <text wx:if="{{tab === 'pending' && item.can_migrate}}" class="dk-link" data-code="{{item.sku_code}}" catchtap="openEditor">更换货号</text>
              <text class="dk-link" data-code="{{item.sku_code}}" catchtap="openDetail">详情</text>
            </td>
          </tr>
        </tbody>
      </table>
    </view>

    <view wx:if="{{!list.length && !loading}}" class="dk-empty">{{tab === 'pending' ? '暂无待更换商品' : '暂无已更换商品'}}</view>
    <view wx:if="{{loading && !list.length}}" class="dk-empty">加载中…</view>

    <view wx:if="{{total > dkPageSize}}" class="dk-pager">
      <text>共 {{total}} 条，每页 {{dkPageSize}} 条</text>
      <view class="dk-row">
        <view class="dk-btn dk-btn--sm {{dkPage <= 1 ? 'dk-btn--disabled' : ''}}" bindtap="dkPrev">上一页</view>
        <text>第 {{dkPage}} / {{dkPages}} 页</text>
        <view class="dk-btn dk-btn--sm {{dkPage >= dkPages ? 'dk-btn--disabled' : ''}}" bindtap="dkNext">下一页</view>
      </view>
    </view>
  </view>

  <!-- 货号更换：居中对话框 -->
  <view wx:if="{{editorVisible}}" class="wsm-dk-mask" bindtap="closeEditor">
    <view class="wsm-dk-dialog" catchtap="dkNoop">
      <view class="dk-card__head">货号更换</view>
      <view class="dk-card__body">
        <view class="dk-form">
          <view class="dk-field dk-field--full">
            <text class="dk-label">旧货号</text>
            <text class="dk-cell-main">{{editorOldCode}}</text>
          </view>
          <view class="dk-field dk-field--full">
            <text class="dk-label dk-label--req">新货号</text>
            <view class="wsm-dk-row">
              <input
                class="dk-input dk-grow"
                placeholder="扫描或输入 51321154 开头的新货号"
                value="{{editorNewCode}}"
                bindinput="onEditorInput"
                confirm-type="done"
                bindconfirm="submitRecode"
              />
              <view class="dk-btn" bindtap="scanNewCode">扫码</view>
            </view>
          </view>
        </view>
      </view>
      <view class="wsm-dk-foot">
        <view class="dk-btn" bindtap="closeEditor">取消</view>
        <view class="dk-btn dk-btn--primary {{saving ? 'dk-btn--disabled' : ''}}" bindtap="submitRecode">{{saving ? '提交中…' : '确定'}}</view>
      </view>
    </view>
  </view>
</view>
