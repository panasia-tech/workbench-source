/* 扫码盘点（电脑版模板用；wst-dk- 开头，手机模板里不出现） */
.wst-dk-intro {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
}

.wst-dk-intro__text {
  color: #374151;
}

.wst-dk-warn {
  color: #c2410c;
}

.wst-dk-side {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.wst-dk-big {
  font-size: 32px;
  color: #2563eb;
}

.wst-dk-gap {
  margin-left: 8px;
}

.wst-dk-scanbox {
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.wst-dk-row {
  display: flex;
  gap: 8px;
}

.wst-dk-block {
  width: 100%;
  height: 38px;
}

.wst-dk-keep {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 13px;
  color: #6b7280;
}

.wst-dk-keep switch {
  transform: scale(0.75);
  transform-origin: right center;
}

.wst-dk-actions {
  display: flex;
  gap: 8px;
}
