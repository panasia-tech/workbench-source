<!-- 手动入库（电脑版）：三栏表单 + 商品图 / 定位图两块图片格子 + 底部操作条 -->
<view class="dk-page">
  <view class="dk-head">
    <view>
      <view class="dk-title">手动入库</view>
      <view class="dk-sub">用于把旧系统的货迁移进来；直接生成在库商品，免议价、可直接上架</view>
    </view>
  </view>

  <view class="dk-card">
    <view class="dk-card__head">商品信息</view>
    <view class="dk-card__body">
      <view class="dk-form dk-form--3">
        <view class="dk-field">
          <text class="dk-label">货号 <text class="dk-muted">选填 · 留空自动生成</text></text>
          <view class="whm-dk-scan">
            <input class="dk-input dk-grow" value="{{form.sku_code}}" data-field="sku_code" bindinput="onInput" placeholder="扫码或手填旧系统货号" />
            <view class="dk-btn" catchtap="scanSkuCode">扫码</view>
          </view>
        </view>
        <view class="dk-field">
          <text class="dk-label dk-label--req">商品名称</text>
          <input class="dk-input" value="{{form.product_name}}" data-field="product_name" bindinput="onInput" placeholder="留空则用「品牌 型号」自动拼" />
        </view>
        <view class="dk-field">
          <text class="dk-label dk-label--req">商品类型</text>
          <picker class="whm-dk-picker" mode="selector" range="{{productTypes}}" value="{{productTypeIndex}}" bindchange="pickProductType">
            <view class="dk-select {{form.product_type ? '' : 'dk-muted'}}">{{form.product_type || '选择商品类型'}}</view>
          </picker>
        </view>
        <view class="dk-field">
          <text class="dk-label">品牌</text>
          <input class="dk-input" value="{{form.brand}}" data-field="brand" bindinput="onInput" placeholder="品牌（选填）" />
        </view>
        <view class="dk-field">
          <text class="dk-label">型号</text>
          <input class="dk-input" value="{{form.model}}" data-field="model" bindinput="onInput" placeholder="型号（选填）" />
        </view>
        <view class="dk-field">
          <text class="dk-label">规格</text>
          <input class="dk-input" value="{{form.spec}}" data-field="spec" bindinput="onInput" placeholder="规格（选填）" />
        </view>
        <view class="dk-field">
          <text class="dk-label dk-label--req">序列号</text>
          <view class="whm-dk-scan">
            <input class="dk-input dk-grow" value="{{form.serial_number}}" data-field="serial_number" bindinput="onInput" placeholder="扫码或手填序列号" />
            <view class="dk-btn" catchtap="scanSerial">扫码</view>
          </view>
        </view>
        <view class="dk-field">
          <text class="dk-label">69码 <text class="dk-muted">选填</text></text>
          <view class="whm-dk-scan">
            <input class="dk-input dk-grow" value="{{form.barcode}}" data-field="barcode" bindinput="onInput" placeholder="扫码或手填69码" />
            <view class="dk-btn" catchtap="scanBarcode69">扫码</view>
          </view>
        </view>
        <view class="dk-field">
          <text class="dk-label dk-label--req">库位</text>
          <picker class="whm-dk-picker" mode="selector" range="{{locations}}" range-key="label" value="{{locationIndex}}" bindchange="pickLocation">
            <view class="dk-select {{form.location_code ? '' : 'dk-muted'}}">{{form.location_code || '选择库位'}}</view>
          </picker>
        </view>
        <view class="dk-field">
          <text class="dk-label dk-label--req">成色</text>
          <picker class="whm-dk-picker" mode="selector" range="{{grades}}" value="{{gradeIndex}}" bindchange="pickGrade">
            <view class="dk-select {{form.condition_grade ? '' : 'dk-muted'}}">{{form.condition_grade || '选择成色'}}</view>
          </picker>
        </view>
        <view class="dk-field">
          <text class="dk-label dk-label--req">成本价（¥）</text>
          <input class="dk-input" type="digit" value="{{form.cost_price}}" bindinput="onCostInput" placeholder="旧系统成本，未知可填 0" />
        </view>
        <view class="dk-field">
          <text class="dk-label">入库时间 <text class="dk-muted">选填 · 默认今天</text></text>
          <picker class="whm-dk-picker" mode="date" value="{{inboundDate}}" bindchange="onInboundDate">
            <view class="dk-select {{inboundDate ? '' : 'dk-muted'}}">{{inboundDate || '选择旧系统原始入库日期'}}</view>
          </picker>
        </view>
        <view class="dk-field dk-field--full">
          <text class="dk-label">备注</text>
          <input class="dk-input" value="{{form.remark}}" data-field="remark" bindinput="onInput" placeholder="选填" />
        </view>
      </view>
    </view>
  </view>

  <view class="dk-grid-2">
    <view class="dk-card">
      <view class="dk-card__head">
        <text><text class="dk-label--req"></text>商品图 / 视频 <text class="dk-sub">{{form.images.length}} 个</text></text>
        <text class="dk-help">用于上架和客户展示，第一张图作为封面</text>
      </view>
      <view class="dk-card__body">
        <view class="whm-dk-grid">
          <view class="whm-dk-cell" wx:for="{{form.images}}" wx:key="*this">
            <media-thumb url="{{imageDisplay[index] || item}}" size="fill" preview="{{true}}" />
            <view wx:if="{{index === 0}}" class="whm-dk-cover">封面</view>
            <view class="whm-dk-del" title="移除" data-type="product" data-index="{{index}}" catchtap="removeImage">×</view>
          </view>
          <view class="whm-dk-add" data-type="product" bindtap="addImage">
            <text class="whm-dk-add__plus">+</text>
            <text>添加图片 / 视频</text>
          </view>
        </view>
      </view>
    </view>

    <view class="dk-card">
      <view class="dk-card__head">
        <text>仓库定位图 / 视频 <text class="dk-sub">{{form.location_images.length}} 个</text></text>
        <text class="dk-help">用于找货、盘点定位，不会展示给客户（选填）</text>
      </view>
      <view class="dk-card__body">
        <view class="whm-dk-grid">
          <view class="whm-dk-cell" wx:for="{{form.location_images}}" wx:key="*this">
            <media-thumb url="{{locationImageDisplay[index] || item}}" size="fill" preview="{{true}}" />
            <view class="whm-dk-del" title="移除" data-type="location" data-index="{{index}}" catchtap="removeImage">×</view>
          </view>
          <view class="whm-dk-add" data-type="location" bindtap="addImage">
            <text class="whm-dk-add__plus">+</text>
            <text>添加定位图 / 视频</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="dk-actionbar whm-dk-bar">
    <view class="dk-btn" bindtap="dkBack">取消</view>
    <view class="dk-btn dk-btn--primary {{submitting ? 'dk-btn--disabled' : ''}}" bindtap="submit">{{submitting ? '提交中…' : '确认入库'}}</view>
  </view>
</view>
