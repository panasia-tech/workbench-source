<wxs module="fmt" src="../../../utils/format.wxs" />

<!-- 验货详情（电脑版）：左边验货信息，右边商品图、上架图、瑕疵、拒签凭证 -->
<view class="dk-page" wx:if="{{task}}">
  <view class="dk-head">
    <view>
      <view class="dk-title dk-row">
        <text>{{task.inspect_no}}</text>
        <text class="dk-tag {{task.status === 'PENDING' ? 'tag-warning' : (task.action_type === 'REJECT' ? 'tag-danger' : 'tag-success')}}">{{task.status === 'PENDING' ? fmt.statusLabel(task.status) : (fmt.inspectionActionLabel(task.action_type) || fmt.statusLabel(task.status))}}</text>
      </view>
      <view class="dk-sub">{{task.product_name || '—'}}{{task.spec ? ' · ' + task.spec : ''}}</view>
    </view>
  </view>

  <view wx:if="{{task.condition_warning}}" class="id-dk-warn">⚠ 实拍图含「{{task.condition_warning_text || '全新'}}」字样，请重点核对货况</view>

  <view class="dk-split">
    <view class="id-dk-col">
      <view class="dk-card">
        <view class="dk-card__head"><text>验货信息</text></view>
        <view class="dk-card__body">
          <view class="dk-desc">
            <view class="dk-desc__item dk-desc__item--full"><text class="dk-desc__k">商品名称</text><text class="dk-desc__v">{{task.product_name || '—'}}</text></view>
            <view class="dk-desc__item"><text class="dk-desc__k">品牌</text><text class="dk-desc__v">{{task.brand || '—'}}</text></view>
            <view class="dk-desc__item"><text class="dk-desc__k">型号</text><text class="dk-desc__v">{{task.model || '—'}}</text></view>
            <view class="dk-desc__item"><text class="dk-desc__k">规格</text><text class="dk-desc__v">{{task.spec || '—'}}</text></view>
            <view class="dk-desc__item"><text class="dk-desc__k">采购价</text><text class="dk-desc__v">¥{{fmt.money(task.unit_price)}}</text></view>
            <view class="dk-desc__item"><text class="dk-desc__k">采购单号</text><text class="dk-desc__v">{{task.order_no || '—'}}</text></view>
            <view wx:if="{{task.inspection_result}}" class="dk-desc__item"><text class="dk-desc__k">验货结果</text><text class="dk-desc__v">{{fmt.inspectionResultLabel(task.inspection_result) || task.inspection_result}}</text></view>
            <view wx:if="{{task.action_type === 'INBOUND'}}" class="dk-desc__item">
              <text class="dk-desc__k">实收金额</text>
              <text class="dk-desc__v">¥{{fmt.money(task.actual_amount || task.unit_price)}}<text wx:if="{{!task.actual_amount}}" class="dk-muted">（沿用采购价）</text></text>
            </view>
            <view wx:if="{{task.location_code}}" class="dk-desc__item"><text class="dk-desc__k">库位</text><text class="dk-desc__v">{{task.location_code}}</text></view>
            <view wx:if="{{task.inspected_at}}" class="dk-desc__item"><text class="dk-desc__k">验货时间</text><text class="dk-desc__v">{{fmt.datetime(task.inspected_at)}}</text></view>
            <view wx:if="{{task.mismatch_remark}}" class="dk-desc__item dk-desc__item--full"><text class="dk-desc__k">货不对板说明</text><text class="dk-desc__v">{{task.mismatch_remark}}</text></view>
            <view wx:if="{{task.remark}}" class="dk-desc__item dk-desc__item--full"><text class="dk-desc__k">备注</text><text class="dk-desc__v">{{task.remark}}</text></view>
          </view>
        </view>
      </view>

    </view>

    <view class="id-dk-col">
      <view class="dk-card">
        <view class="dk-card__head"><text>商品图</text></view>
        <view class="dk-card__body">
          <image
            wx:if="{{task.product_image_thumb}}"
            class="id-dk-cover"
            src="{{task.product_image_thumb}}"
            mode="aspectFill"
            data-url="{{task.product_image || task.product_image_thumb}}"
            bindtap="dkPreview"
          />
          <view wx:else class="dk-muted">暂无商品图</view>
        </view>
      </view>

      <view wx:if="{{task.listing_images.length}}" class="dk-card">
        <view class="dk-card__head"><text>上架图</text><text class="dk-sub">{{task.listing_images.length}} 个</text></view>
        <view class="dk-card__body"><media-gallery urls="{{task.listing_images}}" thumb-size="large" /></view>
      </view>

      <view wx:if="{{task.defect_images.length || task.defect_videos.length}}" class="dk-card">
        <view class="dk-card__head"><text>瑕疵记录</text></view>
        <view class="dk-card__body">
          <media-gallery wx:if="{{task.defect_images.length}}" urls="{{task.defect_images}}" thumb-size="large" />
          <media-gallery wx:if="{{task.defect_videos.length}}" urls="{{task.defect_videos}}" thumb-size="large" />
        </view>
      </view>
      <view wx:if="{{task.reject_images.length}}" class="dk-card">
        <view class="dk-card__head"><text>拒签凭证</text></view>
        <view class="dk-card__body"><media-gallery urls="{{task.reject_images}}" thumb-size="large" /></view>
      </view>
    </view>
  </view>
</view>
<view class="dk-page" wx:elif="{{loading}}">
  <view class="dk-card"><view class="dk-empty">加载中…</view></view>
</view>
<view class="dk-page" wx:else>
  <view class="dk-card"><view class="dk-empty">未找到验货记录</view></view>
</view>
