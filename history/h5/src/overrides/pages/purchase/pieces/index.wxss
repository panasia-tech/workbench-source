.pc-page .card { margin-bottom: 20rpx; }
.pc-title { font-size: 32rpx; font-weight: 700; color: #111827; }
.pc-sub { margin-top: 6rpx; font-size: 24rpx; color: #6B7280; }
.pc-sum { margin-top: 12rpx; font-size: 28rpx; font-weight: 600; color: #1D4ED8; }
.pc-muted { margin-top: 8rpx; font-size: 24rpx; color: #6B7280; line-height: 1.6; }
.pc-h { font-size: 30rpx; font-weight: 700; color: #111827; margin-bottom: 8rpx; }
.pc-row { display: flex; gap: 16rpx; align-items: center; margin-top: 12rpx; }
.pc-input { flex: 1; height: 72rpx; padding: 0 20rpx; border: 2rpx solid #D1D5DB; border-radius: 12rpx; font-size: 30rpx; background: #fff; }
.pc-btn { flex: 1; margin: 0; }
.pc-piece { padding: 18rpx 0; border-bottom: 1rpx solid #F3F4F6; }
.pc-piece__head { display: flex; align-items: center; gap: 12rpx; }
.pc-piece__no { font-size: 28rpx; font-weight: 700; color: #111827; }
.pc-cost { margin-left: auto; font-size: 26rpx; color: #374151; }
.pc-state { padding: 4rpx 14rpx; border-radius: 999rpx; font-size: 22rpx; font-weight: 700; }
.pc-state--ok { background: #D1FAE5; color: #047857; }
.pc-state--bad { background: #FEE2E2; color: #B91C1C; }
.pc-state--wait { background: #FEF3C7; color: #B45309; }
.pc-line { margin-top: 6rpx; font-size: 24rpx; color: #4B5563; }
.pc-acts { display: flex; gap: 28rpx; margin-top: 10rpx; }
.pc-link { font-size: 26rpx; color: #1D4ED8; font-weight: 600; }
.pc-link--bad { color: #B91C1C; }
.pc-missing { margin-top: 12rpx; padding: 16rpx; border-radius: 12rpx; background: #FEF2F2; }
.pc-textarea { width: 100%; min-height: 100rpx; padding: 12rpx; box-sizing: border-box; border: 2rpx solid #FECACA; border-radius: 10rpx; background: #fff; font-size: 26rpx; }
