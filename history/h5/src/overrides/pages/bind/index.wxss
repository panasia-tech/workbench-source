/* 小程序那份登录页样式全在 app.wxss 里（bind-logo / input-wrap / pwd-eye），这里只补 H5 独有的两行 */
.h5-install {
  margin: 8rpx auto 0;
  width: fit-content;
  padding: 16rpx 28rpx;
  font-size: 26rpx;
  color: var(--color-primary);
}

.h5-beian {
  margin-top: 64rpx;
  text-align: center;
  font-size: 22rpx;
  line-height: 1.6;
}

.h5-beian-link {
  color: #9CA3AF;
  text-decoration: none;
}

/* 从员工工作台第一次进来：确认本人 */
.h5-confirm-tip {
  margin: -8rpx 0 28rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--text-secondary);
}

/* 记住密码 */
.h5-remember {
  display: inline-flex;
  align-items: center;
  gap: 14rpx;
  margin: -4rpx 0 32rpx;
  padding: 8rpx 0;
  font-size: 26rpx;
  color: var(--text-secondary);
}

.h5-check {
  position: relative;
  width: 34rpx;
  height: 34rpx;
  border: 2rpx solid #CBD5E1;
  border-radius: 8rpx;
  background: #fff;
  box-sizing: border-box;
  transition: background-color 0.15s, border-color 0.15s;
}

.h5-check--on {
  background: var(--color-primary);
  border-color: var(--color-primary);
}

.h5-check--on::after {
  content: '';
  position: absolute;
  left: 10rpx;
  top: 4rpx;
  width: 9rpx;
  height: 16rpx;
  border: solid #fff;
  border-width: 0 4rpx 4rpx 0;
  transform: rotate(45deg);
}

/* 「已记住密码」用主色，一眼看得出不用再输 */
.h5-pwd--remembered::placeholder {
  color: var(--color-primary);
  opacity: 0.85;
}

/* 电脑端：登录卡片不跟着 760 宽的列拉满，收成 440 宽居中 */
@media (min-width: 1024px) {
  .h5-login {
    max-width: 440px;
    margin: 0 auto;
    box-sizing: border-box;
  }
}

/* 钉钉工作台免登 */
.h5-dd-tip {
  text-align: center;
  color: #1d4ed8;
  font-size: 28rpx;
}

.h5-dd-err {
  margin-bottom: 20rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  background: #fef2f2;
  color: #b91c1c;
  font-size: 26rpx;
  line-height: 1.5;
}

.h5-dd-btn {
  margin-top: 20rpx;
}
