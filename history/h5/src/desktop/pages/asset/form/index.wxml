<!-- 资产信息（电脑版）：采购单来源、设备信息、归属信息、图片四张卡片，字段三栏；提交放底部操作条。数据、方法和手机版是同一套 -->
<view class="dk-page">
  <view class="dk-head">
    <view>
      <view class="dk-title">{{isEdit ? '编辑资产' : '新建资产'}}</view>
      <view class="dk-sub">{{isEdit ? '资产编号 ' + form.asset_no : '资产编号留空会自动生成'}}</view>
    </view>
  </view>

  <view class="dk-card">
    <view class="dk-card__head">采购单来源（可选）</view>
    <view class="dk-card__body">
      <view wx:if="{{form.purchase_order_id}}" class="dk-row">
        <text class="dk-tag dk-tag--blue">已关联：{{form.purchase_order_no}}</text>
        <text class="dk-link dk-link--danger" bindtap="onClearPurchase">取消关联</text>
      </view>
      <view wx:else class="af-dk-po">
        <input
          class="dk-input dk-search"
          placeholder="搜索采购单号…"
          value="{{purchaseSearchQ}}"
          bindinput="onPurchaseSearchInput"
        />
        <view wx:if="{{purchaseSearching}}" class="dk-help">搜索中…</view>
        <view wx:elif="{{purchaseResults.length}}" class="af-dk-results">
          <table class="dk-table">
            <thead>
              <tr>
                <th>采购单号</th>
                <th>商品</th>
                <th>品牌 / 型号</th>
                <th class="dk-ops">操作</th>
              </tr>
            </thead>
            <tbody>
              <tr wx:for="{{purchaseResults}}" wx:key="id" class="dk-tr--click" data-index="{{index}}" bindtap="onSelectPurchase">
                <td class="dk-nowrap dk-cell-main">{{item.order_no}}</td>
                <td>{{item.product_name}}</td>
                <td class="dk-nowrap">{{item.brand || '—'}}{{item.model ? ' ' + item.model : ''}}</td>
                <td class="dk-ops"><text class="dk-link">选这个</text></td>
              </tr>
            </tbody>
          </table>
        </view>
      </view>
    </view>
  </view>

  <view class="dk-card">
    <view class="dk-card__head">设备信息</view>
    <view class="dk-card__body dk-form dk-form--3">
      <view class="dk-field">
        <text class="dk-label dk-label--req">设备名称</text>
        <input class="dk-input" placeholder="如 iPhone 14 Pro Max" value="{{form.device_name}}" data-field="device_name" bindinput="onInput" />
      </view>
      <view class="dk-field">
        <text class="dk-label">资产编号</text>
        <view class="dk-row af-dk-nowrap">
          <input class="dk-input dk-grow" placeholder="留空自动生成，可扫条码" value="{{form.asset_no}}" data-field="asset_no" bindinput="onInput" />
          <view class="dk-btn" catchtap="onScanAssetNo">扫码</view>
        </view>
      </view>
      <view class="dk-field">
        <text class="dk-label">设备 SN</text>
        <input class="dk-input" placeholder="序列号" value="{{form.device_sn}}" data-field="device_sn" bindinput="onInput" />
      </view>
      <view class="dk-field">
        <text class="dk-label">品牌</text>
        <input class="dk-input" placeholder="品牌" value="{{form.brand}}" data-field="brand" bindinput="onInput" />
      </view>
      <view class="dk-field">
        <text class="dk-label">型号</text>
        <input class="dk-input" placeholder="型号" value="{{form.model}}" data-field="model" bindinput="onInput" />
      </view>
      <view class="dk-field">
        <text class="dk-label">规格</text>
        <input class="dk-input" placeholder="规格" value="{{form.spec}}" data-field="spec" bindinput="onInput" />
      </view>
      <view class="dk-field">
        <text class="dk-label">设备类型</text>
        <input class="dk-input" placeholder="如 显示器/手机/电脑" value="{{form.device_type}}" data-field="device_type" bindinput="onInput" />
      </view>
      <view class="dk-field">
        <text class="dk-label">单价</text>
        <input class="dk-input" type="digit" placeholder="0.00" value="{{form.unit_price}}" data-field="unit_price" bindinput="onInput" />
      </view>
      <view class="dk-field">
        <text class="dk-label">成本</text>
        <input class="dk-input" type="digit" placeholder="0.00" value="{{form.cost}}" data-field="cost" bindinput="onInput" />
      </view>
    </view>
  </view>

  <view class="dk-card">
    <view class="dk-card__head">归属信息</view>
    <view class="dk-card__body dk-form dk-form--3">
      <view class="dk-field">
        <text class="dk-label">使用人</text>
        <input class="dk-input {{isAdmin ? '' : 'af-dk-readonly'}}" placeholder="姓名" value="{{form.owner_name}}" data-field="owner_name" bindinput="onInput" disabled="{{!isAdmin}}" />
      </view>
      <view class="dk-field">
        <text class="dk-label">办公地点</text>
        <input class="dk-input" placeholder="如 杭州/深圳" value="{{form.office_site}}" data-field="office_site" bindinput="onInput" />
      </view>
      <view class="dk-field">
        <text class="dk-label">购入日期</text>
        <picker mode="date" value="{{form.purchase_date}}" bindchange="onInput" data-field="purchase_date">
          <view class="dk-select">{{form.purchase_date || '请选择'}}</view>
        </picker>
      </view>
      <view class="dk-field">
        <text class="dk-label">状态</text>
        <view class="dk-tabs af-dk-seg">
          <view
            wx:for="{{statusOptions}}"
            wx:key="key"
            class="dk-tab {{statusIndex === index ? 'dk-tab--on' : ''}}"
            data-index="{{index}}"
            bindtap="dkPickStatus"
          >{{item.label}}</view>
        </view>
      </view>
      <view class="dk-field af-dk-span2">
        <text class="dk-label">用途</text>
        <input class="dk-input" placeholder="用途说明" value="{{form.purpose}}" data-field="purpose" bindinput="onInput" />
      </view>
      <view class="dk-field dk-field--full">
        <text class="dk-label">备注</text>
        <textarea class="dk-input af-dk-textarea" placeholder="备注" value="{{form.remark}}" data-field="remark" bindinput="onInput" maxlength="500" />
      </view>
    </view>
  </view>

  <view class="dk-card">
    <view class="dk-card__head">
      <text>设备图片</text>
      <text class="dk-sub af-dk-note">{{form.image_files.length}} / 9</text>
    </view>
    <view class="dk-card__body">
      <view class="dk-gallery af-dk-gallery">
        <view wx:for="{{imageDisplays}}" wx:key="index" class="af-dk-item">
          <image src="{{item}}" mode="aspectFill" class="af-dk-img" data-url="{{item}}" data-urls="{{imageDisplays}}" bindtap="dkPreview" />
          <view class="af-dk-del" data-index="{{index}}" catchtap="onRemoveImage">×</view>
        </view>
        <view wx:if="{{form.image_files.length < 9}}" class="af-dk-add" bindtap="onChooseImage">
          <text class="af-dk-add__plus">+</text>
          <text class="dk-help">添加图片</text>
        </view>
      </view>
    </view>
  </view>

  <view class="dk-actionbar af-dk-bar">
    <button class="dk-btn dk-btn--primary af-dk-btn" bindtap="onSubmit" disabled="{{submitting}}" loading="{{submitting}}">
      {{submitting ? '提交中…' : (isEdit ? '保存修改' : '创建资产')}}
    </button>
  </view>
</view>
