<wxs module="fmt" src="../../utils/format.wxs" />

<!-- 我的（电脑版）：个人中心——资料卡 + 数字卡片 + 左边功能分组卡片、右边利润/工资/最近动态。数据、方法和手机版是同一套 -->
<view class="dk-page">
  <view class="dk-card pf-dk-hero" wx:if="{{user}}">
    <view class="pf-dk-avatar">{{user.name ? user.name[0] : (user.username ? user.username[0] : '?')}}</view>
    <view class="dk-grow">
      <view class="pf-dk-name">{{user.name || user.username}}</view>
      <view class="dk-row">
        <text class="dk-tag dk-tag--blue">{{fmt.roleLabel(user.role)}}</text>
        <text wx:if="{{user.username}}" class="dk-sub">@{{user.username}}</text>
      </view>
    </view>
    <view class="pf-dk-metrics">
      <view class="pf-dk-metric">
        <text class="pf-dk-metric__num pf-dk-c-orange">{{workload.today_purchase || 0}}</text>
        <text class="dk-sub">今日采购</text>
      </view>
      <view class="pf-dk-metric">
        <text class="pf-dk-metric__num pf-dk-c-blue">{{workload.today_inspection || 0}}</text>
        <text class="dk-sub">验货</text>
      </view>
      <view class="pf-dk-metric">
        <text class="pf-dk-metric__num pf-dk-c-green">{{workload.today_sales || 0}}</text>
        <text class="dk-sub">出库</text>
      </view>
    </view>
    <view class="dk-btn dk-btn--danger" bindtap="onLogout">退出登录</view>
  </view>

  <view wx:if="{{showStatsGrid}}" class="dk-stats">
    <view wx:if="{{showInspectStat}}" class="dk-stat dk-stat--click" bindtap="goPendingInspect">
      <view class="dk-stat__label">待验货</view>
      <view class="dk-stat__value">{{summary.pending_inspect || 0}}</view>
      <view class="dk-stat__hint">点开去验货</view>
    </view>
    <view wx:if="{{showInStockStat}}" class="dk-stat dk-stat--click" bindtap="goInStock">
      <view class="dk-stat__label">在库</view>
      <view class="dk-stat__value">{{summary.in_stock || 0}}</view>
      <view class="dk-stat__hint">点开看仓库</view>
    </view>
    <view wx:if="{{showPurchaseStat}}" class="dk-stat dk-stat--click" bindtap="goPurchaseRecords">
      <view class="dk-stat__label">今日采购</view>
      <view class="dk-stat__value">{{summary.today_purchase || 0}}</view>
      <view class="dk-stat__hint">点开看采购记录</view>
    </view>
    <view wx:if="{{showOutboundStat}}" class="dk-stat dk-stat--click" bindtap="goOutboundRecords">
      <view class="dk-stat__label">今日出库</view>
      <view class="dk-stat__value">{{summary.today_outbound || 0}}</view>
      <view class="dk-stat__hint">点开看出库记录</view>
    </view>
  </view>

  <view class="dk-split">
    <!-- 左：功能分组 -->
    <view class="pf-dk-groups">
      <view class="dk-card" wx:if="{{showCommissionRows}}">
        <view class="dk-card__head">工资</view>
        <view class="pf-dk-entry" bindtap="goPayslip">
          <view class="pf-dk-ico pf-dk-ico--finance">薪</view>
          <view class="dk-grow">
            <view class="pf-dk-entry__title">工资单明细</view>
            <view class="dk-cell-sub">逐笔提成 · 今日/昨日/本周/本月/任意月 · 逾期采购显示 ¥0</view>
          </view>
        </view>
      </view>

      <view class="dk-card" wx:if="{{showFinanceMenu}}">
        <view class="dk-card__head">财务</view>
        <view class="pf-dk-entry" bindtap="goBill">
          <view class="pf-dk-ico pf-dk-ico--finance">利</view>
          <view class="dk-grow">
            <view class="pf-dk-entry__title">经营账单</view>
            <view class="dk-cell-sub">采购/销售金额统计 · 按日/周/月/自定义区间 · 逐笔明细</view>
          </view>
        </view>
      </view>

      <view class="dk-card">
        <view class="dk-card__head">工具</view>
        <view class="pf-dk-entry" bindtap="goAsset">
          <view class="pf-dk-ico pf-dk-ico--asset">资</view>
          <view class="dk-grow">
            <view class="pf-dk-entry__title">资产管理</view>
            <view class="dk-cell-sub">{{isAdmin ? '设备资产登记 · 采购单关联 · 生命周期跟踪' : '登记我使用的设备资产'}}</view>
          </view>
        </view>
        <view class="pf-dk-entry" bindtap="goPhone">
          <view class="pf-dk-ico pf-dk-ico--phone">号</view>
          <view class="dk-grow">
            <view class="pf-dk-entry__title">手机号管理</view>
            <view class="dk-cell-sub">{{isAdmin ? '号码登记 · 套餐记录 · 闲鱼会员关联' : '登记我使用的号码 · 套餐 · 闲鱼会员'}}</view>
          </view>
        </view>
        <view class="pf-dk-entry" bindtap="goAccountProfile">
          <view class="pf-dk-ico pf-dk-ico--phone">档</view>
          <view class="dk-grow">
            <view class="pf-dk-entry__title">账号档案</view>
            <view class="dk-cell-sub">闲鱼账号初始化 · SN/IMEI/手机号自动采集 · 补全运营商/法人/种类</view>
          </view>
        </view>
        <view class="pf-dk-entry" bindtap="goLedger">
          <view class="pf-dk-ico pf-dk-ico--finance">账</view>
          <view class="dk-grow">
            <view class="pf-dk-entry__title">大台账</view>
            <view class="dk-cell-sub">{{isAdmin ? '法人 · 主体 · 支付宝 · 店铺 · 对账' : '登记法人 · 主体 · 支付宝 · 店铺'}}</view>
          </view>
        </view>
        <view wx:if="{{isAdmin}}" class="pf-dk-entry" bindtap="goGcBind">
          <view class="pf-dk-ico pf-dk-ico--asset">绑</view>
          <view class="dk-grow">
            <view class="pf-dk-entry__title">设备账号对账</view>
            <view class="dk-cell-sub">真机↔闲鱼 自动绑定 · 在线/就绪/串号 对账</view>
          </view>
        </view>
      </view>

      <view class="dk-card">
        <view class="dk-card__head">账号设置</view>
        <view class="pf-dk-entry" wx:if="{{user.role === 'ADMIN'}}" bindtap="goStats">
          <view class="pf-dk-ico pf-dk-ico--stats">统</view>
          <view class="dk-grow">
            <view class="pf-dk-entry__title">数据统计</view>
            <view class="dk-cell-sub">今日 / 昨日 / 近7天 / 近30天</view>
          </view>
        </view>
        <view class="pf-dk-entry" bindtap="goMyInfo">
          <view class="pf-dk-ico pf-dk-ico--phone">息</view>
          <view class="dk-grow">
            <view class="pf-dk-entry__title">个人信息</view>
            <view class="dk-cell-sub">手机卡信息 · 手机号 / ICCID / 空卡序列号（可绑定多张）</view>
          </view>
        </view>
        <view class="pf-dk-entry" wx:if="{{user.role === 'ADMIN'}}" bindtap="goMcp">
          <view class="pf-dk-ico pf-dk-ico--stats">M</view>
          <view class="dk-grow">
            <view class="pf-dk-entry__title">MCP 与使用说明</view>
            <view class="dk-cell-sub">AI 工具只读接入 ERP 数据 · 群控/AdsPower 操作指南</view>
          </view>
        </view>
        <view class="pf-dk-entry" bindtap="goChangePassword">
          <view class="pf-dk-ico pf-dk-ico--pwd">密</view>
          <view class="dk-grow">
            <view class="pf-dk-entry__title">修改密码</view>
            <view class="dk-cell-sub">修改后需重新绑定微信</view>
          </view>
        </view>
      </view>

      <view class="dk-card">
        <view class="dk-card__head">匿名反馈</view>
        <view class="pf-dk-entry" bindtap="goAnonymousFeedback">
          <view class="pf-dk-ico pf-dk-ico--stats">匿</view>
          <view class="dk-grow">
            <view class="pf-dk-entry__title">流程返工 / 系统反馈 / 投诉建议</view>
            <view class="dk-cell-sub">匿名保存并提交给管理后台处理</view>
          </view>
        </view>
      </view>
    </view>

    <!-- 右：当日净利润（管理员）、预计工资、最近动态（管理员） -->
    <view class="pf-dk-side">
      <view class="dk-card pf-dk-profit dk-stat--click" wx:if="{{isAdmin && financeStats}}" bindtap="goBill">
        <view class="dk-row">
          <text class="dk-grow pf-dk-profit__title">当日净利润</text>
          <text class="dk-link">查看账单 →</text>
        </view>
        <view class="pf-dk-profit__amt {{financeStats.net_profit < 0 ? 'pf-dk-neg' : ''}}">¥{{fmt.money(financeStats.net_profit)}}</view>
        <view class="dk-desc">
          <view class="dk-desc__item">
            <text class="dk-desc__k">毛利</text>
            <text class="dk-desc__v">¥{{fmt.money(financeStats.gross_profit)}}</text>
          </view>
          <view class="dk-desc__item">
            <text class="dk-desc__k">销售额</text>
            <text class="dk-desc__v">¥{{fmt.money(financeStats.sales_amount)}}</text>
          </view>
          <view class="dk-desc__item">
            <text class="dk-desc__k">提成</text>
            <text class="dk-desc__v">¥{{fmt.money(financeStats.staff_commission)}}</text>
          </view>
        </view>
      </view>

      <view class="dk-card" wx:if="{{commission}}">
        <view class="dk-card__head">
          <text>预计工资</text>
          <text class="dk-tag">今日</text>
        </view>
        <view class="dk-card__body">
          <view class="pf-dk-kv pf-dk-kv--total">
            <text>合计</text>
            <text class="pf-dk-kv__v">¥{{fmt.money(commission.total_commission)}}</text>
          </view>
          <block wx:if="{{showCommissionRows}}">
            <view class="pf-dk-kv" wx:if="{{showPurchaseCommission}}">
              <text class="dk-sub">采购提成</text>
              <text class="pf-dk-kv__v">¥{{fmt.money(commission.purchase_commission)}}</text>
            </view>
            <view class="pf-dk-kv" wx:if="{{showWarehouseCommission}}">
              <text class="dk-sub">仓管提成</text>
              <text class="pf-dk-kv__v">¥{{fmt.money(commission.warehouse_commission)}}</text>
            </view>
            <view class="pf-dk-kv" wx:if="{{showSalesCommission}}">
              <text class="dk-sub">销售提成</text>
              <text class="pf-dk-kv__v">¥{{fmt.money(commission.sales_commission)}}</text>
            </view>
          </block>
        </view>
      </view>

      <view class="dk-card" wx:if="{{isAdmin}}">
        <view class="dk-card__head">最近动态</view>
        <view wx:if="{{!activities.length}}" class="dk-empty">暂无动态</view>
        <scroll-view wx:else scroll-y class="pf-dk-feed" bindscrolltolower="loadMoreActivities" lower-threshold="60">
          <view wx:for="{{activities}}" wx:key="index" class="pf-dk-feed__item">
            <view class="pf-dk-feed__dot"></view>
            <view class="dk-grow">
              <view>{{fmt.stockEventLabel(item.event_type)}}{{item.ref_no ? ' · ' + item.ref_no : ''}}</view>
              <view wx:if="{{item.created_at}}" class="dk-cell-sub">{{fmt.datetime(item.created_at)}}</view>
            </view>
          </view>
          <view wx:if="{{activitiesLoading}}" class="pf-dk-feed__more">加载中…</view>
          <view wx:elif="{{activitiesHasMore}}" class="pf-dk-feed__more"><text class="dk-link" bindtap="loadMoreActivities">加载更多</text></view>
          <view wx:else class="pf-dk-feed__more">没有更多了</view>
        </scroll-view>
      </view>
    </view>
  </view>
</view>
