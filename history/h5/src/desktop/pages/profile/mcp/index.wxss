/* MCP 与使用说明（电脑版模板用；类名 mcp-dk-*） */
.mcp-dk-body {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.mcp-dk-err {
  color: #dc2626;
}

.mcp-dk-line {
  flex-wrap: nowrap;
  padding: 8px 10px;
  border: 1px solid #e5e7eb;
  border-radius: 6px;
  background: #f8fafc;
}

.mcp-dk-code {
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 13px;
  word-break: break-all;
}

.mcp-dk-inline {
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 12px;
  color: #2563eb;
}

.mcp-dk-h {
  margin-top: 16px;
  font-size: 14px;
  font-weight: 600;
}

.mcp-dk-h:first-child {
  margin-top: 0;
}

.mcp-dk-p {
  margin-top: 6px;
  font-size: 13px;
  line-height: 1.7;
  color: #4b5563;
}
