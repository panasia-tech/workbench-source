/* 我的（电脑版模板 index.wxml 用；类名都是 pf-dk-*，手机模板里没有） */
.pf-dk-hero {
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 18px 20px;
}

.pf-dk-avatar {
  width: 52px;
  height: 52px;
  flex: none;
  border-radius: 50%;
  background: #eff4ff;
  border: 1px solid #bfdbfe;
  color: #2563eb;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22px;
  font-weight: 600;
}

.pf-dk-name {
  font-size: 18px;
  font-weight: 600;
  margin-bottom: 4px;
}

.pf-dk-metrics {
  display: flex;
  gap: 8px;
}

.pf-dk-metric {
  min-width: 96px;
  padding: 8px 14px;
  border: 1px solid #e5e7eb;
  border-radius: 8px;
  background: #f8fafc;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.pf-dk-metric__num {
  font-size: 20px;
  font-weight: 600;
  line-height: 1.3;
  font-variant-numeric: tabular-nums;
}

.pf-dk-c-orange { color: #d97706; }
.pf-dk-c-blue { color: #2563eb; }
.pf-dk-c-green { color: #059669; }

/* 左边功能分组：两列卡片 */
.pf-dk-groups {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16px;
  align-items: start;
}

.pf-dk-entry {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px 16px;
  border-bottom: 1px solid #f0f1f3;
  cursor: pointer;
}

.pf-dk-entry:last-child {
  border-bottom: 0;
  border-radius: 0 0 8px 8px;
}

.pf-dk-entry:hover {
  background: #f8fafc;
}

.pf-dk-entry:hover .pf-dk-entry__title {
  color: #2563eb;
}

.pf-dk-entry__title {
  font-size: 14px;
  font-weight: 500;
}

.pf-dk-ico {
  width: 34px;
  height: 34px;
  flex: none;
  border-radius: 8px;
  color: #fff;
  font-size: 14px;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.pf-dk-ico--finance { background: linear-gradient(135deg, #10b981 0%, #047857 100%); }
.pf-dk-ico--stats { background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%); }
.pf-dk-ico--pwd { background: linear-gradient(135deg, #94a3b8 0%, #64748b 100%); }
.pf-dk-ico--asset { background: linear-gradient(135deg, #8b5cf6 0%, #6d28d9 100%); }
.pf-dk-ico--phone { background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%); }

/* 右栏 */
.pf-dk-side {
  display: flex;
  flex-direction: column;
  gap: 16px;
  min-width: 0;
}

.pf-dk-profit {
  padding: 16px;
}

.pf-dk-profit:hover {
  border-color: #2563eb;
}

.pf-dk-profit__title {
  font-size: 15px;
  font-weight: 600;
}

.pf-dk-profit__amt {
  margin: 6px 0 12px;
  font-size: 28px;
  font-weight: 700;
  color: #047857;
  font-variant-numeric: tabular-nums;
}

.pf-dk-neg {
  color: #dc2626;
}

.pf-dk-kv {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 6px 0;
}

.pf-dk-kv--total {
  padding: 4px 0 10px;
  margin-bottom: 4px;
  border-bottom: 1px solid #f0f1f3;
  font-weight: 600;
}

.pf-dk-kv--total .pf-dk-kv__v {
  font-size: 20px;
}

.pf-dk-kv__v {
  font-variant-numeric: tabular-nums;
  font-weight: 500;
}

.pf-dk-feed {
  max-height: 420px;
}

.pf-dk-feed__item {
  display: flex;
  gap: 10px;
  padding: 10px 16px;
  border-bottom: 1px solid #f0f1f3;
  font-size: 13px;
}

.pf-dk-feed__dot {
  width: 7px;
  height: 7px;
  flex: none;
  margin-top: 7px;
  border-radius: 50%;
  background: #93c5fd;
}

.pf-dk-feed__more {
  padding: 10px 16px;
  text-align: center;
  font-size: 12px;
  color: #9ca3af;
}
