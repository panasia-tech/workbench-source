/* 聚合会话（电脑版模板用的补充） */
.gcl-dk-avatar {
  position: relative;
  width: 32px;
  height: 32px;
  flex: none;
  border-radius: 50%;
  background: #fde68a;
  color: #92400e;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
  font-weight: 600;
}

.gcl-dk-badge {
  position: absolute;
  right: -6px;
  top: -5px;
  min-width: 16px;
  height: 16px;
  padding: 0 4px;
  border-radius: 8px;
  background: #ef4444;
  color: #fff;
  font-size: 10px;
  font-weight: 600;
  line-height: 16px;
  text-align: center;
  box-sizing: border-box;
}

.gcl-dk-last {
  max-width: 300px;
  color: #6b7280;
}

.gcl-dk-last--unread {
  color: #1f2937;
  font-weight: 600;
}

.gcl-dk-thumb {
  width: 32px;
  height: 32px;
}

.gcl-dk-title {
  max-width: 240px;
}

.gcl-dk-more {
  justify-content: center;
}
