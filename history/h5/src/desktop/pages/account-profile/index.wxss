/* 账号档案（电脑版模板用；类名 ap-dk-*） */
.ap-dk-badge {
  margin-left: 4px;
  min-width: 18px;
  height: 18px;
  padding: 0 5px;
  border-radius: 9px;
  background: #ef4444;
  color: #fff;
  font-size: 11px;
  line-height: 18px;
  text-align: center;
  font-weight: 500;
  box-sizing: border-box;
}

.ap-dk-ico {
  width: 28px;
  height: 28px;
  flex: none;
  border-radius: 6px;
  background: #fff7ed;
  color: #c2410c;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 13px;
  font-weight: 600;
}

.ap-dk-gap {
  margin-left: 4px;
}

.ap-dk-mono {
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 12px;
}

.ap-dk-strategy {
  max-width: 220px;
}
