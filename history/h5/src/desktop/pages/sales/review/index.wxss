/* 发货前复核（电脑版模板 index.wxml 用；通用样式在 src/styles/desktop.css） */
.rv-dk-split {
  grid-template-columns: minmax(0, 1fr) 380px;
}

.rv-dk-col {
  display: flex;
  flex-direction: column;
  gap: 16px;
  min-width: 0;
}

.rv-dk-warn {
  padding: 10px 14px;
  border-radius: 8px;
  border: 1px solid #fde68a;
  background: #fffbeb;
  color: #b45309;
  font-size: 13px;
}

.rv-dk-img {
  display: block;
  width: 100%;
  height: 100%;
  cursor: zoom-in;
}

.rv-dk-results {
  display: flex;
  gap: 8px;
}

.rv-dk-result {
  flex: 1;
  height: 36px;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid #d1d5db;
  border-radius: 6px;
  font-size: 13px;
  color: #374151;
  cursor: pointer;
}

.rv-dk-result--ok {
  border-color: #10b981;
  background: #ecfdf5;
  color: #047857;
  font-weight: 600;
}

.rv-dk-result--bad {
  border-color: #ef4444;
  background: #fef2f2;
  color: #b91c1c;
  font-weight: 600;
}

.rv-dk-media {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 8px;
}

.rv-dk-thumb {
  position: relative;
  aspect-ratio: 1;
  border-radius: 6px;
  overflow: hidden;
  background: #f3f4f6;
}

.rv-dk-x {
  position: absolute;
  top: 2px;
  right: 2px;
  width: 20px;
  height: 20px;
  line-height: 19px;
  text-align: center;
  border-radius: 50%;
  background: rgba(17, 24, 39, 0.72);
  color: #fff;
  font-size: 14px;
  cursor: pointer;
}

.rv-dk-add {
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px dashed #d1d5db;
  background: #fff;
  color: #6b7280;
  font-size: 12px;
  text-align: center;
  cursor: pointer;
}

.rv-dk-add:hover {
  border-color: #2563eb;
  color: #2563eb;
}

.rv-dk-submit {
  height: 36px;
}

/* textarea 默认 300px 宽（同小程序），电脑上撑满 */
.rv-dk-textarea {
  width: 100%;
  height: 88px;
}

/* 入库瑕疵逐项比对：一样 / 已修好 / 更严重 / 新问题（共用 JS 要逐项选完才能交） */
.rv-dk-chip {
  display: inline-block;
  margin: 2px 6px 2px 0;
  padding: 3px 10px;
  border: 1px solid #d1d5db;
  border-radius: 999px;
  font-size: 12px;
  color: #374151;
  cursor: pointer;
  user-select: none;
}

.rv-dk-chip--on {
  border-color: #2563eb;
  background: #eff6ff;
  color: #1d4ed8;
}

.rv-dk-chip--bad.rv-dk-chip--on {
  border-color: #dc2626;
  background: #fef2f2;
  color: #b91c1c;
}
