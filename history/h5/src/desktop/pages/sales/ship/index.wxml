<wxs module="fmt" src="../../../utils/format.wxs" />

<!-- 订单发货（电脑版）：左边订单 + 发货表单，右边货号核对结果和发货前复核入口，底部操作条提交 -->
<view class="dk-page">
  <block wx:if="{{order}}">
    <view class="dk-head">
      <view>
        <view class="dk-title">订单发货</view>
        <view class="dk-sub">单号 {{order.order_no}}</view>
      </view>
    </view>

    <view class="dk-split">
      <view class="sp-dk-main">
        <view class="dk-card">
          <view class="dk-card__head">订单</view>
          <view class="dk-card__body">
            <view class="dk-desc">
              <view class="dk-desc__item dk-desc__item--full">
                <text class="dk-desc__k">商品</text>
                <text class="dk-desc__v sp-dk-strong">{{order.product_title || order.order_no}}<text wx:if="{{order.product_spec}}" class="dk-muted"> · {{order.product_spec}}</text></text>
              </view>
              <view class="dk-desc__item">
                <text class="dk-desc__k">买家</text>
                <text class="dk-desc__v">{{order.buyer_name || '—'}}</text>
              </view>
              <view class="dk-desc__item">
                <text class="dk-desc__k">金额</text>
                <text class="dk-desc__v sp-dk-price">¥{{fmt.money(order.amount)}}</text>
              </view>
              <view class="dk-desc__item">
                <text class="dk-desc__k">店铺</text>
                <text class="dk-desc__v">{{fmt.platformLabel(order.shop_name, order.platform)}}</text>
              </view>
            </view>
          </view>
        </view>

        <view class="dk-card">
          <view class="dk-card__head">发货</view>
          <view class="dk-card__body">
            <view class="dk-form">
              <view class="dk-field dk-field--full">
                <text class="dk-label">发货方式</text>
                <view class="dk-row">
                  <view class="dk-tabs">
                    <view class="dk-tab {{deliveryMode === 'express' ? 'dk-tab--on' : ''}}" data-mode="express" bindtap="onDeliveryMode">快递发货</view>
                    <view class="dk-tab {{deliveryMode === 'pickup' ? 'dk-tab--on' : ''}}" data-mode="pickup" bindtap="onDeliveryMode">买家自提</view>
                  </view>
                  <text class="dk-help">{{deliveryMode === 'express' ? '填写快递运单号后提交出库' : '买家到店自提，无需运单号'}}</text>
                </view>
              </view>

              <view class="dk-field dk-field--full">
                <text class="dk-label dk-label--req">SKU 货号</text>
                <view class="dk-row">
                  <input
                    class="dk-input dk-grow"
                    placeholder="扫描或输入货号，输完自动核对"
                    value="{{skuCode}}"
                    bindinput="onSkuInput"
                    bindconfirm="checkSku"
                  />
                  <view class="dk-btn" bindtap="scanSku">扫码填入</view>
                </view>
              </view>

              <block wx:if="{{deliveryMode === 'express'}}">
                <view class="dk-field">
                  <text class="dk-label dk-label--req">快递运单号</text>
                  <input class="dk-input" placeholder="发货后粘贴运单号" value="{{trackingNo}}" bindinput="onTrackingInput" />
                </view>
                <view class="dk-field">
                  <text class="dk-label">手机后四位</text>
                  <input class="dk-input" placeholder="顺丰查询选填，收/寄件人手机号后 4 位" type="number" maxlength="4" value="{{trackingPhoneSuffix}}" bindinput="onPhoneSuffixInput" />
                </view>
              </block>
            </view>
          </view>
        </view>
      </view>

      <view class="dk-card">
        <view class="dk-card__head">货号核对</view>
        <view class="dk-card__body sp-dk-side">
          <block wx:if="{{match}}">
            <view class="sp-dk-ok">已匹配在库商品</view>
            <view class="dk-desc dk-desc--2">
              <view class="dk-desc__item dk-desc__item--full">
                <text class="dk-desc__k">商品</text>
                <text class="dk-desc__v">{{match.product_name || '—'}}</text>
              </view>
              <view class="dk-desc__item">
                <text class="dk-desc__k">规格</text>
                <text class="dk-desc__v">{{match.spec || '—'}}</text>
              </view>
              <view class="dk-desc__item">
                <text class="dk-desc__k">库位</text>
                <text class="dk-desc__v">{{match.location_code || '—'}}</text>
              </view>
            </view>
            <navigator class="sp-dk-review" url="/pages/sales/review/index?code={{skuCode}}" hover-class="none">发货前复核：看入库视频照片、核对实物 ›</navigator>
          </block>
          <view wx:elif="{{matchError}}" class="sp-dk-err">{{matchError}}</view>
          <view wx:else class="dk-empty sp-dk-wait">扫码或输入货号后，这里显示核对结果</view>
        </view>
      </view>
    </view>

    <view class="dk-actionbar sp-dk-bar">
      <text wx:if="{{!match}}" class="dk-help">货号核对通过后才能出库</text>
      <view
        class="dk-btn dk-btn--primary {{!match || submitting ? 'dk-btn--disabled' : ''}}"
        bindtap="confirmShip"
      >{{submitting ? '提交中…' : '确认出库发货'}}</view>
    </view>
  </block>

  <view wx:elif="{{standalonePickup}}" class="dk-card">
    <view class="dk-card__head">扫码出库（自提）</view>
    <view class="dk-card__body sp-dk-side">
      <view class="dk-sub">未关联闲鱼订单，请使用「买家自提出库」完整流程</view>
      <view><view class="dk-btn dk-btn--primary" bindtap="goPickupForm">前往自提出库</view></view>
    </view>
  </view>

  <view wx:elif="{{orderId}}" class="dk-card dk-empty">订单加载中…</view>
</view>
