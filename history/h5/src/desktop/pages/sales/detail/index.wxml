<wxs module="fmt" src="../../../utils/format.wxs" />

<!-- 销售详情（电脑版）：左边订单信息 + 物流轨迹，右边状态、操作、商品图 -->
<view class="dk-page">
  <view wx:if="{{!order}}" class="dk-card dk-empty">加载中…</view>
  <block wx:else>
    <view class="dk-head">
      <view>
        <view class="dk-title">{{fmt.productLine(order.product_title, order.product_spec) || order.order_no}}</view>
        <view class="dk-sub">单号 {{order.order_no}} · 下单 {{fmt.datetime(order.created_at)}}</view>
      </view>
      <view class="dk-row">
        <text class="dk-tag {{fmt.saleStatusTag(order.status)}}">{{fmt.saleStatusLabel(order.status)}}</text>
        <view wx:if="{{order.status === 'PENDING'}}" class="dk-btn dk-btn--primary" bindtap="goShip">去发货</view>
      </view>
    </view>

    <view class="dk-split">
      <view class="sd-dk-main">
        <view class="dk-card">
          <view class="dk-card__head">订单信息</view>
          <view class="dk-card__body">
            <view class="dk-desc">
              <view class="dk-desc__item">
                <text class="dk-desc__k">单号</text>
                <text class="dk-desc__v">{{order.order_no}}</text>
              </view>
              <view class="dk-desc__item">
                <text class="dk-desc__k">平台单号</text>
                <text class="dk-desc__v">{{order.external_order_no || '—'}}</text>
              </view>
              <view class="dk-desc__item">
                <text class="dk-desc__k">货号</text>
                <text class="dk-desc__v">{{order.sku_code || '—'}}</text>
              </view>
              <view class="dk-desc__item dk-desc__item--full">
                <text class="dk-desc__k">商品</text>
                <text class="dk-desc__v">{{fmt.productLine(order.product_title, order.product_spec) || '—'}}</text>
              </view>
              <view class="dk-desc__item">
                <text class="dk-desc__k">买家</text>
                <text class="dk-desc__v">{{order.buyer_name || '—'}}</text>
              </view>
              <view class="dk-desc__item">
                <text class="dk-desc__k">金额</text>
                <text class="dk-desc__v sd-dk-price">¥{{fmt.money(order.amount)}}</text>
              </view>
              <view class="dk-desc__item">
                <text class="dk-desc__k">店铺</text>
                <text class="dk-desc__v">{{fmt.platformLabel(order.shop_name, order.platform)}}</text>
              </view>
              <view class="dk-desc__item">
                <text class="dk-desc__k">下单时间</text>
                <text class="dk-desc__v">{{fmt.datetime(order.created_at)}}</text>
              </view>
              <view class="dk-desc__item">
                <text class="dk-desc__k">状态</text>
                <view class="dk-desc__v"><text class="dk-tag {{fmt.saleStatusTag(order.status)}}">{{fmt.saleStatusLabel(order.status)}}</text></view>
              </view>
              <view class="dk-desc__item" wx:if="{{order.tracking_no}}">
                <text class="dk-desc__k">运单号</text>
                <text class="dk-desc__v">{{order.tracking_no}}</text>
              </view>
              <view class="dk-desc__item" wx:if="{{order.tracking_phone_suffix}}">
                <text class="dk-desc__k">手机后四位</text>
                <text class="dk-desc__v">{{order.tracking_phone_suffix}}</text>
              </view>
            </view>
          </view>
        </view>

        <view class="dk-card" wx:if="{{order.tracking_no}}">
          <view class="dk-card__head">
            <text>物流轨迹<text class="dk-sub"> · {{order.tracking_no}}</text></text>
            <view class="dk-btn dk-btn--sm {{expressLoading ? 'dk-btn--disabled' : ''}}" bindtap="refreshExpress">{{expressLoading ? '查询中…' : '刷新'}}</view>
          </view>
          <view class="dk-card__body">
            <view wx:if="{{expressResult && expressResult.msg && !expressResult.traces.length}}" class="sd-dk-msg">{{expressResult.msg}}</view>
            <view wx:if="{{!expressResult || (!expressResult.traces.length && !expressResult.msg)}}" class="dk-empty">点「刷新」查询物流</view>
            <view class="sd-dk-tl" wx:if="{{expressResult && expressResult.traces.length}}">
              <view wx:for="{{expressResult.traces}}" wx:key="time" class="sd-dk-tl__item {{index === 0 ? 'sd-dk-tl__item--first' : ''}}">
                <view class="sd-dk-tl__dot"></view>
                <text class="sd-dk-tl__time">{{item.time}}</text>
                <text class="sd-dk-tl__text">{{item.context}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>

      <view class="sd-dk-main">
        <view class="dk-card">
          <view class="dk-card__head">商品图片</view>
          <view class="dk-card__body">
            <image
              wx:if="{{order.cover_url}}"
              class="sd-dk-cover"
              src="{{order.cover_thumb_url || order.cover_url}}"
              mode="aspectFit"
              data-url="{{order.cover_url}}"
              bindtap="dkPreview"
            />
            <view wx:else class="dk-empty">没有商品图</view>
          </view>
        </view>
      </view>
    </view>
  </block>
</view>
