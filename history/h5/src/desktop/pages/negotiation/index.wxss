/* 待议价（电脑版模板 index.wxml 用的补充；通用样式在 src/styles/desktop.css） */
.neg-dk-toolbar2 {
  padding-top: 0;
}

.neg-dk-warn {
  color: #c2410c;
}

.neg-dk-gap {
  margin-left: 4px;
}

.neg-dk-thumb-wrap {
  position: relative;
  flex: none;
}

.neg-dk-loc-badge {
  position: absolute;
  left: 0;
  bottom: 0;
  padding: 0 4px;
  border-radius: 0 4px 0 4px;
  background: rgba(17, 24, 39, 0.7);
  color: #fff;
  font-size: 10px;
  line-height: 16px;
}

.neg-dk-thumb-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #9ca3af;
  font-size: 13px;
}
