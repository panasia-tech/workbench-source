/* 议价定价（电脑版模板 index.wxml 用的补充；通用样式在 src/styles/desktop.css） */
.nf-dk-col {
  display: flex;
  flex-direction: column;
  gap: 16px;
  min-width: 0;
}

.nf-dk-warn {
  padding: 10px 16px;
  border: 1px solid #fecaca;
  border-radius: 8px;
  background: #fef2f2;
  color: #b91c1c;
  font-size: 13px;
  font-weight: 500;
}

.nf-dk-static {
  height: 32px;
  line-height: 32px;
  font-size: 14px;
  font-variant-numeric: tabular-nums;
}

.nf-dk-gap {
  margin-top: 12px;
}

.nf-dk-sum {
  margin-right: 12px;
  font-size: 18px;
  font-weight: 600;
  color: #2563eb;
  font-variant-numeric: tabular-nums;
}

.nf-dk-gallery-s {
  grid-template-columns: repeat(auto-fill, minmax(88px, 1fr));
}

/* 图片墙格子：media-thumb（size="fill"）铺满正方形；组件内部元素不带页面的 scope，要 :deep */
.nf-dk-cell {
  position: relative;
  aspect-ratio: 1;
  min-width: 0;
}

.nf-dk-cell :deep(.media-thumb--fill) {
  width: 100%;
  height: 100%;
  max-width: none;
  border-radius: 6px;
}

.nf-dk-del {
  position: absolute;
  top: 4px;
  right: 4px;
  width: 22px;
  height: 22px;
  border-radius: 50%;
  background: rgba(17, 24, 39, 0.65);
  color: #fff;
  font-size: 14px;
  line-height: 22px;
  text-align: center;
  cursor: pointer;
}

.nf-dk-del:hover {
  background: #dc2626;
}

.nf-dk-add {
  aspect-ratio: 1;
  border: 1px dashed #cbd5e1;
  border-radius: 6px;
  background: #f8fafc;
  color: #6b7280;
  font-size: 12px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2px;
  cursor: pointer;
}

.nf-dk-add:hover {
  border-color: #2563eb;
  color: #2563eb;
}

.nf-dk-add__plus {
  font-size: 24px;
  line-height: 1;
}

/* 小程序 textarea 默认 300px 宽，表单里要占满一行 */
.nf-dk-ta {
  width: 100%;
}
