/* 议价记录（电脑版模板 index.wxml 用的补充；通用样式在 src/styles/desktop.css） */
.nh-dk-gap {
  margin-left: 8px;
}

.nh-dk-strong {
  font-weight: 600;
}

.nh-dk-down {
  color: #047857;
}

.nh-dk-up {
  color: #b91c1c;
}

.nh-dk-thumb-wrap {
  position: relative;
  flex: none;
}

.nh-dk-loc-badge {
  position: absolute;
  left: 0;
  bottom: 0;
  padding: 0 4px;
  border-radius: 0 4px 0 4px;
  background: rgba(17, 24, 39, 0.7);
  color: #fff;
  font-size: 10px;
  line-height: 16px;
}

.nh-dk-thumb-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #9ca3af;
  font-size: 13px;
}

.nh-dk-name {
  max-width: 220px;
}

.nh-dk-tags {
  flex-wrap: nowrap;
  gap: 4px;
}
