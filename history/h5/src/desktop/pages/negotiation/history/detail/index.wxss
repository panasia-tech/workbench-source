/* 议价详情（电脑版模板 index.wxml 用的补充；通用样式在 src/styles/desktop.css） */
.nd-dk-col {
  display: flex;
  flex-direction: column;
  gap: 16px;
  min-width: 0;
}

.nd-dk-board {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16px;
  padding: 12px 16px;
  border-radius: 8px;
  background: #f8fafc;
}

.nd-dk-board__item {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.nd-dk-board__main {
  font-size: 24px;
  font-weight: 600;
  color: #2563eb;
  font-variant-numeric: tabular-nums;
}

.nd-dk-board__v {
  font-size: 18px;
  font-weight: 500;
  line-height: 36px;
  font-variant-numeric: tabular-nums;
}

.nd-dk-down {
  color: #047857;
}

.nd-dk-up {
  color: #b91c1c;
}

.nd-dk-gap {
  margin-top: 16px;
}

.nd-dk-gap-s {
  margin-top: 8px;
}

/* 图片墙里的 media-thumb（size="fill"）铺满正方形格子；组件内部元素不带页面的 scope，要 :deep */
.nd-dk-cell {
  aspect-ratio: 1;
  min-width: 0;
}

.nd-dk-cell :deep(.media-thumb--fill) {
  width: 100%;
  height: 100%;
  max-width: none;
  border-radius: 6px;
}

/* 右侧窄栏里的图片墙：一行 3 张 */
.nd-dk-gallery-s {
  grid-template-columns: repeat(auto-fill, minmax(88px, 1fr));
}
