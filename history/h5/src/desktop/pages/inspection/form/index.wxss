/* 验货（电脑版模板 index.wxml 用；手机模板里没有 if-dk- 类名） */
.if-dk-layout {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 400px;
  gap: 16px;
  align-items: start;
}

.if-dk-col {
  display: flex;
  flex-direction: column;
  gap: 16px;
  min-width: 0;
}

.if-dk-warn {
  padding: 10px 14px;
  border-radius: 8px;
  border: 1px solid #fde68a;
  background: #fffbeb;
  color: #b45309;
  font-size: 13px;
}

.if-dk-req {
  margin-right: 3px;
  color: #dc2626;
}

.if-dk-gap {
  margin-top: 8px;
}

.if-dk-code {
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
}

.if-dk-select {
  width: 100%;
  max-width: 320px;
}

.if-dk-reason {
  min-height: 140px;
}

.if-dk-chip {
  height: 32px;
  padding: 0 14px;
  display: inline-flex;
  align-items: center;
  border: 1px solid #d1d5db;
  border-radius: 6px;
  background: #fff;
  font-size: 13px;
  cursor: pointer;
  user-select: none;
}

.if-dk-chip:hover {
  border-color: #2563eb;
}

.if-dk-chip--on {
  border-color: #2563eb;
  background: #eff4ff;
  color: #1d4ed8;
  font-weight: 600;
}

.if-dk-chip--warn {
  border-color: #f59e0b;
  background: #fffbeb;
  color: #b45309;
}

.if-dk-cover {
  width: 100%;
  height: auto;
  aspect-ratio: 16 / 10;
  display: block;
  border-radius: 6px;
  background: #f3f4f6;
  cursor: zoom-in;
}

.if-dk-drop {
  padding: 22px 12px;
  border: 1px dashed #d1d5db;
  border-radius: 6px;
  background: #fafafa;
  color: #6b7280;
  font-size: 13px;
  text-align: center;
  cursor: pointer;
}

.if-dk-drop:hover {
  border-color: #2563eb;
  color: #2563eb;
}

.if-dk-btn-danger {
  background: #dc2626;
  border-color: #dc2626;
  color: #fff;
}

.if-dk-btn-danger:hover {
  background: #b91c1c;
  border-color: #b91c1c;
  color: #fff;
}

.if-dk-bar {
  margin-top: auto;
}

/* 库位对话框 */
.if-dk-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 50;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(17, 24, 39, 0.45);
}

.if-dk-dialog {
  width: 640px;
  max-width: calc(100vw - 48px);
  max-height: calc(100vh - 96px);
  display: flex;
  flex-direction: column;
  background: #fff;
  border-radius: 10px;
  box-shadow: 0 20px 50px rgba(15, 23, 42, 0.25);
}

.if-dk-dialog__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 16px 20px 12px;
  font-size: 16px;
  font-weight: 600;
}

.if-dk-loc-q {
  width: 220px;
  font-weight: 400;
}

.if-dk-locs {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
  gap: 8px;
  padding: 4px 20px 12px;
}

.if-dk-loc {
  height: 36px;
  padding: 0 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid #e5e7eb;
  border-radius: 6px;
  font-size: 13px;
  white-space: nowrap;
  cursor: pointer;
}

.if-dk-loc:hover {
  border-color: #2563eb;
  color: #2563eb;
}

.if-dk-loc--on {
  border-color: #2563eb;
  background: #eff4ff;
  color: #1d4ed8;
  font-weight: 600;
}

.if-dk-dialog__foot {
  display: flex;
  justify-content: flex-end;
  gap: 8px;
  padding: 12px 20px 16px;
  border-top: 1px solid #f0f1f3;
}

.if-dk-ta {
  width: 100%;
  box-sizing: border-box;
}
