/* 验货详情（电脑版模板 index.wxml 用；手机模板里没有 id-dk- 类名） */
.id-dk-col {
  display: flex;
  flex-direction: column;
  gap: 16px;
  min-width: 0;
}

.id-dk-warn {
  padding: 10px 14px;
  border-radius: 8px;
  border: 1px solid #fde68a;
  background: #fffbeb;
  color: #b45309;
  font-size: 13px;
}

.id-dk-cover {
  width: 100%;
  height: auto;
  aspect-ratio: 4 / 3;
  display: block;
  border-radius: 6px;
  background: #f3f4f6;
  cursor: zoom-in;
}
