<!-- 编辑商品（电脑版）：基本信息三栏表单 + 实拍图 / 定位图左右两块图片格子 + 底部操作条 -->
<view class="dk-page" wx:if="{{!loading}}">
  <view class="dk-head">
    <view>
      <view class="dk-title">编辑商品</view>
      <view class="dk-sub">货号 {{code}} · 改完点右下角「保存」，图片移除也是保存后才生效</view>
    </view>
  </view>

  <view class="dk-card">
    <view class="dk-card__head">基本信息</view>
    <view class="dk-card__body">
      <view class="dk-form dk-form--3">
        <view class="dk-field">
          <text class="dk-label dk-label--req">货号</text>
          <view class="whe-dk-scan">
            <input class="dk-input dk-grow" value="{{form.sku_code}}" data-field="sku_code" bindinput="onInput" placeholder="扫码或手填货号" />
            <view class="dk-btn" catchtap="scanSkuCode">扫码</view>
          </view>
        </view>
        <view class="dk-field">
          <text class="dk-label dk-label--req">商品名称</text>
          <input class="dk-input" value="{{form.product_name}}" data-field="product_name" bindinput="onInput" placeholder="商品名称" />
        </view>
        <view class="dk-field">
          <text class="dk-label">型号</text>
          <input class="dk-input" value="{{form.model}}" data-field="model" bindinput="onInput" placeholder="型号" />
        </view>
        <view class="dk-field">
          <text class="dk-label">规格</text>
          <input class="dk-input" value="{{form.spec}}" data-field="spec" bindinput="onInput" placeholder="规格" />
        </view>
        <view class="dk-field">
          <text class="dk-label">序列号</text>
          <view class="whe-dk-scan">
            <input class="dk-input dk-grow" value="{{form.serial_number}}" data-field="serial_number" bindinput="onInput" placeholder="扫码或手填" />
            <view class="dk-btn" catchtap="scanSerial">扫码</view>
          </view>
        </view>
        <view class="dk-field">
          <text class="dk-label">69码</text>
          <view class="whe-dk-scan">
            <input class="dk-input dk-grow" value="{{form.barcode}}" data-field="barcode" bindinput="onInput" placeholder="扫码或手填69码" />
            <view class="dk-btn" catchtap="scanBarcode69">扫码</view>
          </view>
        </view>
        <view class="dk-field">
          <text class="dk-label">库位</text>
          <picker class="whe-dk-picker" mode="selector" range="{{locations}}" range-key="label" value="{{locationIndex}}" bindchange="pickLocation">
            <view class="dk-select {{form.location_code ? '' : 'dk-muted'}}">{{form.location_code || '选择库位'}}</view>
          </picker>
        </view>
        <view class="dk-field">
          <text class="dk-label">成色</text>
          <picker class="whe-dk-picker" mode="selector" range="{{grades}}" value="{{gradeIndex}}" bindchange="pickGrade">
            <view class="dk-select {{form.condition_grade ? '' : 'dk-muted'}}">{{form.condition_grade || '选择成色'}}</view>
          </picker>
        </view>
      </view>
    </view>
  </view>

  <view class="dk-grid-2">
    <view class="dk-card">
      <view class="dk-card__head">
        <text>产品实拍图 <text class="dk-sub">{{form.images.length}} 张</text></text>
        <text class="dk-help">用于上架和客户展示，第一张将作为封面</text>
      </view>
      <view class="dk-card__body">
        <view class="whe-dk-grid">
          <view class="whe-dk-cell" wx:for="{{form.images}}" wx:key="*this">
            <media-thumb url="{{imageDisplay[index] || item}}" size="fill" preview="{{true}}" />
            <view wx:if="{{index === 0}}" class="whe-dk-cover">封面</view>
            <view class="whe-dk-del" title="移除" data-type="product" data-index="{{index}}" catchtap="removeImage">×</view>
          </view>
          <view class="whe-dk-add" data-type="product" bindtap="addImage">
            <text class="whe-dk-add__plus">+</text>
            <text>添加实拍图</text>
          </view>
        </view>
      </view>
    </view>

    <view class="dk-card">
      <view class="dk-card__head">
        <text>仓库定位图 <text class="dk-sub">{{form.location_images.length}} 张</text></text>
        <text class="dk-help">用于找货、盘点定位，不会展示给客户</text>
      </view>
      <view class="dk-card__body">
        <view class="whe-dk-grid">
          <view class="whe-dk-cell" wx:for="{{form.location_images}}" wx:key="*this">
            <media-thumb url="{{locationImageDisplay[index] || item}}" size="fill" preview="{{true}}" />
            <view class="whe-dk-del" title="移除" data-type="location" data-index="{{index}}" catchtap="removeImage">×</view>
          </view>
          <view class="whe-dk-add" data-type="location" bindtap="addImage">
            <text class="whe-dk-add__plus">+</text>
            <text>添加定位图</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="dk-actionbar whe-dk-bar">
    <view class="dk-btn" bindtap="dkBack">取消</view>
    <view class="dk-btn dk-btn--primary {{saving ? 'dk-btn--disabled' : ''}}" bindtap="save">{{saving ? '保存中…' : '保存'}}</view>
  </view>
</view>
<view wx:else class="dk-page"><view class="dk-card dk-empty">加载中…</view></view>
