<wxs module="fmt" src="../../utils/format.wxs" />

<!-- 仓库（电脑版）：数字卡片 + 筛选工具栏 + 表格 + 页码。数据、方法和手机版是同一套 -->
<view class="dk-page">
  <view class="dk-head">
    <view>
      <view class="dk-title">仓库</view>
      <view class="dk-sub">共 {{total}} 条{{listTab === 'all' ? '在库（含待上架、在售、锁单）' : (listTab === 'on_sale' ? '在售' : '锁单')}}</view>
    </view>
    <view class="dk-row">
      <view wx:if="{{canViewSkuMigration}}" class="dk-btn" bindtap="goSkuMigration">货号更换</view>
      <view wx:if="{{canViewSkuMigration}}" class="dk-btn" bindtap="goBarcodeMigration">69码更换</view>
      <view wx:if="{{canViewSkuMigration}}" class="dk-btn" bindtap="goSpuMatch">商品匹配</view>
      <view wx:if="{{canViewStocktake}}" class="dk-btn" bindtap="goStocktakeRecords">盘点记录</view>
      <view wx:if="{{canViewStocktake}}" class="dk-btn" bindtap="goStocktake">扫码盘点</view>
      <view wx:if="{{!isSales}}" class="dk-btn" bindtap="goOutbound">手动出库</view>
      <view wx:if="{{canViewStocktake}}" class="dk-btn dk-btn--primary" bindtap="goManualInbound">手动入库</view>
    </view>
  </view>

  <view class="dk-stats">
    <view class="dk-stat" wx:if="{{!isSales}}">
      <view class="dk-stat__label">库存成本</view>
      <view class="dk-stat__value">¥{{fmt.statMoney(summary.total_cost)}}</view>
    </view>
    <view class="dk-stat">
      <view class="dk-stat__label">在库数量</view>
      <view class="dk-stat__value">{{summary.total_count || 0}}</view>
    </view>
    <view class="dk-stat">
      <view class="dk-stat__label">在售</view>
      <view class="dk-stat__value">{{summary.on_sale_count || 0}}</view>
    </view>
    <view class="dk-stat">
      <view class="dk-stat__label">锁单</view>
      <view class="dk-stat__value">{{summary.locked_count || 0}}</view>
    </view>
    <view wx:if="{{gapTodo !== null}}" class="dk-stat dk-stat--click" bindtap="goGaps">
      <view class="dk-stat__label">库存缺口</view>
      <view class="dk-stat__value {{gapTodo ? 'wh-dk-warn' : ''}}">{{gapTodo || 0}}</view>
      <view class="dk-stat__hint">{{gapTodo ? '要人补的件数，点开处理' : '没有要补的'}}</view>
    </view>
  </view>

  <view class="dk-card">
    <view class="dk-toolbar">
      <view class="dk-tabs">
        <view
          wx:for="{{filterTabs}}"
          wx:key="key"
          class="dk-tab {{listTab === item.key ? 'dk-tab--on' : ''}}"
          data-tab="{{item.key}}"
          bindtap="switchListTab"
        >{{item.label}}</view>
      </view>
      <input
        class="dk-input dk-search"
        placeholder="货号 / 序列号 / 物流单号 / 商品名称"
        value="{{q}}"
        bindinput="onSearchInput"
        confirm-type="search"
        bindconfirm="onSearch"
      />
      <view class="dk-btn" bindtap="onScanSearch">扫码搜</view>
      <view class="dk-btn dk-btn--primary" bindtap="onSearch">搜索</view>
    </view>
    <view wx:if="{{tagOptions.length}}" class="dk-toolbar wh-dk-tags">
      <text class="dk-label">标签</text>
      <view
        class="dk-tab {{selectedTags.length ? '' : 'dk-tab--on'}}"
        bindtap="dkClearTags"
      >全部</view>
      <view
        wx:for="{{tagOptions}}"
        wx:key="id"
        class="dk-tab {{selectedTags.indexOf(item.name) >= 0 ? 'dk-tab--on' : ''}}"
        data-name="{{item.name}}"
        bindtap="dkToggleTag"
      >{{item.label || item.name}}</view>
      <text wx:if="{{selectedTags.length > 1}}" class="dk-help">多选为满足任意一个</text>
    </view>

    <view class="dk-table-wrap">
      <table class="dk-table">
        <thead>
          <tr>
            <th>商品</th>
            <th>SKU</th>
            <th>成色</th>
            <th>库位</th>
            <th>状态</th>
            <th class="dk-num">在售店铺</th>
            <th class="dk-num" wx:if="{{!isSales}}">成本</th>
            <th>入库 / 出库时间</th>
            <th class="dk-ops">操作</th>
          </tr>
        </thead>
        <tbody>
          <tr wx:for="{{list}}" wx:key="id" class="dk-tr--click" data-code="{{item.sku_code}}" bindtap="openDetail">
            <td>
              <view class="dk-media">
                <image
                  wx:if="{{item.cover_thumb_url || item.cover_url}}"
                  class="dk-thumb"
                  src="{{item.cover_thumb_url || item.cover_url}}"
                  mode="aspectFill"
                  data-url="{{item.cover_url || item.cover_thumb_url}}"
                  catchtap="dkPreview"
                />
                <view wx:elif="{{item.location_images[0]}}" class="wh-dk-thumb-wrap">
                  <image
                    class="dk-thumb"
                    src="{{item.location_images[0]}}"
                    mode="aspectFill"
                    data-url="{{item.location_images[0]}}"
                    catchtap="dkPreview"
                  />
                  <text class="wh-dk-loc-badge">定位</text>
                </view>
                <view wx:else class="dk-thumb wh-dk-thumb-empty">{{item.sku_code ? item.sku_code.slice(-2) : '?'}}</view>
                <view class="dk-grow">
                  <view class="dk-cell-main dk-ellipsis" title="{{item.product_name}}">{{item.product_name}}</view>
                  <view class="dk-cell-sub dk-ellipsis">{{item.spec || '—'}}</view>
                </view>
              </view>
            </td>
            <td class="dk-nowrap">{{item.sku_code}}</td>
            <td class="dk-nowrap">{{item.condition_grade || '—'}}</td>
            <td class="dk-nowrap">{{item.location_code || '未分配'}}</td>
            <td class="dk-nowrap">
              <text class="dk-tag {{fmt.warehouseItemTag(item)}}">{{fmt.warehouseItemLabel(item)}}</text>
              <text wx:if="{{fmt.legacyPendingVerify(item)}}" class="dk-tag tag-warning wh-dk-tag-gap">待核验</text>
            </td>
            <td class="dk-num">{{item.on_shelf_count > 0 ? item.on_shelf_count : '—'}}</td>
            <td class="dk-num" wx:if="{{!isSales}}">{{item.cost_price != null ? '¥' + fmt.money(item.cost_price) : '—'}}</td>
            <td class="dk-nowrap">
              <view>{{item.outbound_at ? fmt.datetime(item.outbound_at) : fmt.datetime(item.inbound_at || item.created_at)}}</view>
              <view class="dk-cell-sub">{{item.outbound_at ? '出库' : '入库'}}</view>
            </td>
            <td class="dk-ops">
              <text wx:if="{{item.reserve_source}}" class="dk-link" data-code="{{item.sku_code}}" catchtap="goShip">去销售发货</text>
              <text wx:elif="{{item.warehouse_phase === 'pending_create'}}" class="dk-link" data-code="{{item.sku_code}}" catchtap="goPublish">店铺上架</text>
              <block wx:elif="{{item.warehouse_phase === 'on_sale' || item.on_shelf_count > 0}}">
                <text class="dk-link" data-code="{{item.sku_code}}" catchtap="goPublish">店铺上架</text>
                <text class="dk-link" data-code="{{item.sku_code}}" catchtap="goDelist">店铺下架</text>
              </block>
              <text wx:else class="dk-link" data-code="{{item.sku_code}}" catchtap="openDetail">详情</text>
            </td>
          </tr>
        </tbody>
      </table>
    </view>

    <view wx:if="{{!list.length && !loading}}" class="dk-empty">{{emptyText}}</view>
    <view wx:if="{{loading && !list.length}}" class="dk-empty">加载中…</view>

    <!-- 搜索兜底：新系统没有在库结果，老系统快照里有匹配（仅供核对，不代表在库） -->
    <view wx:if="{{!list.length && !loading && legacyMatches.length}}" class="wh-dk-legacy">
      <view class="dk-card__head">
        <text>老系统历史记录</text>
        <text class="dk-sub">仅供核对，不代表当前在库；查不到在库记录时先按老系统资料实物核验，再补录 / 手动入库</text>
      </view>
      <table class="dk-table">
        <thead>
          <tr>
            <th>商品</th>
            <th>老货号</th>
            <th>序列号</th>
            <th>老库位</th>
            <th>状态</th>
            <th>新系统 SKU</th>
            <th class="dk-ops">操作</th>
          </tr>
        </thead>
        <tbody>
          <tr wx:for="{{legacyMatches}}" wx:key="goods_no">
            <td>
              <view class="dk-media">
                <image wx:if="{{item.cover_url}}" class="dk-thumb" src="{{item.cover_url}}" mode="aspectFill" data-url="{{item.cover_url}}" bindtap="dkPreview" />
                <view wx:else class="dk-thumb wh-dk-thumb-empty">老</view>
                <view class="dk-cell-main dk-ellipsis">{{item.product_name || '—'}}</view>
              </view>
            </td>
            <td class="dk-nowrap">{{item.goods_no || '—'}}</td>
            <td class="dk-nowrap">{{item.barcode || item.serial_no || '—'}}</td>
            <td class="dk-nowrap">{{item.location || '未记录'}}<text wx:if="{{item.legacy_tag}}" class="dk-muted"> · {{item.legacy_tag}}</text></td>
            <td><text class="dk-tag {{item.status === 'IN_STOCK' ? 'tag-warning' : 'tag-pending'}}">{{item.migrated_sku_code ? '已迁移' : (item.status === 'IN_STOCK' ? '老系统在库' : '老系统已出库')}}</text></td>
            <td class="dk-nowrap">{{item.migrated_sku_code || '—'}}</td>
            <td class="dk-ops">
              <text wx:if="{{canViewStocktake && !item.migrated_sku_code}}" class="dk-link" data-index="{{index}}" bindtap="goLegacyInbound">实物已核验，转手动入库</text>
            </td>
          </tr>
        </tbody>
      </table>
    </view>

    <view wx:if="{{total > dkPageSize}}" class="dk-pager">
      <text>共 {{total}} 条，每页 {{dkPageSize}} 条</text>
      <view class="dk-row">
        <view class="dk-btn dk-btn--sm {{dkPage <= 1 ? 'dk-btn--disabled' : ''}}" bindtap="dkPrev">上一页</view>
        <text>第 {{dkPage}} / {{dkPages}} 页</text>
        <view class="dk-btn dk-btn--sm {{dkPage >= dkPages ? 'dk-btn--disabled' : ''}}" bindtap="dkNext">下一页</view>
      </view>
    </view>
  </view>
</view>
