/* 商品详情（电脑版模板 index.wxml 用的补充样式；whd-dk- 开头，手机模板里不出现。通用样式在 src/styles/desktop.css） */
.whd-dk-banner {
  display: flex;
  flex-direction: column;
  gap: 2px;
  padding: 10px 16px;
  border: 1px solid #fed7aa;
  border-radius: 8px;
  background: #fff7ed;
  color: #9a3412;
  font-size: 13px;
}

.whd-dk-banner__title {
  font-weight: 600;
}

.whd-dk-sum {
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 16px;
}

.whd-dk-sum__img {
  width: 88px;
  height: 88px;
  flex: none;
  border-radius: 8px;
  background: #f3f4f6;
  cursor: zoom-in;
}

.whd-dk-sum__img--ph {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #9ca3af;
  font-size: 13px;
  cursor: default;
}

.whd-dk-sum__line {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin: 6px 0;
}

.whd-dk-sum__kv {
  display: flex;
  flex-wrap: wrap;
  gap: 4px 24px;
  font-size: 13px;
}

.whd-dk-sum__kv .dk-muted {
  margin-right: 6px;
}

.whd-dk-sum__ops {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 8px;
  flex: none;
}

.whd-dk-split {
  grid-template-columns: minmax(0, 1fr) 380px;
}

.whd-dk-col {
  display: flex;
  flex-direction: column;
  gap: 16px;
  min-width: 0;
}

.whd-dk-sec {
  margin: 20px 0 12px;
  padding-top: 16px;
  border-top: 1px solid #f0f1f3;
  font-size: 13px;
  font-weight: 600;
  color: #374151;
}

.whd-dk-sec--row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.whd-dk-headlink {
  font-size: 13px;
  font-weight: 400;
}

.whd-dk-gap {
  margin-left: 8px;
  font-weight: 400;
}

.whd-dk-gaptop {
  margin-top: 12px;
}

.whd-dk-ok {
  color: #047857;
}

.whd-dk-money {
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}

.whd-dk-help {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 16px;
  height: 16px;
  border-radius: 50%;
  border: 1px solid #d1d5db;
  color: #6b7280;
  font-size: 11px;
  font-weight: 400;
  cursor: pointer;
}

.whd-dk-help:hover {
  border-color: #2563eb;
  color: #2563eb;
}

/* 行情 */
.whd-dk-pricebar {
  margin-bottom: 12px;
}

.whd-dk-pricesum {
  display: flex;
  gap: 20px;
  margin-bottom: 12px;
  padding: 12px 16px;
  border-radius: 8px;
  background: linear-gradient(135deg, #fff7f0 0%, #fff2f2 100%);
}

.whd-dk-priceavg {
  flex: 1;
  min-width: 0;
}

.whd-dk-priceavg__v {
  font-size: 28px;
  font-weight: 700;
  line-height: 1.15;
  color: #111827;
  font-variant-numeric: tabular-nums;
}

.whd-dk-priceavg__d {
  font-size: 12px;
}

.whd-dk-priceband {
  flex: 1;
  min-width: 0;
  padding-left: 20px;
  border-left: 1px solid #fed7aa;
  font-size: 12px;
}

.whd-dk-priceband__v {
  margin: 2px 0;
  font-size: 16px;
  font-weight: 600;
  color: #7c2d12;
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
}

.whd-dk-pricesum-empty {
  margin-bottom: 12px;
}

.whd-dk-retry {
  margin-top: 8px;
}

.whd-dk-senti {
  margin-bottom: 12px;
}

.whd-dk-senti__bar {
  display: flex;
  height: 10px;
  overflow: hidden;
  border-radius: 999px;
  background: #eef2f7;
}

.whd-dk-senti__up {
  background: linear-gradient(90deg, #ff7a59 0%, #ff3d6e 100%);
}

.whd-dk-senti__down {
  background: linear-gradient(90deg, #2f6bff 0%, #5b8dff 100%);
}

.whd-dk-senti__legend {
  display: flex;
  justify-content: space-between;
  margin-top: 4px;
  font-size: 12px;
}

.whd-dk-insight {
  margin-bottom: 12px;
  padding: 10px 12px;
  border: 1px solid #d6e6ff;
  border-radius: 8px;
  background: #f0f6ff;
  font-size: 13px;
}

.whd-dk-insight__text {
  margin-top: 4px;
  line-height: 1.6;
  color: #1f2937;
}

.whd-dk-price {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 220px;
  gap: 16px;
  align-items: start;
}

.whd-dk-chart__img {
  width: 100%;
  display: block;
}

.whd-dk-pstats {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 8px;
}

.whd-dk-pstat {
  padding: 10px 12px;
  border: 1px solid #e5e7eb;
  border-radius: 6px;
}

.whd-dk-pstat__v {
  font-size: 17px;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}

.whd-dk-pstat__d {
  font-size: 12px;
}

.whd-dk-up {
  color: #dc2626;
}

.whd-dk-down {
  color: #059669;
}

.whd-dk-tablebox {
  border: 1px solid #f0f1f3;
  border-radius: 6px;
}

/* 店铺：多了在框里滚，表头钉在上面 */
.whd-dk-shopbox {
  max-height: 400px;
  overflow-y: auto;
}

.whd-dk-shopbox thead th {
  position: sticky;
  top: 0;
  z-index: 1;
}
.whd-dk-err {
  margin-top: 4px;
  max-width: 360px;
  font-size: 12px;
  color: #dc2626;
}

.whd-dk-next {
  color: #2563eb;
}

/* 图片 */
.whd-dk-label {
  margin-bottom: 8px;
  font-size: 13px;
  color: #6b7280;
}

.whd-dk-label--gap {
  margin-top: 16px;
}

.whd-dk-gallery {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 8px;
}

.whd-dk-cell {
  aspect-ratio: 1;
  min-width: 0;
}

.whd-dk-cell :deep(.media-thumb) {
  width: 100%;
  height: 100%;
  max-width: none;
  border-radius: 6px;
  cursor: zoom-in;
}

.whd-dk-imgempty {
  padding: 16px;
  border: 1px dashed #d1d5db;
  border-radius: 6px;
  text-align: center;
  font-size: 13px;
  color: #9ca3af;
  cursor: pointer;
}

.whd-dk-imgempty:hover {
  border-color: #2563eb;
  color: #2563eb;
}

.whd-dk-strip {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 6px;
  cursor: pointer;
}

.whd-dk-strip__cell {
  position: relative;
  aspect-ratio: 1;
  border-radius: 6px;
  overflow: hidden;
  background: #f3f4f6;
}

.whd-dk-strip__img {
  width: 100%;
  height: 100%;
  display: block;
}

.whd-dk-strip__more {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(17, 24, 39, 0.5);
  color: #fff;
  font-size: 15px;
  font-weight: 600;
}

/* 库龄 */
.whd-dk-age {
  display: flex;
  align-items: center;
  gap: 20px;
}

.whd-dk-age__n {
  font-size: 30px;
  font-weight: 700;
  line-height: 1.1;
  font-variant-numeric: tabular-nums;
}

.whd-dk-age__u {
  font-size: 14px;
  font-weight: 400;
  color: #6b7280;
}

.whd-dk-age__goal {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.whd-dk-age__gd {
  font-weight: 600;
  color: #111827;
}

.whd-dk-stage {
  padding: 1px 8px;
  border-radius: 4px;
  font-size: 12px;
  background: #ecfdf5;
  color: #047857;
}

.whd-dk-stage--clearance {
  background: #fff7ed;
  color: #c2410c;
}

.whd-dk-stage--stale {
  background: #fef2f2;
  color: #b91c1c;
}

.whd-dk-track {
  height: 6px;
  border-radius: 3px;
  background: #e5e7eb;
  overflow: hidden;
}

.whd-dk-track__fill {
  height: 100%;
  border-radius: 3px;
  background: linear-gradient(90deg, #22c55e, #f59e0b);
}

.whd-dk-track__fill--stale {
  background: #ef4444;
}

.whd-dk-c--normal,
.whd-dk-c--target {
  color: #059669;
}

.whd-dk-c--clearance {
  color: #ea580c;
}

.whd-dk-c--stale {
  color: #dc2626;
}

.whd-dk-agebar {
  position: relative;
  height: 46px;
  margin: 16px 18px 8px 4px;
}

.whd-dk-agebar__bar {
  position: relative;
  height: 8px;
  border-radius: 4px;
  background: linear-gradient(90deg, #22c55e 0%, #84cc16 22%, #facc15 50%, #f97316 72%, #ef4444 100%);
}

.whd-dk-agebar__now {
  position: absolute;
  top: -4px;
  width: 4px;
  height: 16px;
  margin-left: -2px;
  border-radius: 2px;
  background: #111827;
}

.whd-dk-agebar__tick {
  position: absolute;
  top: 14px;
  transform: translateX(-50%);
  font-size: 11px;
  line-height: 1.3;
  color: #6b7280;
  text-align: center;
  white-space: nowrap;
}

.whd-dk-agebar__tick--start {
  transform: none;
  text-align: left;
}

.whd-dk-agebar__tick--end {
  right: -18px;
  transform: none;
  text-align: right;
}

.whd-dk-mini3 {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 8px;
  margin-top: 12px;
}

.whd-dk-mini {
  padding: 8px 10px;
  border-radius: 6px;
  background: #f8fafc;
  min-width: 0;
}

.whd-dk-mini__v {
  font-size: 16px;
  font-weight: 600;
  line-height: 1.4;
}

.whd-dk-mini__v--s {
  font-size: 13px;
}

.whd-dk-switch switch {
  transform: scale(0.75);
  transform-origin: right center;
}

.whd-dk-autoops {
  margin-top: 12px;
}

.whd-dk-hold {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 10px;
  padding: 6px 10px;
  border-radius: 6px;
  background: #eff6ff;
  color: #1d4ed8;
  font-size: 13px;
}

/* 流转记录 */
.whd-dk-tl {
  position: relative;
  display: flex;
  gap: 10px;
  padding-bottom: 14px;
  font-size: 13px;
}

.whd-dk-tl::before {
  content: '';
  position: absolute;
  left: 4px;
  top: 14px;
  bottom: 0;
  width: 1px;
  background: #e5e7eb;
}

.whd-dk-tl:last-child {
  padding-bottom: 0;
}

.whd-dk-tl:last-child::before {
  display: none;
}

.whd-dk-tl__dot {
  width: 9px;
  height: 9px;
  margin-top: 5px;
  flex: none;
  border-radius: 50%;
  background: #d1d5db;
}

.whd-dk-tl--now .whd-dk-tl__dot {
  background: #2563eb;
  box-shadow: 0 0 0 3px #dbeafe;
}

/* 库龄设置对话框 */
.whd-dk-mask {
  position: fixed;
  inset: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(17, 24, 39, 0.45);
}

.whd-dk-dialog {
  width: 460px;
  max-width: calc(100vw - 48px);
  border-radius: 10px;
  background: #fff;
  box-shadow: 0 20px 40px rgba(15, 23, 42, 0.2);
}

.whd-dk-dialog__foot {
  display: flex;
  justify-content: flex-end;
  gap: 8px;
  padding: 12px 16px;
  border-top: 1px solid #f0f1f3;
}

/* 1024~1279 的窄电脑屏：右栏收窄，左栏的键值对改两列，行情图和数字上下排 */
@media (max-width: 1279px) {
  .whd-dk-split {
    grid-template-columns: minmax(0, 1fr) 320px;
  }

  .whd-dk-split .dk-desc {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .whd-dk-price {
    grid-template-columns: minmax(0, 1fr);
  }

  .whd-dk-pstats {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .whd-dk-gallery {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
}

/* 近期价格记录：闲鱼在售没有图，用文字占位；我们卖出的成交价标红 */
.whd-dk-rec-noimg {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 12px;
  color: #9ca3af;
}

.whd-dk-rec-sold {
  background: #fef2f2;
  color: #b91c1c;
}

/* ================================================================ 行情区精修（11-12，效果图版） */
price-trend-chart {
  display: block;
  width: 100%;
}

.whd-dk-sum__img {
  width: 104px;
  height: 104px;
}

.whd-dk-sum-cta {
  border: 0;
  color: #5b2e00;
  background: linear-gradient(180deg, #ffd25e 0%, #ffb02e 100%);
  box-shadow: 0 8px 18px rgba(255, 176, 46, 0.26);
}

.whd-dk-sum-cta.dk-btn--disabled {
  color: #fff;
  background: #cbd5e1;
  box-shadow: none;
  opacity: 0.8;
}

.whd-dk-grade-tag {
  color: #92400e;
  background: #fff7ed;
  border: 1px solid #fde68a;
}

.whd-dk-hero {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24px;
  padding: 4px 0 14px;
}

.whd-dk-hero-main {
  flex: 1;
  min-width: 0;
}

.whd-dk-hero-v {
  margin-top: 2px;
  font-size: 38px;
  font-weight: 700;
  line-height: 1.05;
  letter-spacing: -1px;
  color: #0f172a;
  font-variant-numeric: tabular-nums;
}

.whd-dk-hero-delta {
  display: inline-block;
  margin-top: 6px;
  padding: 2px 8px;
  border-radius: 999px;
  font-size: 12px;
  font-weight: 600;
}

.whd-dk-hero-delta.whd-dk-up {
  color: #e11d48;
  background: #fff1f2;
}

.whd-dk-hero-delta.whd-dk-down {
  color: #047857;
  background: #ecfdf5;
}

.whd-dk-hero-band {
  flex: none;
  width: 230px;
  padding-left: 22px;
  border-left: 1px solid #e2e8f0;
  text-align: right;
  font-size: 12px;
}

.whd-dk-hero-band-v {
  margin: 4px 0;
  font-size: 20px;
  font-weight: 700;
  color: #0f172a;
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
}

.whd-dk-chart-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 4px 0 2px;
}

.whd-dk-chart-stage {
  margin: 0 -4px;
}

.whd-dk-senti {
  margin-top: 14px;
  padding: 12px 14px;
  border-radius: 8px;
  background: #f8fafc;
}

.whd-dk-senti__top {
  display: flex;
  justify-content: space-between;
  margin-bottom: 6px;
  font-size: 12px;
  font-weight: 600;
}

.whd-dk-senti__bar {
  display: flex;
  height: 8px;
  overflow: hidden;
  border-radius: 999px;
  background: #eef2f7;
}

.whd-dk-senti__up {
  background: linear-gradient(90deg, #ff7a9a 0%, #ff3d6e 100%);
}

.whd-dk-senti__down {
  background: linear-gradient(90deg, #5b8dff 0%, #2f6bff 100%);
}

.whd-dk-senti__foot {
  display: flex;
  justify-content: space-between;
  margin-top: 5px;
  font-size: 11px;
  color: #94a3b8;
}

.whd-dk-mstats {
  display: flex;
  margin-top: 16px;
  padding: 12px 0;
  border-top: 1px solid #f1f5f9;
  border-bottom: 1px solid #f1f5f9;
}

.whd-dk-mstat {
  flex: 1;
  min-width: 0;
  padding: 0 14px;
  border-left: 1px solid #f1f5f9;
}

.whd-dk-mstat:first-child {
  padding-left: 0;
  border-left: 0;
}

.whd-dk-mstat__v {
  margin-top: 3px;
  font-size: 16px;
  font-weight: 600;
  color: #334155;
  white-space: nowrap;
  font-variant-numeric: tabular-nums;
}

.whd-dk-mstat__d {
  margin-top: 2px;
  font-size: 11px;
  color: #a3acba;
  white-space: nowrap;
}

/* 对齐效果图：灰色图表 + 细进度条 + 涨跌按钮 */
.whd-dk-market-panel {
  margin-top: 0;
  padding: 0;
  border-radius: 0;
  background: transparent;
  overflow: visible;
}

.whd-dk-chart-stage {
  margin: 0;
  background: transparent;
}

.whd-dk-senti {
  margin-top: 4px;
  padding: 0;
  border-radius: 0;
  background: transparent;
}

.whd-dk-senti__top {
  display: flex;
  justify-content: space-between;
  padding: 0 10px;
  margin-bottom: 5px;
  font-size: 11px;
  font-weight: 400;
}

.whd-dk-senti__top .whd-dk-up { color: #f73880; }
.whd-dk-senti__top .whd-dk-down { color: #0d80f7; }

.whd-dk-senti__bar {
  display: flex;
  gap: 4px;
  height: 4px;
  overflow: visible;
  border-radius: 0;
  background: transparent;
}

.whd-dk-senti__up {
  height: 4px;
  border-radius: 999px;
  background: #f73880;
}

.whd-dk-senti__down {
  height: 4px;
  border-radius: 999px;
  background: #0d80f7;
}

.whd-dk-senti__actions {
  display: flex;
  margin: 6px 10px 0;
  border-radius: 7px;
  overflow: hidden;
  background: #f7f7f7;
}

.whd-dk-senti__btn {
  flex: 1;
  height: 34px;
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 0 12px;
  font-size: 13px;
  font-weight: 400;
  color: #fff;
  letter-spacing: 1px;
}

.whd-dk-senti__btn--up {
  background: linear-gradient(180deg, #f73880 0%, #f86a90 100%);
  justify-content: flex-start;
  -webkit-clip-path: polygon(0 0, 100% 0, calc(100% - 14px) 100%, 0 100%);
  clip-path: polygon(0 0, 100% 0, calc(100% - 14px) 100%, 0 100%);
}

.whd-dk-senti__btn--down {
  background: linear-gradient(180deg, #0d80f7 0%, #2e99f6 100%);
  justify-content: flex-end;
  -webkit-clip-path: polygon(14px 0, 100% 0, 100% 100%, 0 100%);
  clip-path: polygon(14px 0, 100% 0, 100% 100%, 0 100%);
}

.whd-dk-senti__ic {
  flex: none;
  width: 16px;
  height: 16px;
  background-repeat: no-repeat;
  background-position: center;
  background-size: 100% 100%;
}

.whd-dk-senti__ic--up {
  background-image: url("data:image/svg+xml;base64,");
}

.whd-dk-senti__ic--down {
  background-image: url("data:image/svg+xml;base64,");
}
