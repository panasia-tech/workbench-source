/* 手动入库（电脑版模板用；whm-dk- 开头，手机模板里不出现） */
.whm-dk-scan {
  display: flex;
  gap: 8px;
}

.whm-dk-picker {
  display: block;
}

.whm-dk-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(104px, 1fr));
  gap: 10px;
}

.whm-dk-cell {
  position: relative;
  aspect-ratio: 1;
  min-width: 0;
}

.whm-dk-cell :deep(.media-thumb) {
  width: 100%;
  height: 100%;
  max-width: none;
  border-radius: 6px;
  cursor: zoom-in;
}

.whm-dk-cover {
  position: absolute;
  left: 0;
  bottom: 0;
  padding: 0 6px;
  border-radius: 0 6px 0 6px;
  background: rgba(37, 99, 235, 0.85);
  color: #fff;
  font-size: 11px;
  line-height: 18px;
}

.whm-dk-del {
  position: absolute;
  top: 4px;
  right: 4px;
  width: 22px;
  height: 22px;
  border-radius: 50%;
  background: rgba(17, 24, 39, 0.6);
  color: #fff;
  font-size: 15px;
  line-height: 22px;
  text-align: center;
  cursor: pointer;
}

.whm-dk-del:hover {
  background: #dc2626;
}

.whm-dk-add {
  aspect-ratio: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2px;
  border: 1px dashed #cbd5e1;
  border-radius: 6px;
  background: #f8fafc;
  color: #6b7280;
  font-size: 12px;
  cursor: pointer;
}

.whm-dk-add:hover {
  border-color: #2563eb;
  color: #2563eb;
}

.whm-dk-add__plus {
  font-size: 24px;
  line-height: 1;
}

/* 内容不满一屏时操作条也贴底 */
.whm-dk-bar {
  margin-top: auto;
}
