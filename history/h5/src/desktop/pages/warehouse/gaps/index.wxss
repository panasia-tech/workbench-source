/* 库存缺口（电脑版模板用；wgp-dk- 开头，手机模板里不出现） */
.wgp-dk-thumb {
  width: 44px;
  height: 44px;
  flex: none;
}

.wgp-dk-thumb :deep(.media-thumb) {
  width: 44px;
  height: 44px;
  border-radius: 4px;
  cursor: zoom-in;
}

.wgp-dk-none {
  width: 44px;
  height: 44px;
  border-radius: 4px;
  background: #f3f4f6;
  color: #9ca3af;
  font-size: 11px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.wgp-dk-name {
  max-width: 260px;
}

.wgp-dk-red {
  color: #dc2626;
}

.wgp-dk-note {
  max-width: 300px;
  font-size: 12px;
}

.wgp-dk-wait {
  margin-right: 6px;
}

.wgp-dk-mask {
  position: fixed;
  inset: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(17, 24, 39, 0.45);
}

.wgp-dk-dialog {
  width: 420px;
  max-width: calc(100vw - 48px);
  border-radius: 10px;
  background: #fff;
  box-shadow: 0 20px 40px rgba(15, 23, 42, 0.2);
}

.wgp-dk-checks {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10px 16px;
}

.wgp-dk-check {
  display: flex;
  align-items: center;
  gap: 8px;
  cursor: pointer;
}

.wgp-dk-box {
  width: 16px;
  height: 16px;
  border: 1px solid #9ca3af;
  border-radius: 4px;
  color: #fff;
  font-size: 12px;
  line-height: 16px;
  text-align: center;
}

.wgp-dk-box--on {
  border-color: #2563eb;
  background: #2563eb;
}

.wgp-dk-foot {
  display: flex;
  justify-content: flex-end;
  gap: 8px;
  padding: 12px 16px;
  border-top: 1px solid #f0f1f3;
}
