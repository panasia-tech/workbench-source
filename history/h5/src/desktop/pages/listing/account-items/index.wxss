/* 这个号发的商品（电脑版模板用的补充） */
.ai-dk-split {
  grid-template-columns: minmax(0, 1fr) 380px;
}

.ai-dk-side {
  position: sticky;
  top: 0;
}

.ai-dk-thumb-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #9ca3af;
  font-size: 13px;
}

.ai-dk-detail {
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.ai-dk-cover {
  width: 120px;
  height: 120px;
  border-radius: 6px;
  background: #f3f4f6;
  cursor: zoom-in;
}

.ai-dk-err {
  padding: 8px 12px;
  border-radius: 6px;
  background: #fef2f2;
  color: #b91c1c;
  font-size: 13px;
}

.ai-dk-desc {
  white-space: pre-wrap;
}

.ai-dk-name {
  max-width: 210px;
}

/* 「发布 2026-11-10 19:21」窄屏时折成两行，表格不出横向滚动 */
.ai-dk-when {
  min-width: 108px;
  font-variant-numeric: tabular-nums;
}

@media (max-width: 1360px) {
  .ai-dk-split {
    grid-template-columns: minmax(0, 1fr) 300px;
  }
}
