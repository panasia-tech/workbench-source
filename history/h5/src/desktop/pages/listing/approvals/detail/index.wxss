/* 上架审批 · 一件货（电脑版模板用的补充）。
 * 以前「居中一列」时代给手机模板挑图层加的 ≥1024 规则（.lap-cell 一行 6 个）已不需要：电脑上换成了这份模板 */
.lad-dk .lad-dk-st { background: #f3f4f6; color: #6b7280; }
.lad-dk .lap-st--draft { background: #eff6ff; color: #1d4ed8; }
.lad-dk .lap-st--wait { background: #fef3c7; color: #b45309; }
.lad-dk .lap-st--ok { background: #dcfce7; color: #15803d; }
.lad-dk .lap-st--bad { background: #fee2e2; color: #b91c1c; }

.lad-dk-strong {
  color: #c2410c;
}

.lad-dk-warn {
  padding: 10px 14px;
  border-radius: 8px;
  border: 1px solid #fed7aa;
  background: #fff7ed;
  color: #c2410c;
  font-size: 13px;
}

.dk-table td.lad-dk-top {
  vertical-align: top;
}

.lad-dk-th-box {
  width: 18px;
}

.lad-dk-box {
  width: 18px;
  height: 18px;
  border: 1px solid #cbd5e1;
  border-radius: 4px;
  background: #fff;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 12px;
  line-height: 1;
  cursor: pointer;
  box-sizing: border-box;
}

.lad-dk-box--on {
  background: #2563eb;
  border-color: #2563eb;
}

.lad-dk-shop {
  min-width: 150px;
}

.lad-dk-name {
  font-weight: 600;
  cursor: pointer;
}

.lad-dk-tags {
  gap: 6px;
  margin-top: 4px;
}

.lad-dk-err {
  margin-top: 4px;
  font-size: 12px;
  color: #dc2626;
}

.lad-dk-price {
  width: 110px;
}

.lad-dk-price--low {
  border-color: #dc2626;
}

.lad-dk-fill {
  display: inline-block;
  margin-top: 4px;
  font-size: 12px;
}

.lad-dk-strip {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  align-items: center;
}

.lad-dk-strip--sm {
  margin-top: 6px;
}

.lad-dk-pic {
  position: relative;
  width: 64px;
  height: 64px;
  flex: none;
}

.lad-dk-pic__img {
  display: block;
  width: 64px;
  height: 64px;
  border-radius: 4px;
  background: #f3f4f6;
  cursor: zoom-in;
}

.lad-dk-first {
  position: absolute;
  left: 0;
  bottom: 0;
  padding: 0 4px;
  border-radius: 0 4px 0 4px;
  background: rgba(37, 99, 235, 0.9);
  color: #fff;
  font-size: 10px;
  line-height: 16px;
}

.lad-dk-pic__ops {
  position: absolute;
  inset: 0;
  display: none;
  flex-direction: column;
  align-items: stretch;
  justify-content: center;
  gap: 2px;
  padding: 2px;
  border-radius: 4px;
  background: rgba(17, 24, 39, 0.55);
  box-sizing: border-box;
  pointer-events: none;
}

.lad-dk-pic:hover .lad-dk-pic__ops {
  display: flex;
}

.lad-dk-op {
  pointer-events: auto;
  border-radius: 3px;
  background: rgba(255, 255, 255, 0.92);
  color: #1f2937;
  font-size: 11px;
  line-height: 17px;
  text-align: center;
  cursor: pointer;
}

.lad-dk-op:hover {
  color: #2563eb;
}

.lad-dk-op--bad:hover {
  color: #dc2626;
}

.lad-dk-add {
  width: 64px;
  height: 64px;
  border: 1px dashed #cbd5e1;
  border-radius: 4px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #2563eb;
  font-size: 12px;
  cursor: pointer;
  box-sizing: border-box;
}

.lad-dk-add:hover {
  border-color: #2563eb;
  background: #eff4ff;
}

.lad-dk-add--wide {
  width: auto;
  padding: 0 14px;
}

.lad-dk-mini {
  width: 40px;
  height: 40px;
  border-radius: 4px;
  background: #f3f4f6;
  cursor: zoom-in;
}

.lad-dk-review {
  max-width: 260px;
  font-size: 13px;
}

.lad-dk-review__k {
  color: #6b7280;
}

.lad-dk-review__k--bad {
  color: #b91c1c;
}

.lad-dk-bar {
  margin-top: auto;
}

.lad-dk-bar__all {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  margin-right: auto;
  font-size: 13px;
  cursor: pointer;
}

.lad-dk-ok {
  color: #15803d;
  border-color: #86efac;
}

.lad-dk-ok:hover {
  background: #f0fdf4;
  border-color: #15803d;
  color: #15803d;
}

/* 居中对话框（手机上是底部弹层） */
.lad-dk-mask {
  position: fixed;
  inset: 0;
  z-index: 50;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(15, 23, 42, 0.45);
}

.lad-dk-dialog {
  width: 520px;
  max-width: calc(100vw - 48px);
  max-height: calc(100vh - 64px);
  display: flex;
  flex-direction: column;
  border-radius: 10px;
  background: #fff;
  box-shadow: 0 20px 50px rgba(15, 23, 42, 0.25);
}

.lad-dk-dialog--wide {
  width: 920px;
}

.lad-dk-dialog__body {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  padding: 16px;
}

.lad-dk-dialog__foot {
  display: flex;
  justify-content: flex-end;
  gap: 8px;
  padding: 12px 16px;
  border-top: 1px solid #f0f1f3;
}

.lad-dk-x {
  font-size: 20px;
  font-weight: 400;
  color: #9ca3af;
  cursor: pointer;
}

.lad-dk-x:hover {
  color: #1f2937;
}

.lad-dk-gap {
  margin-bottom: 12px;
}

.lad-dk-gap-top {
  margin-top: 14px;
}

.lad-dk-textarea {
  width: 100%;
  min-height: 96px;
}

.lad-dk-x-badge {
  position: absolute;
  right: -6px;
  top: -6px;
  width: 18px;
  height: 18px;
  border-radius: 50%;
  background: #dc2626;
  color: #fff;
  font-size: 13px;
  line-height: 18px;
  text-align: center;
  cursor: pointer;
}

.lad-dk-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
  gap: 10px;
  margin-bottom: 12px;
}

.lad-dk-cell {
  position: relative;
  aspect-ratio: 1;
  border-radius: 6px;
  overflow: hidden;
  background: #f3f4f6;
  border: 2px solid transparent;
  cursor: pointer;
  box-sizing: border-box;
}

.lad-dk-cell--on {
  border-color: #2563eb;
}

.lad-dk-cell--taken {
  cursor: not-allowed;
}

.lad-dk-cell--taken .lad-dk-cell__img {
  opacity: 0.35;
}

.lad-dk-cell--upload {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2px;
  border: 1px dashed #cbd5e1;
  background: #fff;
  color: #6b7280;
  font-size: 12px;
}

.lad-dk-cell--upload:hover {
  border-color: #2563eb;
  color: #2563eb;
}

.lad-dk-plus {
  font-size: 24px;
  line-height: 1;
}

.lad-dk-cell__img {
  display: block;
  width: 100%;
  height: 100%;
}

.lad-dk-badge {
  position: absolute;
  left: 4px;
  bottom: 4px;
  padding: 0 5px;
  border-radius: 3px;
  background: rgba(17, 24, 39, 0.6);
  color: #fff;
  font-size: 11px;
  line-height: 17px;
}

.lad-dk-badge--bad {
  background: rgba(220, 38, 38, 0.85);
}

.lad-dk-no {
  position: absolute;
  right: 4px;
  top: 4px;
  min-width: 20px;
  height: 20px;
  padding: 0 4px;
  border-radius: 10px;
  background: #2563eb;
  color: #fff;
  font-size: 12px;
  line-height: 20px;
  text-align: center;
  box-sizing: border-box;
}

.lad-dk-used {
  position: absolute;
  left: 0;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  padding: 2px 4px;
  background: rgba(17, 24, 39, 0.65);
  color: #fff;
  font-size: 12px;
  text-align: center;
}

.lad-dk-used--live {
  background: rgba(194, 65, 12, 0.8);
}

.lad-dk-cell__big {
  position: absolute;
  left: 4px;
  top: 4px;
  display: none;
  padding: 0 6px;
  border-radius: 3px;
  background: rgba(255, 255, 255, 0.92);
  color: #1f2937;
  font-size: 11px;
  line-height: 20px;
}

.lad-dk-cell:hover .lad-dk-cell__big {
  display: block;
}

.lad-dk-warn {
  margin-top: 4px;
  font-size: 12px;
  color: #B45309;
}

.lad-dk-reason {
  margin-top: 6px;
  width: 200px;
  border-color: #FCA5A5;
  background: #FEF2F2;
}
