/* 退货管理（电脑版模板 index.wxml 用的补充；通用样式在 src/styles/desktop.css） */
.ret-dk-name {
  max-width: 170px;
}

.ret-dk-reason {
  max-width: 120px;
}

/* 操作最多 4 个，放不下就折成两行，别把表格撑出横向滚动 */
.dk-table .ret-dk-opscell {
  width: 170px;
  white-space: normal;
  line-height: 22px;
}

.ret-dk-opscell .dk-link {
  display: inline-block;
  margin-left: 12px;
  white-space: nowrap;
}

.ret-dk-abnormal {
  max-width: 120px;
  margin-top: 2px;
  font-size: 12px;
  color: #b91c1c;
}

.ret-dk-thumb-wrap {
  position: relative;
  flex: none;
}

.ret-dk-loc-badge {
  position: absolute;
  left: 0;
  bottom: 0;
  padding: 0 4px;
  border-radius: 0 4px 0 4px;
  background: rgba(17, 24, 39, 0.7);
  color: #fff;
  font-size: 10px;
  line-height: 16px;
}

.ret-dk-thumb-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #9ca3af;
  font-size: 13px;
}
