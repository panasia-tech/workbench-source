{
  "name": "erp-h5",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "小程序（miniprogram/）的 H5 / PWA 版：构建时把 WXML/WXSS/JS 编译成网页，不另写一套页面",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check-compat.mjs && vite build",
    "deploy": "python3 ../scripts/deploy/publish_h5.py",
    "preview": "vite preview",
    "check": "node scripts/check-compat.mjs"
  },
  "dependencies": {
    "barcode-detector": "^3.2.2",
    "echarts": "^5.6.0",
    "vue": "^3.5.43",
    "workbox-window": "^7.4.1",
    "zxing-wasm": "3.1.3"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.9",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/compiler-sfc": "^3.5.43",
    "htmlparser2": "^12.0.0",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^2.0.0",
    "workbox-build": "^7.4.1"
  }
}
