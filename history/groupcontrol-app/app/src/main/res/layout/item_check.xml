<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="12dp"
    android:paddingTop="11dp"
    android:paddingEnd="12dp"
    android:paddingBottom="11dp">

    <ImageView
        android:id="@+id/ivChkIcon"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:src="@drawable/yy_ic_wait" />

    <TextView
        android:id="@+id/tvChkName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="11dp"
        android:textColor="@color/yy_ink"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvChkVideo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/yy_vchip"
        android:drawableStart="@drawable/yy_ic_play"
        android:drawablePadding="4dp"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingTop="4dp"
        android:paddingEnd="10dp"
        android:paddingBottom="4dp"
        android:text="引导视频"
        android:textColor="@color/yy_vchip_text"
        android:textSize="11sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvChkStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="待检测"
        android:textColor="@color/yy_ink3"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvChkFix"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="@drawable/yy_chip_bad"
        android:paddingStart="10dp"
        android:paddingTop="4dp"
        android:paddingEnd="10dp"
        android:paddingBottom="4dp"
        android:text="去修复"
        android:textColor="@color/yy_red"
        android:textSize="11sp"
        android:textStyle="bold"
        android:visibility="gone" />
</LinearLayout>
