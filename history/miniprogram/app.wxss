  height: 40rpx;
  border: 2rpx solid var(--color-primary-border);
  border-radius: var(--radius-ctrl);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-sizing: border-box;
}

.dl-check--on {
  background: var(--color-primary);
  border-color: var(--color-primary);
}

.dl-check--disabled {
  border-color: var(--border);
  background: var(--bg-input);
}

.dl-check-mark {
  color: #fff;
  font-size: 24rpx;
  line-height: 1;
}

/* 新群控异步:处理中提示 + 处理中标签脉冲 */
.dl-poll-hint {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin: 12rpx 0 4rpx;
  font-size: 24rpx;
  color: #1D4ED8;
}

.dl-poll-hint--stale {
  color: #B45309;
}

.dl-poll-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #1D4ED8;
  animation: dl-pulse 1s ease-in-out infinite;
}

.tag-processing {
  animation: dl-pulse 1.2s ease-in-out infinite;
}

@keyframes dl-pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.35; }
}
