/* ==========================================
   Design Tokens — Business UI
   ========================================== */

page {
  --bg-page: #F5F7FA;
  --bg-card: #FFFFFF;
  --text-primary: #1F2937;
  --text-title: #111827;
  --text-secondary: #6B7280;
  --text-muted: #9CA3AF;
  --color-primary: #2563EB;
  --color-primary-dark: #1D4ED8;
  --color-primary-bg: #EFF6FF;
  --color-primary-border: #BFDBFE;
  --color-success: #059669;
  --color-warning: #D97706;
  --color-danger: #DC2626;
  --border: #E5E7EB;
  --bg-input: #F9FAFB;
  --bg-neutral: #F3F4F6;
  --radius-card: 24rpx;
  --radius-ctrl: 12rpx;
  --radius-pill: 16rpx;
  --shadow-card: 0 2rpx 12rpx rgba(15, 23, 42, 0.06);
  background: var(--bg-page);
  color: var(--text-primary);
  font-size: 28rpx;
  line-height: 1.5715;
  box-sizing: border-box;
  -webkit-font-smoothing: antialiased;
}

view, text, button, input, textarea {
  box-sizing: border-box;
}

/* ===== Page Layout ===== */
.page-wrap {
  padding: 32rpx;
  padding-bottom: calc(112rpx + env(safe-area-inset-bottom) + 16rpx);
}

.page-wrap--no-tab {
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

/* ===== Card ===== */
.card {
  background: var(--bg-card);
  border: 1rpx solid var(--border);
  border-radius: var(--radius-card);
  padding: 40rpx;
  margin-bottom: 28rpx;
  box-shadow: var(--shadow-card);
}

.card-head {
  font-size: 30rpx;
  font-weight: 700;
  color: #1F2937;
  margin-bottom: 28rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.card-head::before {
  content: '';
  width: 6rpx;
  height: 28rpx;
  background: var(--color-primary);
  border-radius: 2rpx;
  flex-shrink: 0;
}

.card-head--split {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.card-head--split .card-head-main {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.express-batch-btn {
  flex-shrink: 0;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #1D4ED8;
  background: rgba(37, 99, 235, 0.12);
  border: 2rpx solid var(--color-primary-border);
}

.express-batch-btn.is-disabled {
  opacity: 0.55;
  pointer-events: none;
}

/* 物流查询区：独立圆角块，点击刷新；列表项其余区域进入验货 */
.list-item .li-express-zone {
  margin-top: 12rpx;
  padding: 16rpx 18rpx;
  border-radius: 20rpx;
  background: var(--color-primary-bg);
  border: 2rpx solid var(--color-primary-border);
}

.list-item .li-express-zone--readonly {
  background: var(--bg-input);
  border-color: #E5E7EB;
}

.list-item .li-express-zone-head {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.list-item .li-express-zone-label {
  flex-shrink: 0;
  font-size: 20rpx;
  font-weight: 800;
  color: #1D4ED8;
  padding: 4rpx 10rpx;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.65);
}

.list-item .li-express-zone--readonly .li-express-zone-label {
  color: #9CA3AF;
  background: rgba(255, 255, 255, 0.8);
}

.list-item .li-express-zone-no {
  flex: 1;
  min-width: 0;
  font-size: 22rpx;
  font-weight: 700;
  color: #1F2937;
  word-break: break-all;
}

.list-item .li-express-zone-action {
  flex-shrink: 0;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 800;
  color: #fff;
  background: #2563EB;
  border: 2rpx solid #1D4ED8;
}

.list-item .li-express-zone-scroll {
  max-height: 180rpx;
  margin-top: 10rpx;
  padding-top: 10rpx;
  border-top: 2rpx dashed rgba(37, 99, 235, 0.2);
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}

.list-item .li-express-zone-body {
  font-size: 22rpx;
  font-weight: 600;
  color: #6B7280;
  line-height: 1.45;
  word-break: break-all;
}

.list-item .li-express-zone-hint {
  margin-top: 10rpx;
  font-size: 20rpx;
  font-weight: 600;
  color: #1D4ED8;
}

.pd-express-scroll {
  max-height: 360rpx;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}

.card-head .head-extra {
  margin-left: auto;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1F2937;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.section-title::before {
  content: '';
  width: 6rpx;
  height: 28rpx;
  background: var(--color-primary);
  border-radius: 2rpx;
  flex-shrink: 0;
}

.section-label {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--text-secondary);
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.section-label::before {
  display: none;
}

/* ===== Stats Grid ===== */
.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin-bottom: 28rpx;
}

.stat-card {
  background: var(--bg-card);
  border: 1rpx solid var(--border);
  border-radius: var(--radius-card);
  padding: 36rpx 24rpx;
  box-shadow: var(--shadow-card);
  min-width: 0;
  overflow: hidden;
}

.stat-card .st-num {
  color: var(--text-title);
  font-size: 64rpx;
  font-weight: 800;
  line-height: 1;
  margin-bottom: 12rpx;
  letter-spacing: -2rpx;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.stat-card .st-label {
  font-size: 24rpx;
  font-weight: 700;
  color: #6B7280;
}


.stat-card--money .st-num {
  font-size: 40rpx;
  letter-spacing: -1rpx;
}

.stat-card .st-num.num--lg { font-size: 64rpx; letter-spacing: -2rpx; }
.stat-card--money .st-num.num--lg { font-size: 40rpx; letter-spacing: -1rpx; }
.stat-card .st-num.num--md { font-size: 48rpx; letter-spacing: -1rpx; }
.stat-card--money .st-num.num--md { font-size: 34rpx; letter-spacing: -1rpx; }
.stat-card .st-num.num--sm { font-size: 36rpx; letter-spacing: 0; }
.stat-card--money .st-num.num--sm { font-size: 28rpx; letter-spacing: 0; }
.stat-card .st-num.num--xs { font-size: 28rpx; letter-spacing: 0; }
.stat-card--money .st-num.num--xs { font-size: 24rpx; letter-spacing: 0; }
.stat-card--wide .st-num.num--lg { font-size: 48rpx; }
.stat-card--wide .st-num.num--md { font-size: 40rpx; }
.stat-card--wide .st-num.num--sm { font-size: 32rpx; }

.stat-card--wide {
  grid-column: 1 / -1;
}

.stats-periods {
  margin-bottom: 0;
}

.stats-loading {
  text-align: center;
  font-size: 24rpx;
  color: #6B7280;
  font-weight: 600;
  padding: 16rpx 0;
}

.li-arrow {
  color: #9CA3AF;
  font-weight: 700;
}

/* ===== Warehouse Stats ===== */
.w-stats {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.w-stat-card {
  background: var(--bg-card);
  border: 1rpx solid var(--border);
  border-radius: var(--radius-card);
  padding: 28rpx 16rpx;
  text-align: center;
  box-shadow: var(--shadow-card);
  min-width: 0;
  overflow: hidden;
}

.w-stat-card .ws-label {
  font-size: 22rpx;
  font-weight: 700;
  color: #6B7280;
  margin-bottom: 8rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.w-stat-card .ws-num {
  color: var(--text-title);
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1.1;
  letter-spacing: -1rpx;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.w-stat-card .ws-num.num--lg { font-size: 40rpx; letter-spacing: -1rpx; }
.w-stat-card .ws-num.num--md { font-size: 34rpx; letter-spacing: -1rpx; }
.w-stat-card .ws-num.num--sm { font-size: 28rpx; letter-spacing: 0; }
.w-stat-card .ws-num.num--xs { font-size: 24rpx; letter-spacing: 0; }


/* ===== Button ===== */
button {
  margin: 0;
  box-sizing: border-box;
  padding: 0 40rpx;
  height: 88rpx;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--bg-card);
  border: 1rpx solid var(--border);
  border-radius: var(--radius-pill);
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}

button::after {
  border: none;
}

.btn {
  box-sizing: border-box;
  padding: 0 40rpx;
  height: 88rpx;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid var(--border);
  border-radius: var(--radius-pill);
  font-size: 28rpx;
  font-weight: 600;
  background: var(--bg-card);
  color: var(--text-primary);
}

.btn-primary {
  background: var(--color-primary) !important;
  color: #fff !important;
  border-color: var(--color-primary) !important;
  box-shadow: none;
  border-radius: var(--radius-pill);
}

.btn-success {
  background: var(--color-success) !important;
  color: #fff !important;
  border-color: var(--color-success) !important;
  box-shadow: none;
}

.btn-outline {
  background: transparent !important;
  border-color: var(--color-primary-border) !important;
  color: var(--color-primary) !important;
  box-shadow: none !important;
}

.btn-danger {
  background: transparent !important;
  border-color: var(--color-danger) !important;
  color: var(--color-danger) !important;
  box-shadow: none !important;
}

.btn-sm {
  padding: 0 28rpx;
  height: 64rpx;
  font-size: 24rpx;
  border-radius: var(--radius-pill);
}

.btn-block {
  width: 100%;
}

.input-ph {
  color: #9CA3AF;
  font-size: 28rpx;
  font-weight: 400;
}

.action-bar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.action-bar .btn,
.action-bar button {
  flex: 1;
}

/* ===== Tag ===== */
.tag {
  box-sizing: border-box;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 40rpx;
  padding: 0 16rpx;
  line-height: 1;
  border-radius: 24rpx;
  font-size: 22rpx;
  font-weight: 700;
  border: 1rpx solid transparent;
  vertical-align: middle;
}

.tag-success { background: #D1FAE5; color: #047857; border-color: #A7F3D0; }
.tag-warning { background: #FFFBEB; color: #B45309; border-color: #FDE68A; }
.tag-danger { background: #FEE2E2; color: #B91C1C; border-color: #FECACA; }
.tag-info { background: #EFF6FF; color: #1D4ED8; border-color: #BFDBFE; }
.tag-pending { background: #F9FAFB; color: #6B7280; border-color: #E5E7EB; }

/* ===== 货况警示：实拍图疑似「全新/几乎全新」，验货/议价重点核对 ===== */
.condition-warn {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 16rpx 0;
  padding: 18rpx 22rpx;
  background: #FEE2E2;
  border: 1rpx solid #FCA5A5;
  border-radius: 12rpx;
}
.condition-warn__icon { font-size: 32rpx; line-height: 1; }
.condition-warn__text { flex: 1; color: #B91C1C; font-size: 26rpx; font-weight: 700; }
/* 列表里的角标小红条 */
.condition-warn-tag {
  display: inline-block;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  background: #FEE2E2;
  color: #B91C1C;
  border: 1rpx solid #FCA5A5;
  font-size: 22rpx;
  font-weight: 700;
}

/* ===== Pill ===== */
.pill-group {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.pill {
  display: inline-block;
  padding: 12rpx 32rpx;
  border: 1rpx solid var(--border);
  border-radius: var(--radius-pill);
  font-size: 24rpx;
  font-weight: 600;
  background: var(--bg-card);
  color: var(--text-secondary);
}

.pill.active,
.pill.selected {
  background: var(--color-primary);
  color: #fff;
  border-color: var(--color-primary);
}

/* ===== Form ===== */
.form-group {
  margin-bottom: 28rpx;
}

.form-label {
  font-size: 24rpx;
  font-weight: 700;
  color: #6B7280;
  margin-bottom: 12rpx;
  display: block;
}

.form-label .req {
  font-size: 20rpx;
  color: #DC2626;
  margin-left: 8rpx;
}

.input,
.form-input {
  box-sizing: border-box;
  display: block;
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 28rpx;
  border: 1rpx solid var(--border);
  border-radius: var(--radius-ctrl);
  font-size: 28rpx;
  background: var(--bg-input);
  color: var(--text-primary);
  margin: 0;
}

textarea.input,
.form-textarea {
  height: auto;
  min-height: 96rpx;
  max-height: 320rpx;
  line-height: 1.5;
  padding: 16rpx 28rpx;
}

.form-row {
  display: flex;
  gap: 16rpx;
}

.form-row .form-group {
  flex: 1;
}

/* 货号 / 单号 / 流水号：禁止与按钮横向挤占，输入框必须全宽 */
.input--code {
  width: 100%;
  box-sizing: border-box;
}

.code-input-field {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  width: 100%;
}

.code-input-field .input {
  width: 100%;
  box-sizing: border-box;
}

.code-input-scan {
  width: 100% !important;
  height: 72rpx;
  font-size: 26rpx;
}

.form-group--code .input {
  width: 100%;
  box-sizing: border-box;
}

.form-group--code .code-input-scan {
  margin-top: 16rpx;
}

/* 旧类名保留为纵向布局，避免横向挤压 */
.form-row-inline {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  width: 100%;
}

.form-row-inline .input,
.form-row-inline .flex-1 {
  width: 100%;
  flex: none;
  min-width: 0;
  box-sizing: border-box;
}

.form-row-inline .btn,
.form-row-inline button {
  width: 100%;
}

/* form-row 仅用于短字段（金额、数量等），长单号须单独 form-group */
.form-row--short .form-group {
  flex: 1;
  min-width: 0;
}

/* ===== Upload Zone ===== */
.upload-zone {
  border: 2rpx dashed var(--border);
  border-radius: var(--radius-card);
  padding: 64rpx 32rpx;
  text-align: center;
  background: rgba(255, 255, 255, 0.6);
  margin-bottom: 24rpx;
}

.upload-zone .uz-icon {
  width: 88rpx;
  height: 72rpx;
  margin: 0 auto 20rpx;
  background: #E5E7EB;
  border-radius: 12rpx;
  position: relative;
}

.upload-zone .uz-icon::after {
  content: '';
  position: absolute;
  top: -12rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 32rpx;
  height: 12rpx;
  background: #D1D5DB;
  border-radius: 6rpx 6rpx 0 0;
}

.upload-zone .uz-text {
  font-size: 28rpx;
  font-weight: 700;
  color: #1F2937;
}

.upload-zone .uz-hint {
  font-size: 22rpx;
  color: #9CA3AF;
  margin-top: 8rpx;
}

.upload-preview {
  width: 100%;
  max-height: 400rpx;
  border-radius: 32rpx;
  margin-top: 20rpx;
}

.upload-preview-slot {
  display: block;
  width: 100%;
  margin-top: 20rpx;
}

.tip-archived {
  color: #6B7280;
  background: #F9FAFB;
  border: 2rpx dashed #E5E7EB;
  border-radius: var(--radius-ctrl);
  padding: 16rpx 20rpx;
}

.pd-media-block {
  margin-top: 28rpx;
}

.pd-media-block .section-label {
  margin-bottom: 16rpx;
}

.list-item .li-thumb-wrap {
  position: relative;
  flex-shrink: 0;
  width: 120rpx;
  height: 120rpx;
  overflow: hidden;
  border-radius: var(--radius-ctrl);
}

/* 「定位」角标：列表项无产品图、改用仓库定位图兜底时标注，避免误当实拍主图。全局通用。 */
.media-loc-badge {
  position: absolute;
  left: 0;
  bottom: 0;
  padding: 2rpx 10rpx;
  font-size: 18rpx;
  line-height: 1.5;
  color: #fff;
  background: rgba(37, 99, 235, 0.85);
  border-top-right-radius: 10rpx;
  z-index: 1;
}

/* 组件 styleIsolation 默认 isolated，需约束宿主节点尺寸 */
.list-item .li-thumb-wrap media-thumb {
  width: 100%;
  height: 100%;
  display: block;
}

.list-item .li-thumb-wrap .li-icon {
  width: 120rpx;
  height: 120rpx;
  line-height: 120rpx;
  font-size: 28rpx;
  border-radius: var(--radius-ctrl);
}

.wh-thumb-wrap {
  width: 112rpx;
  height: 112rpx;
  flex-shrink: 0;
}

.wh-thumb-wrap .media-thumb--small {
  width: 112rpx;
  height: 112rpx;
}

/* ===== List Item ===== */
.list-item {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.list-item:last-child {
  border-bottom: none;
}

.list-item .li-icon {
  width: 84rpx;
  height: 84rpx;
  border-radius: var(--radius-ctrl);
  background: var(--bg-neutral);
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-muted);
  border: 1rpx solid var(--border);
  overflow: hidden;
}

.list-item .li-info {
  flex: 1;
  min-width: 0;
  padding-top: 2rpx;
}

.list-item .li-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #111827;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  word-break: break-all;
}

.list-item .li-sub {
  font-size: 22rpx;
  color: #6B7280;
  margin-top: 8rpx;
  font-weight: 600;
  line-height: 1.4;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.list-item .li-meta {
  text-align: right;
  flex-shrink: 0;
  min-width: 120rpx;
  padding-top: 2rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 10rpx;
}

/* 上图下文：商品行 + 物流块各占一行，避免标题与缩略图/价格挤压重叠 */
.list-item--stacked {
  flex-direction: column;
  align-items: stretch;
  gap: 0;
}

.list-item--stacked .list-item__main {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  width: 100%;
}

.list-item--stacked .li-express-zone {
  width: 100%;
  margin-top: 16rpx;
  box-sizing: border-box;
}

.list-item .li-price {
  font-size: 30rpx;
  font-weight: 800;
  color: #DC2626;
}

.list-item .li-sub--muted {
  margin-top: 2rpx;
}

.list-item .li-sub--time {
  margin-top: 2rpx;
  color: #9CA3AF;
}

.list-item .li-sub--express {
  margin-top: 2rpx;
  color: #9CA3AF;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.list-item .li-tag {
  margin-top: 8rpx;
  /* 必须保持 inline-flex：.tag 靠 flex 垂直居中，inline-block 会让文字顶到标签上沿 */
  display: inline-flex;
}

.list-item .li-meta .li-tag {
  margin-top: 0;
}

/* ===== Warehouse Item ===== */
.wh-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.wh-item:last-child {
  border-bottom: none;
}

.wh-thumb {
  width: 112rpx;
  height: 112rpx;
  border-radius: 32rpx;
  flex-shrink: 0;
  background: #F9FAFB;
