  border-radius: 36rpx;
  font-size: 26rpx;
}

/* ===== 标准「可扫码搜索框」（全局复用，勿再逐页复制） =====
   标准结构：
   <view class="search-bar">
     <view class="search-input-wrap">
       <input class="search-input search-input--with-scan" placeholder="..." ... />
       <view class="search-scan-icon" catchtap="onScanSearch">
         <view class="scan-frame"></view><view class="scan-line"></view>
       </view>
     </view>
   </view>
   新建带「货号/单号…」多条件搜索的页面一律用这套，不要另写宽度/图标样式。 */
.search-input-wrap {
  position: relative;
  flex: 1;
  display: flex;
  align-items: center;
}

.search-input--with-scan {
  flex: 1;
  width: 100%;
  padding-right: 84rpx;
  box-sizing: border-box;
}

.search-scan-icon {
  position: absolute;
  right: 8rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.search-scan-icon:active {
  opacity: 0.6;
}

.search-scan-icon .scan-frame {
  position: relative;
  width: 34rpx;
  height: 34rpx;
  background:
    linear-gradient(#2563EB, #2563EB) left top,
    linear-gradient(#2563EB, #2563EB) left top,
    linear-gradient(#2563EB, #2563EB) right top,
    linear-gradient(#2563EB, #2563EB) right top,
    linear-gradient(#2563EB, #2563EB) left bottom,
    linear-gradient(#2563EB, #2563EB) left bottom,
    linear-gradient(#2563EB, #2563EB) right bottom,
    linear-gradient(#2563EB, #2563EB) right bottom;
  background-repeat: no-repeat;
  background-size: 12rpx 3rpx, 3rpx 12rpx;
}

.search-scan-icon .scan-line {
  position: absolute;
  left: 15rpx;
  right: 15rpx;
  height: 3rpx;
  background: #2563EB;
  border-radius: 2rpx;
}

.search-btn {
  flex-shrink: 0;
  margin: 0;
  padding: 0 28rpx;
  height: 72rpx;
  line-height: 72rpx;
}

.date-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.date-pill {
  padding: 16rpx 24rpx;
