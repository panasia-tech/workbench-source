.wb-page .wb-hero {
  margin-bottom: 24rpx;
  padding: 32rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  border: 1rpx solid #E5E7EB;
  box-shadow: 0 2rpx 12rpx rgba(15, 23, 42, 0.06);
}

.wb-page .wb-hero-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.wb-page .wb-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 16rpx;
  background: #2563EB;
  color: #fff;
  font-size: 36rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.wb-page .wb-hero-body {
  flex: 1;
  min-width: 0;
}

.wb-page .wb-greeting {
  font-size: 34rpx;
  font-weight: 700;
  color: #111827;
  line-height: 1.3;
}

.wb-page .wb-role {
  margin-top: 8rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #2563EB;
}

.wb-page .wb-hero-tip {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #6B7280;
  font-weight: 500;
}

.wb-page .wb-entry-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.wb-page .wb-entry-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 28rpx 24rpx;
  border-radius: 16rpx;
  background: #FFFFFF;
  border: 1rpx solid #E5E7EB;
  box-shadow: 0 2rpx 12rpx rgba(15, 23, 42, 0.04);
}

.wb-page .wb-entry-item:active {
  opacity: 0.85;
}

.wb-page .wb-entry-body {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: 1;
  min-width: 0;
}

.wb-page .wb-entry-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 12rpx;
  font-size: 32rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.wb-page .wb-entry-icon--purchase {
  background: #EFF6FF;
  color: #2563EB;
  border: 1rpx solid #BFDBFE;
}

.wb-page .wb-entry-icon--inspection {
  background: #EFF6FF;
  color: #2563EB;
  border: 1rpx solid #BFDBFE;
}

.wb-page .wb-entry-icon--warehouse {
  background: #ECFDF5;
  color: #059669;
  border: 1rpx solid #A7F3D0;
}

.wb-page .wb-entry-icon--sales {
  background: #FFFBEB;
  color: #D97706;
  border: 1rpx solid #FDE68A;
}

.wb-page .wb-entry-icon--negotiation {
  background: #F5F3FF;
  color: #7C3AED;
  border: 1rpx solid #DDD6FE;
}

.wb-page .wb-entry-icon--returns {
  background: #FFF1F2;
  color: #E11D48;
  border: 1rpx solid #FECDD3;
}

.wb-page .wb-entry-icon--lawsuit {
  background: #FEFCE8;
  color: #CA8A04;
  border: 1rpx solid #FEF08A;
}

.wb-page .wb-entry-icon--listing {
  background: #EFF6FF;
  color: #2563EB;
  border: 1rpx solid #BFDBFE;
}

.wb-page .wb-entry-icon--chat {
  background: #ECFEFF;
  color: #0891B2;
  border: 1rpx solid #A5F3FC;
}

.wb-page .wb-entry-icon--finance {
  background: #ECFEFF;
  color: #0891B2;
  border: 1rpx solid #A5F3FC;
}

.wb-page .wb-entry-icon--asset-intake {
  background: #EEF2FF;
  color: #4F46E5;
  border: 1rpx solid #C7D2FE;
}

.wb-page .wb-entry-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #111827;
  line-height: 1.3;
}

.wb-page .wb-entry-sub {
  font-size: 22rpx;
  color: #6B7280;
  font-weight: 500;
  margin-top: 4rpx;
}

.wb-page .wb-entry-arrow {
  font-size: 36rpx;
  font-weight: 600;
  color: #9CA3AF;
  line-height: 1;
  flex-shrink: 0;
}


/* 销售工作台入口的红点、练习门禁的锁 */
.wb-entry-badge { flex: none; min-width: 36rpx; height: 36rpx; padding: 0 10rpx; margin-right: 10rpx; border-radius: 18rpx; background: #EF4444; color: #FFFFFF; font-size: 21rpx; font-weight: 700; line-height: 36rpx; text-align: center; box-sizing: border-box; }
.wb-lock { display: flex; align-items: center; gap: 16rpx; margin-bottom: 20rpx; padding: 20rpx 22rpx; border-radius: 20rpx; background: #FFFBEB; border: 2rpx solid #FCD34D; }
.wb-lock__t { flex: 1; font-size: 25rpx; font-weight: 600; color: #92400E; line-height: 1.5; }
.wb-lock__btn { flex: none; padding: 10rpx 22rpx; border-radius: 999rpx; background: #D97706; color: #FFFFFF; font-size: 24rpx; font-weight: 700; }
