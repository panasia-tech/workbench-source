.feedback-page .feedback-hero {
  background: linear-gradient(135deg, #eff6ff 0%, #ffffff 60%);
  border-color: #bfdbfe;
}

.feedback-page .feedback-hero__title {
  font-size: 36rpx;
  font-weight: 800;
  color: #1d4ed8;
  margin-bottom: 12rpx;
}

.feedback-page .feedback-hero__text {
  font-size: 26rpx;
  color: #475569;
  line-height: 1.7;
}

.feedback-page .feedback-pill-group {
  margin-bottom: 18rpx;
}

.feedback-page .feedback-pill {
  min-width: 172rpx;
  text-align: center;
}

.feedback-page .feedback-type-hint {
  font-size: 24rpx;
  color: #6b7280;
  line-height: 1.6;
}

.feedback-page .sample-head-tip {
  font-size: 22rpx;
  color: #94a3b8;
}

.feedback-page .sample-item {
  padding: 24rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 20rpx;
  background: #f8fafc;
  margin-bottom: 20rpx;
}

.feedback-page .sample-item:last-child {
  margin-bottom: 0;
}

.feedback-page .sample-item__head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 10rpx;
}

.feedback-page .sample-item__title {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 700;
  color: #0f172a;
}

.feedback-page .sample-item__action {
  flex-shrink: 0;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: #dbeafe;
  color: #1d4ed8;
  font-size: 22rpx;
  font-weight: 700;
}

.feedback-page .sample-item__target {
  font-size: 22rpx;
  font-weight: 700;
  color: #475569;
  margin-bottom: 10rpx;
}

.feedback-page .sample-item__content {
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.7;
}

.feedback-page .feedback-textarea {
  min-height: 240rpx;
}

.feedback-page .evidence-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 12rpx;
}

.feedback-page .evidence-item {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  overflow: hidden;
}

.feedback-page .evidence-del {
  position: absolute;
  top: 0;
  right: 0;
  width: 40rpx;
  height: 40rpx;
  line-height: 36rpx;
  text-align: center;
  font-size: 30rpx;
  color: #fff;
  background: rgba(0, 0, 0, 0.5);
  border-bottom-left-radius: 12rpx;
}

.feedback-page .evidence-add {
  width: 160rpx;
  height: 160rpx;
  border: 2rpx dashed #cbd5e1;
  border-radius: 12rpx;
  background: #f8fafc;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.feedback-page .evidence-add-plus {
  font-size: 48rpx;
  line-height: 1;
  color: #94a3b8;
  font-weight: 300;
}

.feedback-page .evidence-add-text {
  font-size: 22rpx;
  color: #94a3b8;
}

.feedback-page .feedback-submit {
  margin-top: 16rpx;
}
