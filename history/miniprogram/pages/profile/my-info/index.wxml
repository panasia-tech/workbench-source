<view class="page-wrap page-wrap--no-tab">
  <view class="card" wx:if="{{needGithub}}">
    <view class="card-head">GitHub</view>
    <view class="tip">填 GitHub 邮箱或用户名，保存后自动邀请你进公司代码仓库。邮箱在 GitHub 上没公开的话查不到，改填用户名。</view>
    <view class="form-group">
      <view class="input-wrap">
        <input
          class="input"
          maxlength="128"
          placeholder="邮箱或用户名"
          placeholder-class="input-ph"
          value="{{github}}"
          bindinput="onGithubInput"
        />
      </view>
    </view>
    <view class="tip" wx:if="{{githubStatus}}">{{githubStatus}}</view>
    <button class="btn btn-primary btn-block" loading="{{githubSaving}}" disabled="{{githubSaving}}" bindtap="onGithubSave">
      保存并邀请
    </button>
  </view>

  <view class="card">
    <view class="card-head">手机卡信息</view>
    <view class="tip">每张卡片含手机号 / ICCID / 空卡序列号，可绑定多张；每张至少填一项，留空的字段视为清除。</view>

    <view class="sim-card" wx:for="{{cards}}" wx:key="key" wx:for-item="card" wx:for-index="idx">
      <view class="sim-card__head">
        <text class="sim-card__title">卡片 {{idx + 1}}</text>
        <text class="sim-card__del" bindtap="onRemove" data-idx="{{idx}}">删除</text>
      </view>

      <view class="form-group">
        <text class="form-label">手机号</text>
        <view class="input-wrap">
          <input
            class="input"
            type="number"
            maxlength="11"
            placeholder="请输入 11 位手机号"
            placeholder-class="input-ph"
            data-idx="{{idx}}"
            data-key="phone"
            value="{{card.phone}}"
            bindinput="onInput"
          />
        </view>
      </view>

      <view class="form-group">
        <text class="form-label">ICCID</text>
        <view class="input-wrap">
          <input
            class="input"
            maxlength="50"
            placeholder="SIM 卡 ICCID，最长 50 位"
            placeholder-class="input-ph"
            data-idx="{{idx}}"
            data-key="iccid"
            value="{{card.iccid}}"
            bindinput="onInput"
          />
        </view>
      </view>

      <view class="form-group">
        <text class="form-label">空卡序列号</text>
        <view class="input-wrap search-input-wrap">
          <input
            class="input search-input--with-scan"
            maxlength="64"
            placeholder="可扫码回填，最长 64 位"
            placeholder-class="input-ph"
            data-idx="{{idx}}"
            data-key="blank_serial"
            value="{{card.blank_serial}}"
            bindinput="onInput"
          />
          <view class="search-scan-icon" catchtap="onScan" data-idx="{{idx}}">
            <view class="scan-frame"></view>
            <view class="scan-line"></view>
          </view>
        </view>
      </view>
    </view>

    <button class="btn btn-outline btn-block sim-add" bindtap="onAdd">+ 添加卡片</button>

    <button class="btn btn-primary btn-block" loading="{{submitting}}" disabled="{{submitting}}" bindtap="onSubmit">
      保存
    </button>
  </view>
</view>
