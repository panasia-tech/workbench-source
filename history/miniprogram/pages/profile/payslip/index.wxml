<wxs module="fmt" src="../../../utils/format.wxs" />

<view class="page-wrap page-wrap--no-tab payslip-page">
  <!-- 周期选择 -->
  <view class="card ps-period-card">
    <view class="ps-period-row">
      <block wx:for="{{periods}}" wx:key="key">
        <picker
          wx:if="{{item.key === 'pick'}}"
          mode="date"
          fields="month"
          value="{{pickMonth}}"
          bindchange="onMonthChange"
        >
          <view class="ps-period-pill {{period === 'pick' ? 'active' : ''}}">
            {{period === 'pick' ? pickMonth : item.label}}
          </view>
        </picker>
        <view
          wx:else
          class="ps-period-pill {{period === item.key ? 'active' : ''}}"
          data-period="{{item.key}}"
          bindtap="pickPeriod"
        >{{item.label}}</view>
      </block>
    </view>
    <view class="ps-range">{{dateFrom}} 至 {{dateTo}}</view>
  </view>

  <!-- 合计 -->
  <view class="card ps-total-card">
    <text class="ps-total-label">预计工资合计</text>
    <text class="ps-total-amt">¥{{fmt.money(payslip.total_commission || 0)}}</text>
  </view>

  <view wx:if="{{loading}}" class="ps-loading">加载中…</view>

  <view wx:if="{{!loading && (!payslip || !payslip.sections.length)}}" class="card">
    <view class="empty"><view class="e-icon">—</view><view class="e-text">本期暂无提成记录</view></view>
  </view>

  <!-- 各角色明细 -->
  <view class="card ps-section" wx:for="{{payslip.sections}}" wx:for-item="sec" wx:key="role">
    <view class="ps-sec-head">
      <text class="ps-sec-title">{{sec.title}}</text>
      <text class="ps-sec-total">¥{{fmt.money(sec.commission_total)}}</text>
    </view>
    <view class="ps-sec-note">{{sec.note}}</view>
    <view wx:if="{{sec.overdue_count}}" class="ps-sec-overdue">含 {{sec.overdue_count}} 笔逾期采购不计提成（¥0）</view>

    <view wx:if="{{!sec.items.length}}" class="ps-sec-empty">本期无记录</view>

    <view
      wx:for="{{sec.items}}"
      wx:for-item="item"
      wx:key="ref_no"
      class="ps-item {{item.is_overdue ? 'is-overdue' : ''}}"
    >
      <view class="ps-item-main">
        <view class="ps-item-title">{{item.product_name || item.ref_no}}</view>
        <view class="ps-item-sub">{{item.ref_no}}{{item.sku_code ? ' · ' + item.sku_code : ''}}</view>
        <view class="ps-item-sub">{{fmt.datetime(item.occurred_at)}}</view>
      </view>
      <view class="ps-item-amt">
        <text class="ps-amt {{item.is_overdue ? 'ps-amt--zero' : ''}}">¥{{fmt.money(item.commission)}}</text>
        <view wx:if="{{item.kind === 'purchase'}}" class="ps-item-margin">毛利 ¥{{fmt.money(item.base_amount)}}</view>
        <view wx:if="{{item.is_overdue}}" class="ps-badge">逾期·不发提成</view>
      </view>
    </view>
  </view>
</view>
