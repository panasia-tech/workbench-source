/* 一张虚拟产品卡：浅色，和实物详情同一套样子。红 = 现在动手，黄 = 注意 */
.vi-page .vi-card { margin-top: 20rpx; padding: 24rpx; border-radius: 24rpx; background: #FFFFFF; box-shadow: 0 2rpx 12rpx rgba(15, 23, 42, 0.06); }
.vi-page .vi-card__h { display: flex; flex-wrap: wrap; align-items: baseline; gap: 12rpx; margin-bottom: 12rpx; }
.vi-page .vi-card__t { font-size: 30rpx; font-weight: 800; color: #111827; }
.vi-page .vi-card__s { flex: 1; font-size: 22rpx; color: #9CA3AF; }
.vi-page .vi-muted { color: #9CA3AF; font-size: 22rpx; line-height: 1.6; }
.vi-page .vi-link { color: #2563EB; font-size: 24rpx; font-weight: 700; }
.vi-page .vi-b { font-weight: 800; color: #111827; }
.vi-page .vi-red { color: #B91C1C; }
.vi-page .vi-amb { color: #92400E; }
.vi-page .vi-q { width: 40rpx; height: 40rpx; line-height: 40rpx; text-align: center; border-radius: 50%; border: 1rpx solid #D1D5DB; color: #6B7280; font-size: 22rpx; margin-left: auto; }
.vi-page .vi-help { margin-top: 12rpx; padding: 14rpx 18rpx; border-radius: 12rpx; background: #F9FAFB; font-size: 24rpx; color: #4B5563; line-height: 1.6; }

.vi-page .vi-hero { padding: 24rpx; border-radius: 28rpx; background: #FFFFFF; box-shadow: 0 2rpx 12rpx rgba(15, 23, 42, 0.06); }
.vi-page .vi-tags { display: flex; flex-wrap: wrap; align-items: center; gap: 10rpx; }
.vi-page .vi-badge { padding: 6rpx 20rpx; border-radius: 999rpx; font-size: 24rpx; font-weight: 800; color: #FFFFFF; }
.vi-page .vi-badge--red { background: #DC2626; }
.vi-page .vi-badge--yellow { background: #F59E0B; color: #3B2600; }
.vi-page .vi-badge--green { background: #059669; }
.vi-page .vi-tag { padding: 4rpx 14rpx; border-radius: 10rpx; font-size: 22rpx; font-weight: 600; background: #F3F4F6; color: #374151; }
.vi-page .vi-tag--dark { background: #111827; color: #FFFFFF; }
.vi-page .vi-tag--passed { background: #D1FAE5; color: #065F46; }
.vi-page .vi-tag--rejected { background: #FEE2E2; color: #B91C1C; }
.vi-page .vi-tag--pending { background: #FEF3C7; color: #92400E; }
.vi-page .vi-name { margin-top: 14rpx; font-size: 38rpx; font-weight: 800; color: #111827; line-height: 1.3; }
.vi-page .vi-codes { margin-top: 8rpx; font-size: 24rpx; color: #6B7280; }

.vi-page .vi-issues { margin-top: 20rpx; padding: 20rpx 22rpx; border-radius: 20rpx; border-left: 10rpx solid #059669; background: #ECFDF5; }
.vi-page .vi-issues--red { border-left-color: #DC2626; background: #FEF2F2; }
.vi-page .vi-issues--yellow { border-left-color: #F59E0B; background: #FFFBEB; }
.vi-page .vi-issues__t { font-size: 28rpx; font-weight: 800; color: #111827; }
.vi-page .vi-issue { display: flex; align-items: center; gap: 12rpx; padding: 14rpx 0 4rpx; }
.vi-page .vi-issue__text { flex: 1; min-width: 0; font-size: 25rpx; color: #1F2937; line-height: 1.5; }
.vi-page .vi-dot { display: inline-block; flex: none; width: 14rpx; height: 14rpx; border-radius: 50%; margin-right: 6rpx; }
.vi-page .vi-dot--red { background: #DC2626; }
.vi-page .vi-dot--yellow { background: #F59E0B; }
.vi-page .vi-dot--grn { background: #059669; }
.vi-page .vi-dot--acc { background: #2563EB; }
.vi-page .vi-ok { margin-top: 8rpx; font-size: 24rpx; color: #065F46; }
.vi-page .vi-facts { display: grid; grid-template-columns: repeat(auto-fill, minmax(190rpx, 1fr)); gap: 12rpx; margin-top: 18rpx; }
.vi-page .vi-fact { padding: 16rpx 18rpx; border-radius: 16rpx; background: #F9FAFB; border: 1rpx solid #F3F4F6; }
.vi-page .vi-fact__k { font-size: 22rpx; color: #6B7280; }
.vi-page .vi-fact__v { margin-top: 4rpx; font-size: 34rpx; font-weight: 800; color: #111827; }
.vi-page .vi-fact__s { margin-top: 4rpx; font-size: 20rpx; color: #9CA3AF; }

/* 8 步 */
.vi-page .vi-steps-wrap { width: 100%; white-space: nowrap; }
.vi-page .vi-steps { position: relative; display: flex; min-width: 900rpx; margin: 16rpx 0 6rpx; }
.vi-page .vi-steps::before { content: ''; position: absolute; left: 6%; right: 6%; top: 26rpx; height: 3rpx; background: #E5E7EB; }
.vi-page .vi-st { position: relative; flex: 1; display: flex; flex-direction: column; align-items: center; gap: 8rpx; }
.vi-page .vi-st__i { width: 52rpx; height: 52rpx; line-height: 52rpx; text-align: center; border-radius: 50%; font-size: 24rpx; font-weight: 800; background: #F3F4F6; color: #9CA3AF; border: 3rpx solid #E5E7EB; box-sizing: border-box; }
.vi-page .vi-st__t { font-size: 21rpx; font-weight: 600; color: #9CA3AF; text-align: center; white-space: normal; padding: 0 4rpx; }
.vi-page .vi-st--done .vi-st__i { background: #059669; border-color: #059669; color: #FFFFFF; }
.vi-page .vi-st--done .vi-st__t { color: #059669; }
.vi-page .vi-st--cur .vi-st__i { background: #2563EB; border-color: #2563EB; color: #FFFFFF; box-shadow: 0 0 0 8rpx rgba(37, 99, 235, 0.15); }
.vi-page .vi-st--cur .vi-st__t { color: #2563EB; }
.vi-page .vi-st--skip .vi-st__i { border-style: dashed; background: #FFFFFF; }
.vi-page .vi-st.is-sel .vi-st__t { text-decoration: underline; text-underline-offset: 6rpx; }
.vi-page .vi-pn { margin-top: 18rpx; padding: 22rpx; border-radius: 20rpx; background: #F9FAFB; }
.vi-page .vi-pn__t { font-size: 30rpx; font-weight: 800; color: #111827; }
.vi-page .vi-pn__n { margin-top: 8rpx; font-size: 24rpx; color: #4B5563; line-height: 1.6; }
.vi-page .vi-skip, .vi-page .vi-done, .vi-page .vi-wait { margin-left: 12rpx; padding: 2rpx 12rpx; border-radius: 999rpx; font-size: 20rpx; font-weight: 700; }
.vi-page .vi-skip { background: #F3F4F6; color: #6B7280; }
.vi-page .vi-done { background: #D1FAE5; color: #065F46; }
.vi-page .vi-wait { background: #FEF3C7; color: #92400E; }
.vi-page .vi-reject { margin-top: 12rpx; padding: 12rpx 16rpx; border-radius: 12rpx; background: #FEF2F2; color: #B91C1C; font-size: 24rpx; }
.vi-page .vi-lock { margin-top: 14rpx; font-size: 24rpx; color: #92400E; }
.vi-page .vi-field { margin-top: 14rpx; flex: 1; min-width: 0; }
.vi-page .vi-field__k { font-size: 23rpx; font-weight: 700; color: #374151; margin-bottom: 6rpx; }
.vi-page .vi-ta { width: 100%; box-sizing: border-box; min-height: 80rpx; padding: 14rpx 18rpx; border-radius: 14rpx; border: 1rpx solid #E5E7EB; background: #FFFFFF; font-size: 25rpx; line-height: 1.5; }
.vi-page .vi-ta--codes { min-height: 200rpx; margin-top: 14rpx; font-family: monospace; }
.vi-page .vi-in { padding: 14rpx 18rpx; border-radius: 14rpx; border: 1rpx solid #E5E7EB; background: #FFFFFF; font-size: 25rpx; min-height: 40rpx; }
.vi-page .vi-pick { color: #374151; margin-top: 12rpx; }
.vi-page .vi-row3 { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 12rpx; }
.vi-page .vi-row3 > .vi-in, .vi-page .vi-row3 > picker { flex: 1; min-width: 200rpx; }
.vi-page .vi-imgs { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 8rpx; }
.vi-page .vi-img { position: relative; width: 120rpx; height: 120rpx; border-radius: 12rpx; overflow: hidden; background: #F3F4F6; }
.vi-page .vi-img image { width: 100%; height: 100%; }
.vi-page .vi-img--add { line-height: 120rpx; text-align: center; font-size: 44rpx; color: #9CA3AF; border: 2rpx dashed #D1D5DB; box-sizing: border-box; }
.vi-page .vi-img__x { position: absolute; right: 0; top: 0; width: 36rpx; height: 36rpx; line-height: 34rpx; text-align: center; background: rgba(17, 24, 39, 0.6); color: #FFFFFF; font-size: 26rpx; }
.vi-page .vi-ev { margin-top: 16rpx; padding-top: 14rpx; border-top: 1rpx dashed #E5E7EB; }
.vi-page .vi-ev__h { font-size: 22rpx; color: #6B7280; font-weight: 700; }
.vi-page .vi-ev__r { margin-top: 6rpx; font-size: 24rpx; color: #1F2937; line-height: 1.55; }
.vi-page .vi-ev__k { color: #6B7280; margin-right: 12rpx; }

.vi-page .vi-btn { display: inline-block; margin-top: 16rpx; padding: 14rpx 30rpx; border-radius: 14rpx; background: #2563EB; color: #FFFFFF; font-size: 26rpx; font-weight: 700; text-align: center; }
.vi-page .vi-btn--ok { background: #059669; }
.vi-page .vi-btn--plain { background: #FFFFFF; color: #374151; border: 1rpx solid #D1D5DB; }
.vi-page .vi-btn--off { background: #E5E7EB; color: #6B7280; }
.vi-page .vi-btn--sm { margin-top: 0; padding: 10rpx 20rpx; font-size: 23rpx; }
.vi-page .vi-acts { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 14rpx; }

/* 订单 */
.vi-page .vi-banner { margin: 6rpx 0 10rpx; padding: 12rpx 16rpx; border-radius: 12rpx; background: #F3F4F6; color: #374151; font-size: 23rpx; }
.vi-page .vi-banner--grn { background: #ECFDF5; color: #065F46; }
.vi-page .vi-banner--amb { background: #FFFBEB; color: #92400E; }
.vi-page .vi-empty { padding: 20rpx 0; }
.vi-page .vi-order { margin-top: 14rpx; padding: 18rpx 20rpx; border-radius: 16rpx; background: #F9FAFB; border-left: 8rpx solid #D1D5DB; }
.vi-page .vi-order--red { border-left-color: #DC2626; background: #FEF2F2; }
.vi-page .vi-order--ready, .vi-page .vi-order--held, .vi-page .vi-order--waiting, .vi-page .vi-order--refund { border-left-color: #F59E0B; }
.vi-page .vi-order--sent, .vi-page .vi-order--done { border-left-color: #059669; }
.vi-page .vi-order__h { display: flex; flex-wrap: wrap; align-items: center; gap: 12rpx; }
.vi-page .vi-order__b { font-size: 27rpx; font-weight: 800; color: #111827; }
.vi-page .vi-order__n { margin-top: 6rpx; font-size: 23rpx; line-height: 1.5; }
.vi-page .vi-stag { padding: 2rpx 12rpx; border-radius: 999rpx; font-size: 21rpx; font-weight: 700; background: #F3F4F6; color: #374151; }
.vi-page .vi-stag--red { background: #FEE2E2; color: #B91C1C; }
.vi-page .vi-stag--ready, .vi-page .vi-stag--held, .vi-page .vi-stag--waiting, .vi-page .vi-stag--refund { background: #FEF3C7; color: #92400E; }
.vi-page .vi-stag--sent, .vi-page .vi-stag--done { background: #D1FAE5; color: #065F46; }
.vi-page .vi-code { margin-top: 10rpx; padding: 12rpx 16rpx; border-radius: 12rpx; background: #FFFFFF; border: 1rpx dashed #9CA3AF; font-family: monospace; font-size: 26rpx; color: #111827; word-break: break-all; }
.vi-page .vi-foot { margin-top: 16rpx; }

/* 库存、算账、设置 */
.vi-page .vi-legend { display: flex; flex-wrap: wrap; gap: 20rpx; font-size: 24rpx; color: #374151; }
.vi-page .vi-tbl { margin-top: 18rpx; border-top: 1rpx solid #F3F4F6; }
.vi-page .vi-tr { display: grid; grid-template-columns: 1.6fr 1.2fr 1fr 0.8fr 0.8fr 1.2fr; gap: 8rpx; padding: 12rpx 0; border-bottom: 1rpx solid #F3F4F6; font-size: 22rpx; color: #374151; }
.vi-page .vi-th { color: #9CA3AF; font-weight: 700; }
.vi-page .vi-kv { display: grid; grid-template-columns: 1fr auto; row-gap: 10rpx; font-size: 25rpx; color: #374151; }
.vi-page .vi-sw { display: flex; justify-content: space-between; align-items: center; gap: 16rpx; padding: 18rpx 0; border-top: 1rpx solid #F3F4F6; font-size: 25rpx; color: #1F2937; }
.vi-page .vi-sub { margin-top: 20rpx; padding-top: 18rpx; border-top: 1rpx solid #E5E7EB; font-size: 27rpx; font-weight: 800; color: #111827; }
