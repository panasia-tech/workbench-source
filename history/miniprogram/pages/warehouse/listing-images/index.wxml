<view class="page-wrap page-wrap--no-tab lim-page {{current && editable && tab === 'account' ? 'lim-page--bar' : ''}}">
  <view wx:if="{{loading}}" class="empty"><view class="e-text">加载中…</view></view>
  <block wx:elif="{{res}}">
    <!-- 商品 -->
    <view class="card lim-sku">
      <image wx:if="{{res.common.length}}" class="lim-sku-img" src="{{res.common[0].thumb}}" mode="aspectFill" />
      <view wx:else class="lim-sku-img lim-sku-img--none">无图</view>
      <view class="lim-sku-body">
        <view class="lim-sku-name">{{res.product_name}}</view>
        <view class="lim-sku-sub">货号：{{res.sku_code}} | 库位：{{res.location_code || '未分配'}}</view>
      </view>
      <view class="lim-back" bindtap="goBack">返回商品</view>
    </view>

    <view class="lim-tabs {{res.rejected.length ? 'lim-tabs--4' : ''}}">
      <view class="lim-tab {{tab === 'account' ? 'lim-tab--on' : ''}}" data-tab="account" bindtap="switchTab">按账号查看</view>
      <view class="lim-tab {{tab === 'library' ? 'lim-tab--on' : ''}}" data-tab="library" bindtap="switchTab">全部图片（{{res.library.length}}）</view>
      <view class="lim-tab {{tab === 'crawled' ? 'lim-tab--on' : ''}}" data-tab="crawled" bindtap="switchTab">同款图（{{res.crawled.length}}）</view>
      <view wx:if="{{res.rejected.length}}" class="lim-tab {{tab === 'rejected' ? 'lim-tab--on' : ''}}" data-tab="rejected" bindtap="switchTab">淘汰（{{res.rejected.length}}）</view>
    </view>

    <view wx:if="{{res.readonly_reason}}" class="lim-note">{{res.readonly_reason}}</view>

    <!-- 按账号查看 -->
    <block wx:if="{{tab === 'account'}}">
      <view wx:if="{{!accounts.length}}" class="card empty">
        <view class="e-text">这件货还没上过任何号。上架时给每个号选图，选好的图会出现在这里。</view>
      </view>
      <block wx:else>
        <scroll-view scroll-x enable-flex class="lim-chips">
          <view class="lim-chip {{shopId === '' ? 'lim-chip--on' : ''}}" data-id="" bindtap="pickAccount">
            <view class="lim-chip-name">全部</view>
            <view class="lim-chip-sub">{{accounts.length}} 个账号</view>
          </view>
          <view wx:for="{{accounts}}" wx:key="shop_id" class="lim-chip {{shopId === item.shop_id ? 'lim-chip--on' : ''}}" data-id="{{item.shop_id}}" bindtap="pickAccount">
            <view class="lim-chip-name">{{item.shop_label}}</view>
            <view class="lim-chip-sub">{{item.statusLabel}} · {{item.images.length}} 张</view>
            <view wx:if="{{shopId === item.shop_id}}" class="lim-chip-check">✓</view>
          </view>
        </scroll-view>

        <!-- 全部账号：一号一行 -->
        <view wx:if="{{!current}}" class="card">
          <view wx:for="{{accounts}}" wx:key="shop_id" class="lim-acc" data-id="{{item.shop_id}}" bindtap="pickAccount">
            <view class="lim-acc-head">
              <text class="lim-acc-name">{{item.shop_label}}</text>
              <text class="lim-tag {{item.live ? 'lim-tag--live' : ''}}">{{item.statusLabel}}</text>
              <text class="lim-tag">{{item.own ? '单独选的' : '公用图'}}</text>
              <text class="lim-acc-n">{{item.images.length}} 张 ›</text>
            </view>
            <view class="lim-acc-strip">
              <image wx:for="{{item.images}}" wx:for-item="img" wx:for-index="i" wx:key="url" wx:if="{{i < 6}}" class="lim-acc-img" src="{{img.thumb}}" mode="aspectFill" />
              <text wx:if="{{!item.images.length}}" class="lim-muted">没有图</text>
            </view>
            <view wx:if="{{item.shares_with.length}}" class="lim-warn">和「{{item.sharesText}}」用的同一组公用图</view>
          </view>
        </view>

        <!-- 单个账号 -->
        <view wx:else class="card">
          <view class="lim-sec-head">
            <text class="lim-sec-title">账号：{{current.shop_label}} · {{current.own ? '单独选的' : '用公用图'}} {{grid.length}} 张</text>
            <text wx:if="{{editable && current.own && !sorting}}" class="lim-link" bindtap="backToShared">改回公用图</text>
          </view>
          <view wx:if="{{current.shares_with.length}}" class="lim-warn">和「{{current.sharesText}}」用的同一组公用图，闲鱼上这几条链接图一样。给这个号换一组自己的图就分开了。</view>
          <view wx:if="{{sorting}}" class="lim-hint">按想要的顺序依次点图，第一张是主图；没点到的排在后面。</view>
          <view wx:elif="{{editable && !grid.length}}" class="lim-hint">没有图，点下面「上传图片」或「加图」。</view>
          <view class="lim-grid">
            <view wx:for="{{grid}}" wx:key="url" class="lim-cell {{selected[item.url] ? 'lim-cell--on' : ''}}" data-index="{{index}}" bindtap="tapImage" bindlongpress="preview" data-list="grid">
              <image class="lim-img" src="{{item.thumb}}" mode="aspectFill" />
              <view class="lim-badge">{{index === 0 ? '1 主图' : item.order}}</view>
              <view wx:if="{{item.rejected}}" class="lim-used lim-used--bad">已淘汰·{{item.rejected}}</view>
              <view wx:if="{{sorting && item.sortNo}}" class="lim-sortno">{{item.sortNo}}</view>
              <view wx:if="{{selected[item.url]}}" class="lim-tick">✓</view>
            </view>
          </view>
          <view wx:if="{{editable && grid.length && !sorting}}" class="lim-muted lim-tip">点图勾选，长按看大图</view>
        </view>
      </block>
    </block>

    <!-- 全部图片 -->
    <view wx:if="{{tab === 'library'}}" class="card">
      <view class="lim-hint">这件货的实拍图、上架图和给各号上传的图。底下写着哪个号在用。{{res.can_edit ? '不能用的点开淘汰。' : ''}}</view>
      <view class="lim-grid">
        <view wx:for="{{res.library}}" wx:key="url" class="lim-cell" data-list="library" data-index="{{index}}" bindtap="tapMaterial">
          <image class="lim-img" src="{{item.thumb}}" mode="aspectFill" />
          <view class="lim-badge">{{item.kindText}}</view>
          <view class="lim-used {{item.usedText ? '' : 'lim-used--free'}}">{{item.usedText || '没号在用'}}</view>
        </view>
      </view>
      <view wx:if="{{!res.library.length}}" class="lim-muted">还没有图</view>
    </view>

    <!-- 同款图（图片爬虫按型号搜的） -->
    <view wx:if="{{tab === 'crawled'}}" class="card">
      <view class="lim-hint">图片爬虫按型号搜的同款图{{res.crawl_status ? '（' + res.crawl_status + '）' : ''}}。红角标的不会自动用，不能用的点开淘汰。</view>
      <view class="lim-grid">
        <view wx:for="{{res.crawled}}" wx:key="url" class="lim-cell" data-list="crawled" data-index="{{index}}" bindtap="tapMaterial">
          <image class="lim-img" src="{{item.thumb}}" mode="aspectFill" />
          <view wx:if="{{item.status === 'review'}}" class="lim-badge lim-badge--bad">{{item.kindText}}</view>
          <view class="lim-used {{item.usedText ? '' : 'lim-used--free'}}">{{item.usedText || '没号在用'}}</view>
        </view>
      </view>
      <view wx:if="{{!res.crawled.length}}" class="lim-muted">{{res.crawl_status ? '没有能用的同款图' : '还没搜过这款的图，去店铺上架时会自动让爬虫搜'}}</view>
    </view>

    <!-- 淘汰的图：不再当候选，点开可以放回 -->
    <view wx:if="{{tab === 'rejected'}}" class="card">
      <view class="lim-hint">挑图、加图时都看不到这些了。{{res.can_edit ? '淘汰错了点开放回。' : ''}}</view>
      <view class="lim-grid">
        <view wx:for="{{res.rejected}}" wx:key="url" class="lim-cell" data-list="rejected" data-index="{{index}}" bindtap="tapMaterial">
          <image class="lim-img lim-img--gone" src="{{item.thumb}}" mode="aspectFill" />
          <view class="lim-badge lim-badge--bad">{{item.reason}}</view>
          <view wx:if="{{item.usedText}}" class="lim-used lim-used--bad">{{item.usedText}} 还在用</view>
        </view>
      </view>
    </view>
  </block>

  <!-- 底部操作：只在单个账号、能改的时候出现 -->
  <view wx:if="{{current && editable && tab === 'account'}}" class="lim-bar">
    <block wx:if="{{sorting}}">
      <view class="lim-bar-btn" bindtap="cancelSort"><text>取消</text></view>
      <view class="lim-bar-btn lim-bar-btn--pri" bindtap="finishSort"><text>完成排序</text></view>
    </block>
    <block wx:else>
      <view class="lim-bar-all" bindtap="toggleAll">
        <view class="lim-box {{grid.length && selectedCount === grid.length ? 'lim-box--on' : ''}}">{{grid.length && selectedCount === grid.length ? '✓' : ''}}</view>
        <text>全选</text>
      </view>
      <view class="lim-bar-btn" bindtap="upload"><text>上传图片</text></view>
      <view class="lim-bar-btn" bindtap="openSheet"><text>加图</text></view>
      <view class="lim-bar-btn" bindtap="startSort"><text>排序</text></view>
      <view class="lim-bar-btn" bindtap="setMain"><text>设为主图</text></view>
      <view class="lim-bar-btn lim-bar-btn--danger" bindtap="removeSelected"><text>拿掉</text></view>
    </block>
  </view>

  <!-- 加图：从这件货的图和同款图里挑 -->
  <view wx:if="{{sheet}}" class="lim-mask" bindtap="closeSheet" catchtouchmove="noop">
    <view class="lim-sheet" catchtap="noop">
      <view class="lim-sheet-title">给「{{current.shop_label}}」加图</view>
      <view class="lim-hint">灰掉的已经给别的号用了，各号的图不能重复。</view>
      <scroll-view scroll-y class="lim-sheet-body">
        <view class="lim-grid">
          <view wx:for="{{sheetItems}}" wx:key="url" class="lim-cell {{sheetPicked[item.url] ? 'lim-cell--on' : ''}} {{item.takenBy ? 'lim-cell--taken' : ''}}" data-index="{{index}}" bindtap="tapSheetItem">
            <image class="lim-img" src="{{item.thumb}}" mode="aspectFill" />
            <view class="lim-badge">{{item.kind}}</view>
            <view wx:if="{{item.takenBy}}" class="lim-used">{{item.takenBy}}</view>
            <view wx:if="{{sheetPicked[item.url]}}" class="lim-tick">✓</view>
          </view>
        </view>
      </scroll-view>
      <view class="lim-sheet-actions">
        <view class="lim-bar-btn" bindtap="closeSheet"><text>取消</text></view>
        <view class="lim-bar-btn lim-bar-btn--pri" bindtap="confirmSheet"><text>加 {{sheetCount}} 张</text></view>
      </view>
    </view>
  </view>
</view>
