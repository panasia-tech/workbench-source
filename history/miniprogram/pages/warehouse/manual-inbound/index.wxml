<view class="page-wrap page-wrap--no-tab sku-edit-page">
  <view class="card">
    <view class="card-head">手动入库</view>
    <view class="form-note">用于把旧系统的货迁移进来；直接生成在库商品，免议价、可直接上架</view>

    <view class="form-group">
      <text class="form-label">货号<text class="label-hint"> 选填 · 留空自动生成</text></text>
      <view class="sku-edit-scan-wrap">
        <input class="form-input sku-edit-scan-input" value="{{form.sku_code}}" data-field="sku_code" bindinput="onInput" placeholder="扫码或手填旧系统货号" />
        <view class="sku-edit-scan-icon" catchtap="scanSkuCode">
          <view class="scan-frame"></view>
          <view class="scan-line"></view>
        </view>
      </view>
    </view>

    <view class="form-group">
      <text class="form-label">商品名称<text class="req">*</text></text>
      <input class="form-input" value="{{form.product_name}}" data-field="product_name" bindinput="onInput" placeholder="留空则用「品牌 型号」自动拼" />
    </view>

    <view class="form-group">
      <text class="form-label">品牌</text>
      <input class="form-input" value="{{form.brand}}" data-field="brand" bindinput="onInput" placeholder="品牌（选填）" />
    </view>

    <view class="form-group">
      <text class="form-label">型号</text>
      <input class="form-input" value="{{form.model}}" data-field="model" bindinput="onInput" placeholder="型号（选填）" />
    </view>

    <view class="form-group">
      <text class="form-label">规格</text>
      <input class="form-input" value="{{form.spec}}" data-field="spec" bindinput="onInput" placeholder="规格（选填）" />
    </view>

    <view class="form-group">
      <text class="form-label">序列号<text class="req">*</text></text>
      <view class="sku-edit-scan-wrap">
        <input class="form-input sku-edit-scan-input" value="{{form.serial_number}}" data-field="serial_number" bindinput="onInput" placeholder="扫码或手填序列号" />
        <view class="sku-edit-scan-icon" catchtap="scanSerial">
          <view class="scan-frame"></view>
          <view class="scan-line"></view>
        </view>
      </view>
    </view>

    <view class="form-group">
      <text class="form-label">69码<text class="label-hint"> 选填</text></text>
      <view class="sku-edit-scan-wrap">
        <input class="form-input sku-edit-scan-input" value="{{form.barcode}}" data-field="barcode" bindinput="onInput" placeholder="扫码或手填69码" />
        <view class="sku-edit-scan-icon" catchtap="scanBarcode69">
          <view class="scan-frame"></view>
          <view class="scan-line"></view>
        </view>
      </view>
    </view>

    <view class="form-group">
      <text class="form-label">库位<text class="req">*</text></text>
      <picker mode="selector" range="{{locations}}" range-key="label" value="{{locationIndex}}" bindchange="pickLocation">
        <view class="form-input sku-edit-picker">{{form.location_code || '选择库位'}}</view>
      </picker>
    </view>

    <view class="form-group">
      <text class="form-label">成色<text class="req">*</text></text>
      <picker mode="selector" range="{{grades}}" value="{{gradeIndex}}" bindchange="pickGrade">
        <view class="form-input sku-edit-picker">{{form.condition_grade || '选择成色'}}</view>
      </picker>
    </view>

    <view class="form-group">
      <text class="form-label">商品类型<text class="req">*</text></text>
      <picker mode="selector" range="{{productTypes}}" value="{{productTypeIndex}}" bindchange="pickProductType">
        <view class="form-input sku-edit-picker">{{form.product_type || '选择商品类型'}}</view>
      </picker>
    </view>

    <view class="form-group">
      <text class="form-label">成本价<text class="req">*</text></text>
      <input class="form-input" type="digit" value="{{form.cost_price}}" bindinput="onCostInput" placeholder="旧系统成本，未知可填 0" />
    </view>

    <view class="form-group">
      <text class="form-label">入库时间<text class="label-hint"> 选填 · 默认今天</text></text>
      <picker mode="date" value="{{inboundDate}}" bindchange="onInboundDate">
        <view class="form-input sku-edit-picker">{{inboundDate || '选择旧系统原始入库日期'}}</view>
      </picker>
    </view>

    <view class="form-group">
      <text class="form-label">备注</text>
      <input class="form-input" value="{{form.remark}}" data-field="remark" bindinput="onInput" placeholder="选填" />
    </view>
  </view>

  <view class="card">
    <view class="card-head">商品图 / 视频<text class="req">*</text></view>
    <view class="form-note">用于上架和客户展示，第一张图作为封面；支持图片和视频</view>
    <view class="sku-edit-grid" wx:if="{{form.images.length}}">
      <view class="sku-edit-thumb" wx:for="{{form.images}}" wx:key="*this">
        <media-thumb url="{{imageDisplay[index] || item}}" size="fill" preview="{{true}}" />
        <view class="sku-edit-thumb__del" data-type="product" data-index="{{index}}" catchtap="removeImage">×</view>
      </view>
    </view>
    <view class="upload-zone upload-zone--compact" data-type="product" bindtap="addImage">
      <view class="uz-plus">+</view>
      <view class="uz-text">添加图片 / 视频</view>
    </view>
  </view>

  <view class="card">
    <view class="card-head">仓库定位图 / 视频</view>
    <view class="form-note">用于找货、盘点定位，不会展示给客户（选填）</view>
    <view class="sku-edit-grid" wx:if="{{form.location_images.length}}">
      <view class="sku-edit-thumb" wx:for="{{form.location_images}}" wx:key="*this">
        <media-thumb url="{{locationImageDisplay[index] || item}}" size="fill" preview="{{true}}" />
        <view class="sku-edit-thumb__del" data-type="location" data-index="{{index}}" catchtap="removeImage">×</view>
      </view>
    </view>
    <view class="upload-zone upload-zone--compact" data-type="location" bindtap="addImage">
      <view class="uz-plus">+</view>
      <view class="uz-text">添加定位图 / 视频</view>
    </view>
  </view>

  <button class="btn-primary btn-block sku-edit-save" loading="{{submitting}}" bindtap="submit">确认入库</button>
</view>
