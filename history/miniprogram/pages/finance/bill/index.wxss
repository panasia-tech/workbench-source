.bill-page {
  padding-bottom: 40rpx;
}

.bill-periods {
  margin-top: 8rpx;
}

.bill-custom {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 20rpx;
}

.date-box {
  padding: 14rpx 20rpx;
  background: #F3F4F6;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #1F2937;
  font-weight: 600;
}

.date-sep {
  font-size: 24rpx;
  color: #9CA3AF;
}

.bill-range {
  margin-top: 18rpx;
  font-size: 22rpx;
  color: #9CA3AF;
  font-weight: 600;
}

/* 毛利主数字卡（最大） */
.profit-card {
  background: linear-gradient(135deg, #059669 0%, #047857 100%);
  border-radius: 24rpx;
  padding: 44rpx 36rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(5, 150, 105, 0.28);
}

.profit-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.profit-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #FFFFFF;
}

.profit-tag {
  font-size: 22rpx;
  font-weight: 700;
  color: #ECFDF5;
  padding: 6rpx 18rpx;
  background: rgba(255, 255, 255, 0.18);
  border-radius: 999rpx;
}

.profit-amt {
  font-size: 104rpx;
  font-weight: 900;
  color: #FFFFFF;
  letter-spacing: -3rpx;
  line-height: 1.05;
  margin: 10rpx 0 14rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profit-foot {
  font-size: 23rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.85);
}

/* 净利润卡（中号·强调） */
.net-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #FFFFFF;
  border: 2rpx solid #059669;
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 28rpx;
}

.net-label {
  font-size: 30rpx;
  font-weight: 800;
  color: #047857;
}

.net-sub {
  margin-top: 6rpx;
  font-size: 21rpx;
  color: #9CA3AF;
}

.net-amt {
  font-size: 52rpx;
  font-weight: 900;
  color: #047857;
  letter-spacing: -1rpx;
}

.net-amt--neg {
  color: #DC2626;
}

/* 逐笔明细 */
.bill-detail-tabs {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.detail-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 27rpx;
  font-weight: 700;
  color: #6B7280;
  background: #F3F4F6;
  border-radius: 12rpx;
}

.detail-tab.active {
  color: #FFFFFF;
  background: #2563EB;
}

.detail-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 4rpx;
  border-bottom: 1rpx solid #F0F1F3;
}

.detail-row:last-child {
  border-bottom: none;
}

.detail-main {
  flex: 1;
  min-width: 0;
  margin-right: 16rpx;
}

.detail-title {
  font-size: 27rpx;
  font-weight: 700;
  color: #1F2937;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.detail-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #9CA3AF;
}

.detail-amt {
  font-size: 30rpx;
  font-weight: 800;
  white-space: nowrap;
}

.detail-amt--in {
  color: #059669;
}

.detail-amt--out {
  color: #DC2626;
}

.detail-empty {
  text-align: center;
  padding: 36rpx 0;
  font-size: 24rpx;
  color: #9CA3AF;
}

.bill-loading {
  text-align: center;
  padding: 24rpx 0;
  font-size: 24rpx;
  color: #9CA3AF;
}
