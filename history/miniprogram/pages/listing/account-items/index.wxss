.page { padding: 20rpx; }
.hint { text-align: center; color: #999; padding: 80rpx 0; }

.ai-head { padding: 24rpx; }
.ai-nick { font-size: 32rpx; font-weight: 600; }
.ai-meta { font-size: 24rpx; color: #888; margin-top: 8rpx; }
.ai-tabs { white-space: nowrap; margin-top: 18rpx; }
.ai-tab {
  display: inline-block; padding: 10rpx 24rpx; margin-right: 12rpx; border-radius: 999rpx;
  font-size: 26rpx; background: #f0f1f3; color: #555;
}
.ai-tab--on { background: #1565C0; color: #fff; }

.ai-item { border-bottom: 1rpx solid #f0f0f0; }
.ai-item:last-child { border-bottom: none; }
.ai-row { display: flex; align-items: center; gap: 18rpx; padding: 20rpx 4rpx; }
.ai-thumb {
  width: 96rpx; height: 96rpx; border-radius: 12rpx; background: #f0f1f3; color: #999;
  display: flex; align-items: center; justify-content: center; font-size: 26rpx; flex-shrink: 0;
}
.ai-main { flex: 1; min-width: 0; }
.ai-title { font-size: 28rpx; color: #222; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.ai-sub { font-size: 24rpx; color: #888; margin-top: 6rpx; }
.ai-price { color: #d32f2f; margin-right: 16rpx; }

.ai-detail { padding: 0 4rpx 24rpx; }
.ai-err { font-size: 24rpx; color: #d32f2f; margin-bottom: 12rpx; }
.ai-k { font-size: 24rpx; color: #999; margin-top: 12rpx; }
.ai-v { font-size: 26rpx; color: #333; margin-top: 4rpx; word-break: break-all; }
.ai-desc { white-space: pre-wrap; }
.ai-detail .btn { margin-top: 20rpx; }
