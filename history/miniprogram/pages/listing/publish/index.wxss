/* 店铺多选样式见 app.wxss */

/* 页面布局:整页固定一屏高,店铺列表区内部滚动,底部按钮常驻可见 */
.dl-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.dl-card {
  flex: 1;
  min-height: 0;
  margin-bottom: 0;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

/* 店铺列表:占满剩余空间并内部滚动 */
.dl-shops {
  flex: 1;
  min-height: 0;
  margin-top: 8rpx;
}

.dl-submit {
  flex-shrink: 0;
  margin-top: 32rpx;
}

/* 上排 tab:只管列表里看哪些(单选),样式同设备看板的类型筛选 */
.dl-tabs {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.dl-tab {
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  white-space: nowrap;
  color: var(--text-secondary);
  background: var(--bg-neutral);
  border: 1rpx solid var(--border);
}

.dl-tab--on {
  color: #fff;
  background: var(--color-primary);
  border-color: var(--color-primary);
  font-weight: 600;
}

/* 下排勾选框:只管选哪些,与店铺行同一种勾选框 */
.dl-picks {
  display: flex;
  align-items: center;
  gap: 36rpx;
  margin: 24rpx 0 8rpx;
}

.dl-pick {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 26rpx;
  color: var(--text-primary);
}

.dl-picks .dl-meta {
  margin-left: auto;
}

/* 选了一部分:浅底 + 一道横线 */
.dl-check--partial {
  background: var(--color-primary-bg);
  border-color: var(--color-primary);
}

.dl-check-dash {
  color: var(--color-primary);
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1;
}

.dl-kind-empty {
  padding: 48rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: var(--text-muted);
}

/* AI 主图待确认 */
.ai-confirm {
  margin-top: 20rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  background: #fff8e6;
  border: 1rpx solid #ffd591;
}
.ai-confirm-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #ad6800;
}
.ai-confirm-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8c6d1f;
}
.ai-confirm-img {
  display: block;
  width: 100%;
  height: 420rpx;
  margin-top: 16rpx;
  border-radius: 12rpx;
  background: #fff;
}
.ai-confirm-input {
  margin-top: 16rpx;
  padding: 0 20rpx;
  height: 72rpx;
  border-radius: 12rpx;
  background: #fff;
  border: 1rpx solid #e8e8e8;
  font-size: 26rpx;
}
.ai-confirm-actions {
  display: flex;
  margin-top: 16rpx;
}
.ai-confirm-actions .btn {
  flex: 1;
  margin: 0;
}
.ai-confirm-actions .btn + .btn {
  margin-left: 16rpx;
}

/* 第二步:给每个店铺选图 */
.pk-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
}
.pk-title { font-size: 30rpx; font-weight: 600; }
.pk-auto { font-size: 26rpx; color: var(--color-primary); padding: 8rpx 0 8rpx 24rpx; }
.pk-warn {
  margin-top: 12rpx;
  padding: 12rpx 16rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #b04444;
  background: #fdf0f0;
}
.pk-progress {
  margin-top: 12rpx;
  padding: 12rpx 16rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #1f6feb;
  background: #e8f0fe;
}
.pk-shop {
  border: 1rpx solid var(--border);
  border-radius: 12rpx;
  margin-top: 16rpx;
  overflow: hidden;
}
.pk-shop-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx;
}
.pk-shop-name { font-size: 28rpx; font-weight: 600; flex-shrink: 0; }
.pk-shop-thumbs { flex: 1; display: flex; gap: 8rpx; overflow: hidden; }
.pk-mini { width: 56rpx; height: 56rpx; border-radius: 6rpx; flex-shrink: 0; }
.pk-shop-count { margin-left: auto; font-size: 24rpx; color: var(--text-secondary); flex-shrink: 0; }
.pk-shop-count--empty { color: #b04444; }
.pk-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  padding: 0 24rpx 24rpx;
}
.pk-cell {
  position: relative;
  border-radius: 8rpx;
  overflow: hidden;
  border: 4rpx solid transparent;
}
.pk-cell--on { border-color: var(--color-primary); }
.pk-cell--taken .pk-img { opacity: .3; }
.pk-img { width: 100%; height: 200rpx; display: block; }
/* 左上角勾选圈:点图看大图,点这里选中 */
.pk-select {
  position: absolute; left: 8rpx; top: 8rpx;
  width: 44rpx; height: 44rpx; border-radius: 50%;
  background: rgba(0, 0, 0, .45); border: 3rpx solid #fff;
  display: flex; align-items: center; justify-content: center;
  box-sizing: border-box;
}
.pk-select-mark { font-size: 22rpx; color: #fff; }
.pk-cell--on .pk-select { background: var(--color-primary); }
/* 右上角看大图:点图本身是选中 */
.pk-zoom {
  position: absolute; right: 0; top: 0;
  width: 64rpx; height: 64rpx;
  display: flex; align-items: flex-start; justify-content: flex-end;
  padding: 8rpx; box-sizing: border-box;
}
.pk-zoom-icon {
  width: 40rpx; height: 40rpx; line-height: 40rpx; text-align: center;
  font-size: 24rpx; color: #fff; background: rgba(0, 0, 0, .45); border-radius: 8rpx;
}
.pk-kind {
  position: absolute; left: 8rpx; bottom: 8rpx;
  font-size: 20rpx; color: #fff; background: rgba(0, 0, 0, .5);
  padding: 2rpx 10rpx; border-radius: 6rpx;
}
.pk-kind--bad { background: rgba(220, 38, 38, .85); }
.pk-order {
  position: absolute; right: 8rpx; top: 8rpx;
  width: 40rpx; height: 40rpx; line-height: 40rpx; text-align: center;
  font-size: 22rpx; color: #fff; background: var(--color-primary); border-radius: 50%;
}
.pk-taken {
  position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%);
  max-width: 90%; overflow: hidden; white-space: nowrap; text-overflow: ellipsis;
  font-size: 22rpx; color: #fff; background: rgba(0, 0, 0, .65);
  padding: 4rpx 14rpx; border-radius: 999rpx;
}
.pk-actions {
  flex-shrink: 0;
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}
.pk-back { flex: 1; }
.pk-go { flex: 2; }
