.form-section {
  margin-bottom: 32rpx;
}

.form-section-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #374151;
  margin-bottom: 16rpx;
  padding-bottom: 8rpx;
  border-bottom: 2rpx solid #E5E7EB;
}

.form-field {
  margin-bottom: 20rpx;
}

.form-label {
  font-size: 26rpx;
  color: #6B7280;
  margin-bottom: 8rpx;
}

.form-required {
  color: #DC2626;
}

.form-input {
  width: 100%;
  height: 80rpx;
  padding: 0 24rpx;
  background: #F9FAFB;
  border: 1rpx solid #E5E7EB;
  border-radius: 12rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-textarea {
  width: 100%;
  min-height: 120rpx;
  padding: 16rpx 24rpx;
  background: #F9FAFB;
  border: 1rpx solid #E5E7EB;
  border-radius: 12rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-picker {
  width: 100%;
  height: 80rpx;
  padding: 0 24rpx;
  background: #F9FAFB;
  border: 1rpx solid #E5E7EB;
  border-radius: 12rpx;
  font-size: 28rpx;
  line-height: 80rpx;
  box-sizing: border-box;
  color: #374151;
}

.form-row {
  display: flex;
  gap: 20rpx;
}

.form-half {
  flex: 1;
  min-width: 0;
}

/* Purchase order search */
.po-linked {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  background: #EFF6FF;
  border: 1rpx solid #BFDBFE;
  border-radius: 12rpx;
}

.po-linked-text {
  font-size: 26rpx;
  color: #2563EB;
}

.po-clear {
  font-size: 36rpx;
  color: #6B7280;
  padding: 0 8rpx;
}

.po-searching {
  font-size: 24rpx;
  color: #9CA3AF;
  padding: 16rpx 0;
  text-align: center;
}

.po-results {
  background: #F9FAFB;
  border: 1rpx solid #E5E7EB;
  border-radius: 12rpx;
  overflow: hidden;
}

.po-item {
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #F3F4F6;
}

.po-item:last-child {
  border-bottom: none;
}

.po-item-main {
  font-size: 28rpx;
  font-weight: 600;
  color: #111827;
}

.po-item-sub {
  font-size: 24rpx;
  color: #6B7280;
  margin-top: 4rpx;
}

/* Images */
.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.image-item {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  overflow: hidden;
}

.image-thumb {
  width: 100%;
  height: 100%;
}

.image-remove {
  position: absolute;
  top: -2rpx;
  right: -2rpx;
  width: 44rpx;
  height: 44rpx;
  background: rgba(0, 0, 0, 0.6);
  color: #fff;
  font-size: 32rpx;
  line-height: 44rpx;
  text-align: center;
  border-radius: 0 12rpx 0 12rpx;
}

.image-add {
  width: 160rpx;
  height: 160rpx;
  background: #F9FAFB;
  border: 2rpx dashed #D1D5DB;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.image-add-icon {
  font-size: 56rpx;
  color: #9CA3AF;
  line-height: 1;
}

.image-add-text {
  font-size: 22rpx;
  color: #9CA3AF;
  margin-top: 4rpx;
}

.btn {
  margin-top: 24rpx;
}

/* 资产编号扫码输入框：复用全局 .search-scan-icon（纯 CSS 扫码图标） */
.form-input-scan {
  position: relative;
  display: flex;
  align-items: center;
}

.form-input--scan {
  padding-right: 84rpx;
}
