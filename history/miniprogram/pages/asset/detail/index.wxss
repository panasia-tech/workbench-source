.detail-images {
  margin-bottom: 24rpx;
}

.detail-images-scroll {
  white-space: nowrap;
  padding: 0 20rpx;
}

.detail-image {
  display: inline-block;
  width: 320rpx;
  height: 240rpx;
  border-radius: 16rpx;
  margin-right: 16rpx;
}

.detail-kv {
  padding: 4rpx 0;
}

.detail-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F3F4F6;
}

.detail-row:last-child {
  border-bottom: none;
}

.detail-key {
  font-size: 26rpx;
  color: #6B7280;
  flex-shrink: 0;
  margin-right: 24rpx;
}

.detail-val {
  font-size: 28rpx;
  color: #111827;
  text-align: right;
  word-break: break-all;
}

.detail-val.mono {
  font-family: monospace;
}

.detail-val--link {
  color: #2563EB;
}

.detail-actions {
  margin-top: 24rpx;
  display: flex;
  flex-direction: row;
  gap: 16rpx;
}

.detail-actions .btn {
  flex: 1;
  min-width: 0;
}
