.asset-loading {
  padding: 24rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: #9CA3AF;
}

/* 资产名称两行时行高偏松，收紧让上下更协调（仅本页生效）*/
.li-title {
  line-height: 1.25;
}

.li-del-btn {
  margin-top: 12rpx;
  padding: 8rpx 20rpx;
  font-size: 22rpx;
  color: #DC2626;
  background: #FEF2F2;
  border: 1rpx solid #FECACA;
  border-radius: 8rpx;
  line-height: 1.4;
}

.li-del-btn:active {
  opacity: 0.7;
}

.tag-danger {
  background: #FEF2F2;
  color: #DC2626;
  border-color: #FECACA;
}

.li-sub--link {
  color: #2563EB;
}

/* FAB */
.asset-fab {
  position: fixed;
  right: 40rpx;
  bottom: 64rpx;
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: #2563EB;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(37, 99, 235, 0.4);
  z-index: 50;
}

.asset-fab:active {
  opacity: 0.85;
}

.asset-fab-plus {
  color: #FFFFFF;
  font-size: 60rpx;
  line-height: 1;
  font-weight: 300;
}
