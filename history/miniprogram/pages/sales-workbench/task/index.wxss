/* 主管加派的任务：一张要求卡 + 现在能点的按钮 + 记录 */
.tk-page .tk-head { display: flex; gap: 12rpx; flex-wrap: wrap; }
.tk-page .tk-title { margin-top: 16rpx; font-size: 34rpx; font-weight: 800; color: #111827; line-height: 1.4; }
.tk-page .tk-k { margin-top: 20rpx; font-size: 22rpx; color: #6B7280; }
.tk-page .tk-v { margin-top: 6rpx; font-size: 28rpx; color: #111827; line-height: 1.6; white-space: pre-wrap; }
.tk-page .tk-meta { margin-top: 20rpx; font-size: 22rpx; color: #9CA3AF; }
.tk-page .tk-handoff { background: #FFFBEB; border: 1rpx solid #FDE68A; }
.tk-page .tk-handoff .tk-k { margin-top: 0; color: #92400E; }
.tk-page .tk-note { font-size: 26rpx; color: #374151; line-height: 1.6; }
.tk-page .tk-note--red { background: #FEF2F2; color: #B91C1C; }
.tk-page .tk-acts { display: flex; gap: 16rpx; flex-wrap: wrap; }
.tk-page .tk-acts .btn { margin: 0; width: auto; padding: 0 28rpx; }
.tk-page .tk-cancel { color: #9CA3AF; }
.tk-page .tk-form { margin-top: 24rpx; padding-top: 24rpx; border-top: 1rpx solid #F3F4F6; }
.tk-page .tk-gap { margin-top: 16rpx; }
.tk-page .tk-pick { color: #374151; }
.tk-page .tk-wait { font-size: 26rpx; color: #6B7280; }
.tk-page .tk-log { display: flex; flex-wrap: wrap; gap: 4rpx 16rpx; padding: 14rpx 0; border-top: 1rpx solid #F3F4F6; font-size: 24rpx; }
.tk-page .tk-log__at { color: #9CA3AF; }
.tk-page .tk-log__who { color: #111827; font-weight: 600; }
.tk-page .tk-log__note { width: 100%; color: #4B5563; }
