.ret-page .ret-recheck-entry {
  display: block;
  margin: 14rpx 0 4rpx;
  padding: 14rpx 20rpx;
  border-radius: 12rpx;
  background: #EFF6FF;
  border: 2rpx solid #BFDBFE;
  color: #1D4ED8;
  font-size: 25rpx;
  font-weight: 600;
}

.ret-page .ret-actions {
  padding: 16rpx 24rpx 24rpx;
  display: flex;
  gap: 16rpx;
  width: 100%;
}

.ret-page .ret-actions .btn,
.ret-page .ret-actions .btn-primary {
  flex: 1;
  margin: 0;
}

.ret-page .link-row {
  margin-bottom: 16rpx;
}

/* 异常说明行 */
.ret-page .ret-abnormal {
  padding: 0 24rpx 8rpx;
  font-size: 24rpx;
  color: #B91C1C;
  word-break: break-all;
}

.ret-page .ret-abnormal-label {
  font-weight: 600;
}

.ret-page .ret-btn-danger {
  color: #B91C1C;
  border-color: #FECACA;
}
