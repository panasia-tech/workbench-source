.rr-product {
  padding: 8rpx 0 4rpx;
}

.rr-product-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #111827;
}

.rr-product-sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #6B7280;
}

/* 序列号扫码输入框：复用全局 .search-scan-icon（纯 CSS 扫码图标） */
.form-input-scan {
  position: relative;
  display: flex;
  align-items: center;
}

.form-input--scan {
  padding-right: 84rpx;
}

.form-note--warn {
  color: #B45309;
}

/* 照片九宫格（与资产表单一致） */
.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.image-item {
  position: relative;
  width: 160rpx;
  height: 160rpx;
}

.image-thumb {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
  background: #F3F4F6;
}

.image-remove {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 40rpx;
  height: 40rpx;
  line-height: 36rpx;
  text-align: center;
  background: rgba(17, 24, 39, 0.72);
  color: #fff;
  border-radius: 50%;
  font-size: 28rpx;
}

.image-add {
  width: 160rpx;
  height: 160rpx;
  border: 2rpx dashed #D1D5DB;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #9CA3AF;
}

.image-add-icon {
  font-size: 48rpx;
  line-height: 1;
}

.image-add-text {
  font-size: 20rpx;
  margin-top: 8rpx;
}

.btn-block {
  margin-top: 16rpx;
}
