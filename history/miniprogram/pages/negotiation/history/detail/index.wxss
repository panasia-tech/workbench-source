.neg-detail-page .card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.neg-price-board {
  background: #F8FAFC;
  border-radius: 12rpx;
  padding: 24rpx 28rpx;
}

.neg-price-main {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #EDF0F3;
}

.neg-price-label {
  font-size: 28rpx;
  color: #6B7280;
}

.neg-price-value {
  font-size: 44rpx;
  font-weight: 700;
  color: #DC2626;
}

.neg-price-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 14rpx;
}

.neg-price-row-label {
  font-size: 26rpx;
  color: #9CA3AF;
}

.neg-price-row-value {
  font-size: 28rpx;
  color: #374151;
}

.neg-price-row-value.is-down {
  color: #16A34A;
}

.neg-price-row-value.is-up {
  color: #DC2626;
}

.neg-meta-line {
  margin-top: 18rpx;
  font-size: 24rpx;
  color: #9CA3AF;
}

.neg-remark {
  font-size: 28rpx;
  color: #374151;
  line-height: 1.6;
  white-space: pre-wrap;
  word-break: break-all;
}
