.rt-page .card { margin-bottom: 20rpx; }
.rt-h { font-size: 30rpx; font-weight: 700; color: #111827; margin-bottom: 8rpx; }
.rt-muted { font-size: 24rpx; color: #6B7280; line-height: 1.6; }
.rt-item { padding: 24rpx 0; border-bottom: 1rpx solid #F3F4F6; }
.rt-item:last-child { border-bottom: none; }
.rt-title { font-size: 30rpx; font-weight: 700; color: #111827; }
.rt-sub { margin-top: 6rpx; font-size: 24rpx; color: #6B7280; }
.rt-tags { display: flex; flex-wrap: wrap; gap: 8rpx; margin-top: 12rpx; }
.rt-tag { margin: 0; }
.list-loading { text-align: center; padding: 24rpx 0; font-size: 24rpx; color: #9CA3AF; }
.empty { text-align: center; padding: 48rpx 0; color: #9CA3AF; }
.e-icon { font-size: 48rpx; margin-bottom: 8rpx; }
.e-text { font-size: 26rpx; }
