/* 待验货列表 */
.insp-piece-tag {
  margin-right: 8rpx;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  background: #DBEAFE;
  color: #1D4ED8;
  font-size: 22rpx;
  font-weight: 700;
}

/* 右上角入口：验货记录 / 补测待办 / 拒签记录 */
.insp-page .entry-row {
  display: flex;
  justify-content: flex-end;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.insp-page .entry-chip {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #2563EB;
  background: #EFF6FF;
  border: 1rpx solid #DBEAFE;
}

.insp-page .entry-chip__dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #2563EB;
}

.insp-page .entry-chip__arrow {
  font-size: 30rpx;
  line-height: 1;
  opacity: 0.55;
}

.insp-page .entry-chip--warn {
  color: #B45309;
  background: #FFFBEB;
  border-color: #FDE68A;
}

.insp-page .entry-chip--warn .entry-chip__dot {
  background: #D97706;
}

.insp-page .entry-chip--danger {
  color: #DC2626;
  background: #FEF2F2;
  border-color: #FECACA;
}

.insp-page .entry-chip--danger .entry-chip__dot {
  background: #DC2626;
}

.insp-page .entry-chip--hover {
  opacity: 0.7;
}

.insp-page .card {
  padding: 28rpx 32rpx 12rpx;
}

.insp-page .card-head--split {
  margin-bottom: 8rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #E5E7EB;
}

.insp-page .card-head-main {
  font-size: 32rpx;
  font-weight: 800;
  color: #111827;
}

.insp-page .head-extra {
  margin-left: 12rpx;
  vertical-align: middle;
}

.insp-page .express-batch-btn {
  max-width: 240rpx;
  padding: 12rpx 20rpx;
  font-size: 22rpx;
  line-height: 1.3;
  text-align: center;
}

.insp-page .list-item--stacked {
  padding: 28rpx 0;
  border-bottom: 1rpx solid #E5E7EB;
}

.insp-page .list-item--stacked:last-child {
  border-bottom: none;
}

.insp-page .list-item--stacked:active {
  opacity: 0.75;
}

.insp-page .list-item__main .li-thumb-wrap {
  width: 112rpx;
  height: 112rpx;
}

.insp-page .list-item__main .li-thumb-wrap media-thumb {
  width: 100%;
  height: 100%;
  display: block;
}

.insp-page .list-item__main .li-icon {
  width: 112rpx;
  height: 112rpx;
  line-height: 112rpx;
  border-radius: 16rpx;
}

.insp-page .list-item__main .li-title {
  font-size: 30rpx;
  -webkit-line-clamp: 2;
}

.insp-page .list-item__main .li-meta {
  min-width: 132rpx;
}

.insp-page .list-item__main .li-price {
  font-size: 32rpx;
  letter-spacing: -0.5rpx;
}

.insp-page .list-item__main .li-tag {
  margin: 0;
  padding: 6rpx 16rpx;
  font-size: 20rpx;
}

/* 议价成功待召回：置顶高亮 + 红色提醒标签 */
.insp-page .recall-item {
  padding: 24rpx 20rpx;
  margin: 0 -20rpx;
  border-radius: 16rpx;
  background: #FEF2F2;
  border: 1rpx solid #FECACA;
  border-bottom: 1rpx solid #FECACA;
}

.insp-page .recall-item + .recall-item {
  margin-top: 12rpx;
}

.insp-page .recall-tag {
  display: inline-block;
  padding: 6rpx 16rpx;
  font-size: 20rpx;
  line-height: 1.3;
  color: #FFFFFF;
  background: #DC2626;
  border-radius: 8rpx;
  text-align: center;
}

.insp-page .li-express-zone {
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: #EFF6FF;
  border: 1rpx solid #BFDBFE;
}

.insp-page .li-express-zone-no {
  font-size: 24rpx;
  letter-spacing: 0.5rpx;
}

.insp-page .li-express-zone-action {
  padding: 10rpx 20rpx;
  font-size: 22rpx;
}

.insp-page .li-express-zone-body {
  font-size: 24rpx;
  line-height: 1.5;
}

.insp-page .empty {
  padding: 64rpx 32rpx;
}

/* 搜索框内嵌扫码图标 */
.insp-page .search-input-wrap {
  position: relative;
  flex: 1;
  display: flex;
  align-items: center;
}

.insp-page .search-input--with-scan {
  flex: 1;
  width: 100%;
  padding-right: 84rpx;
}

.insp-page .search-scan-icon {
  position: absolute;
  right: 8rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.insp-page .search-scan-icon:active {
  opacity: 0.6;
}

.insp-page .search-scan-icon .scan-frame {
  position: relative;
  width: 34rpx;
  height: 34rpx;
  background:
    linear-gradient(#2563EB, #2563EB) left top,
    linear-gradient(#2563EB, #2563EB) left top,
    linear-gradient(#2563EB, #2563EB) right top,
    linear-gradient(#2563EB, #2563EB) right top,
    linear-gradient(#2563EB, #2563EB) left bottom,
    linear-gradient(#2563EB, #2563EB) left bottom,
    linear-gradient(#2563EB, #2563EB) right bottom,
    linear-gradient(#2563EB, #2563EB) right bottom;
  background-repeat: no-repeat;
  background-size: 12rpx 3rpx, 3rpx 12rpx;
}

.insp-page .search-scan-icon .scan-line {
  position: absolute;
  left: 15rpx;
  right: 15rpx;
  height: 3rpx;
  background: #2563EB;
  border-radius: 2rpx;
}
