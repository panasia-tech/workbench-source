.pf-tabs { display: flex; gap: 12rpx; margin-bottom: 16rpx; }
.pf-tab { padding: 10rpx 24rpx; border-radius: 32rpx; background: #f3f4f6; color: #6b7280; font-size: 26rpx; }
.pf-tab--on { background: #2563eb; color: #fff; }
.pf-badge { margin-left: 8rpx; padding: 0 10rpx; border-radius: 16rpx; background: #dc2626; color: #fff; font-size: 22rpx; }
.pf-meta { margin-top: 12rpx; color: #6b7280; font-size: 24rpx; }
.pf-item { border-bottom: 1rpx solid #eef0f3; padding: 20rpx 0; }
.pf-row { display: flex; gap: 16rpx; }
.pf-thumb { width: 120rpx; height: 120rpx; border-radius: 12rpx; flex-shrink: 0; background: #f3f4f6; }
.pf-thumb--none { display: flex; align-items: center; justify-content: center; color: #9ca3af; font-size: 22rpx; }
.pf-info { flex: 1; min-width: 0; }
.pf-title { font-size: 28rpx; font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.pf-sub, .pf-muted { color: #6b7280; font-size: 24rpx; margin-top: 4rpx; word-break: break-all; }
.pf-warn { color: #b45309; font-size: 24rpx; margin-top: 4rpx; }
.pf-tags { display: flex; flex-direction: column; align-items: flex-end; gap: 8rpx; flex-shrink: 0; }
.pf-detail { margin-top: 16rpx; padding: 16rpx; border-radius: 12rpx; background: #f8fafc; }
.pf-line { font-size: 24rpx; margin-bottom: 8rpx; }
.pf-link { color: #2563eb; }
.pf-ops { display: flex; gap: 16rpx; margin: 12rpx 0; }
.pf-events { border-top: 1rpx solid #e5e7eb; padding-top: 8rpx; }
.pf-ev { font-size: 22rpx; margin-top: 6rpx; }
