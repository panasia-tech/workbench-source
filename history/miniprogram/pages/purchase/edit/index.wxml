<view class="page-wrap page-wrap--no-tab purchase-page" wx:if="{{loaded}}">
  <view class="card purchase-card">
    <view class="step2-panel">
      <view class="upload-block">
        <text class="form-label">商品图<text class="req">*</text><text class="label-hint"> 实拍，可多张</text></text>
        <view wx:if="{{productImageUrls.length}}" class="upload-preview-grid upload-preview-grid--wrap">
          <view wx:for="{{productImageUrls}}" wx:key="*this" class="upload-preview-item upload-preview-item--sm">
            <media-thumb url="{{productImageDisplayUrls[index] || item}}" size="fill" preview="{{true}}" />
            <view class="upload-remove" data-index="{{index}}" catchtap="removeProductImage">×</view>
          </view>
        </view>
        <view wx:if="{{productImageUrls.length < maxProductImages}}" class="upload-zone upload-zone--compact" bindtap="chooseProductImage">
          <view class="uz-plus">+</view>
          <view class="uz-text">{{productImageUrls.length ? '继续添加商品图' : '上传商品实拍图'}}</view>
        </view>
      </view>

      <view class="upload-block">
        <text class="form-label">闲鱼订单截图<text class="label-hint"> 最多 2 张</text></text>
        <view wx:if="{{screenshotUrls.length}}" class="upload-preview-grid">
          <view wx:for="{{screenshotUrls}}" wx:key="*this" class="upload-preview-item">
            <media-thumb url="{{screenshotDisplayUrls[index] || item}}" size="fill" preview="{{true}}" />
            <view class="upload-remove" data-index="{{index}}" catchtap="removeScreenshot">×</view>
          </view>
        </view>
        <view wx:if="{{screenshotUrls.length < maxScreenshots}}" class="upload-zone upload-zone--compact" bindtap="chooseScreenshot">
          <view class="uz-plus">+</view>
          <view class="uz-text">添加订单截图</view>
        </view>
      </view>

      <view class="form-group form-group--compact">
        <text class="form-label">采购账号<text class="req">*</text></text>
        <picker
          wx:if="{{purchaseAccounts.length}}"
          mode="selector"
          range="{{purchaseAccounts}}"
          range-key="label"
          value="{{purchaseAccountIndex}}"
          bindchange="onPurchaseAccountChange"
        >
          <view class="input picker-field input--compact {{purchaseAccountLabel ? '' : 'picker-field--empty'}}">{{purchaseAccountLabel || '请选择采购账号'}}</view>
        </picker>
        <view wx:else class="input picker-field input--compact picker-field--empty">{{purchaseAccountLabel || '暂无可用账号'}}</view>
      </view>

      <view class="form-group form-group--compact form-group--code">
        <text class="form-label">订单号<text class="req">*</text></text>
        <input class="input input--code input--compact" placeholder="闲鱼订单号" data-key="external_order_no" value="{{form.external_order_no}}" bindinput="onInput" />
      </view>

      <view class="form-row form-row--short">
        <view class="form-group form-group--compact">
          <text class="form-label">交易流水号<text class="req">*</text></text>
          <input class="input input--compact" placeholder="流水号" data-key="transaction_no" value="{{form.transaction_no}}" bindinput="onInput" />
        </view>
        <view class="form-group form-group--compact">
          <text class="form-label">物流单号<text class="req">*</text></text>
          <input class="input input--compact" placeholder="快递单号" data-key="tracking_no" value="{{form.tracking_no}}" bindinput="onInput" />
        </view>
      </view>

      <view class="form-group form-group--compact">
        <text class="form-label">手机后四位</text>
        <input
          class="input input--compact"
          placeholder="顺丰查询选填，收/寄件人手机号后 4 位"
          type="number"
          maxlength="4"
          value="{{form.tracking_phone_suffix}}"
          bindinput="onPhoneSuffixInput"
        />
      </view>

      <view class="form-group form-group--compact">
        <text class="form-label">卖家昵称<text class="req">*</text></text>
        <input class="input input--compact" placeholder="卖家昵称" data-key="seller_name" value="{{form.seller_name}}" bindinput="onInput" />
      </view>

      <view class="form-row form-row--short">
        <view class="form-group form-group--compact">
          <text class="form-label">下单时间<text class="req">*</text></text>
          <view class="datetime-row datetime-row--compact">
            <picker mode="date" class="datetime-picker" value="{{orderDate}}" start="2020-01-01" end="2030-12-31" bindchange="onOrderDateChange">
              <view class="input picker-field input--compact {{orderDate ? '' : 'picker-field--empty'}}">{{orderDate || '日期'}}</view>
            </picker>
            <picker mode="time" class="datetime-picker" value="{{orderTime}}" bindchange="onOrderTimeChange">
              <view class="input picker-field input--compact {{orderTime ? '' : 'picker-field--empty'}}">{{orderTime || '时间'}}</view>
            </picker>
          </view>
        </view>
        <view class="form-group form-group--compact">
          <text class="form-label">付款时间<text class="req">*</text></text>
          <view class="datetime-row datetime-row--compact">
            <picker mode="date" class="datetime-picker" value="{{paidDate}}" start="2020-01-01" end="2030-12-31" bindchange="onPaidDateChange">
              <view class="input picker-field input--compact {{paidDate ? '' : 'picker-field--empty'}}">{{paidDate || '日期'}}</view>
            </picker>
            <picker mode="time" class="datetime-picker" value="{{paidTime}}" bindchange="onPaidTimeChange">
              <view class="input picker-field input--compact {{paidTime ? '' : 'picker-field--empty'}}">{{paidTime || '时间'}}</view>
            </picker>
          </view>
        </view>
      </view>

      <view class="form-row form-row--short">
        <view class="form-group form-group--compact">
          <text class="form-label">品牌<text class="req">*</text></text>
          <input class="input input--compact" placeholder="如 戴尔" data-key="brand" value="{{form.brand}}" bindinput="onInput" />
        </view>
        <view class="form-group form-group--compact">
          <text class="form-label">型号<text class="req">*</text></text>
          <input class="input input--compact" placeholder="型号" data-key="model" value="{{form.model}}" bindinput="onInput" />
        </view>
      </view>

      <view class="form-row form-row--short">
        <view class="form-group form-group--compact">
          <text class="form-label">规格</text>
          <input class="input input--compact" placeholder="如 2K240" data-key="spec" value="{{form.spec}}" bindinput="onInput" />
        </view>
        <view class="form-group form-group--compact">
          <text class="form-label">成交金额<text class="req">*</text></text>
          <input class="input input--price input--compact" placeholder="0.00" type="digit" data-key="unit_price" value="{{form.unit_price}}" bindinput="onInput" />
        </view>
      </view>

      <view class="form-group form-group--compact form-group--tight">
        <text class="form-label">备注</text>
        <input class="input input--compact" placeholder="可选" data-key="remark" value="{{form.remark}}" bindinput="onInput" />
      </view>

      <view wx:if="{{canEditOverdue}}" class="form-group form-group--compact form-group--tight edit-overdue-row">
        <text class="form-label">逾期采购</text>
        <switch checked="{{form.is_overdue}}" color="#DC2626" bindchange="onOverdueToggle" />
      </view>
    </view>

    <button class="btn-primary btn-block step-btn" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submit">保存修改</button>
  </view>
</view>
