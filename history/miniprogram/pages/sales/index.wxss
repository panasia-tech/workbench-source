.sales-page .entry-chips {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.sales-page .entry-chip {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 20rpx 24rpx;
  background: #fff;
  border: 1rpx solid #E5E7EB;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(17, 24, 39, 0.04);
}

.sales-page .entry-chip--hover {
  background: #EFF6FF;
  border-color: #BFDBFE;
}

.sales-page .entry-chip-text {
  font-size: 26rpx;
  font-weight: 600;
  color: #2563EB;
  line-height: 1;
}

.sales-page .entry-chip-arrow {
  font-size: 26rpx;
  font-weight: 600;
  color: #93C5FD;
  line-height: 1;
}

.sales-page .ship-card {
  padding-bottom: 16rpx;
}

.sales-page .ship-card .form-note {
  margin: -8rpx 0 20rpx;
}

.sales-page .ship-order-list .ship-order-item {
  align-items: flex-start;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #E5E7EB;
}

.sales-page .ship-order-list .ship-order-item:last-child {
  border-bottom: none;
}

.sales-page .ship-order-item .li-icon {
  width: 84rpx;
  height: 84rpx;
  border-radius: 16rpx;
  background: #EFF6FF;
  border: 1rpx solid #BFDBFE;
  color: #2563EB;
  font-size: 28rpx;
  font-weight: 800;
}

.sales-page .ship-order-item .li-info {
  flex: 1;
  min-width: 0;
}

.sales-page .li-hint {
  font-size: 22rpx;
  color: #6B7280;
  margin-top: 8rpx;
  line-height: 1.4;
}

.sales-page .li-hint--warn {
  color: #D97706;
}

.sales-page .ship-order-item .li-meta {
  min-width: auto;
  flex-shrink: 0;
  padding-top: 8rpx;
  align-items: center;
}

.sales-page .ship-action-btn {
  width: auto !important;
  min-width: 0 !important;
  margin: 0;
  padding: 0 24rpx !important;
  height: 64rpx;
  line-height: 64rpx;
}

.sales-page .empty--compact {
  padding: 24rpx 0 8rpx;
}

.sales-page .more-card {
  margin-top: 24rpx;
}

.sales-page .more-card .form-note {
  margin: -8rpx 0 20rpx;
}

.sales-page .more-entry-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.sales-page .more-entry-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 24rpx 28rpx;
  border-radius: 32rpx;
  background: #F9FAFB;
  border: 1rpx solid #E5E7EB;
}

.sales-page .more-entry-item:active {
  opacity: 0.85;
  background: #F3F4F6;
}

.sales-page .more-entry-body {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: 1;
  min-width: 0;
}

.sales-page .more-entry-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 12rpx;
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.sales-page .more-entry-icon--pickup {
  background: #EFF6FF;
  color: #2563EB;
  border: 1rpx solid #BFDBFE;
}

.sales-page .more-entry-icon--switch {
  background: #ECFDF5;
  color: #059669;
  border: 1rpx solid #A7F3D0;
}

.sales-page .more-entry-icon--manual {
  background: #FEF3F2;
  color: #DC2626;
  border: 1rpx solid #FECACA;
}

.sales-page .more-entry-text {
  flex: 1;
  min-width: 0;
}

.sales-page .more-entry-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #111827;
  line-height: 1.3;
}

.sales-page .more-entry-sub {
  font-size: 22rpx;
  color: #6B7280;
  font-weight: 600;
  margin-top: 6rpx;
  line-height: 1.4;
}

.sales-page .more-entry-arrow {
  font-size: 36rpx;
  font-weight: 700;
  color: #2563EB;
  line-height: 1;
  flex-shrink: 0;
}
