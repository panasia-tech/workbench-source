<view class="page-wrap page-wrap--no-tab sales-manual-page">
  <view class="manual-intro">
    扫码找货 → 填成交信息 → 一步建单出库
  </view>

  <!-- ① 选择商品 -->
  <view class="card manual-card">
    <view class="manual-step">
      <text class="manual-step-no">1</text>
      <text class="manual-step-title">选择商品</text>
    </view>

    <view class="code-input-field">
      <input
        class="input input--code"
        placeholder="扫码或输入货号"
        data-key="sku_code"
        value="{{form.sku_code}}"
        bindinput="onInput"
        bindblur="onCodeBlur"
      />
      <button class="btn btn-outline btn-sm btn-block code-input-scan" bindtap="scanSku">扫码填入</button>
    </view>

    <view wx:if="{{skuLoading}}" class="sku-brief sku-brief--loading">查询商品中…</view>
    <view wx:elif="{{skuError}}" class="sku-brief sku-brief--error">{{skuError}}</view>
    <view wx:elif="{{sku}}" class="sku-brief" bindtap="goSkuDetail">
      <view class="sku-brief-thumb">
        <media-thumb
          wx:if="{{sku.cover_thumb_url || sku.cover_url}}"
          url="{{sku.cover_thumb_url || sku.cover_url}}"
          preview-url="{{sku.cover_url}}"
          size="small"
        />
        <view wx:else class="sku-brief-icon">{{sku.product_name ? sku.product_name[0] : '货'}}</view>
      </view>
      <view class="sku-brief-info">
        <view class="sku-brief-name">{{sku.product_name}}<text wx:if="{{sku.spec}}"> · {{sku.spec}}</text></view>
        <view class="sku-brief-sub">{{sku.sku_code}}<text wx:if="{{sku.suggest_price}}"> · 参考价 ¥{{sku.suggest_price}}</text></view>
        <view wx:if="{{sku.on_shelf_count > 0}}" class="sku-brief-warn">仍在 {{sku.on_shelf_count}} 个店铺在架，出库后会自动下架</view>
      </view>
      <text class="sku-brief-arrow">详情 ›</text>
    </view>
    <view wx:else class="sku-empty-hint">扫码或输入货号后自动带出商品</view>
  </view>

  <!-- ② 成交信息 -->
  <view class="card manual-card">
    <view class="manual-step">
      <text class="manual-step-no">2</text>
      <text class="manual-step-title">成交信息</text>
    </view>

    <view class="price-field">
      <text class="form-label">成交价<text class="req">*</text></text>
      <view class="price-input-wrap">
        <text class="price-symbol">¥</text>
        <input
          class="price-input"
          placeholder="0.00"
          type="digit"
          data-key="sale_price"
          value="{{form.sale_price}}"
          bindinput="onInput"
        />
      </view>
    </view>

    <view class="form-group">
      <text class="form-label">交易方式<text class="req">*</text></text>
      <view class="status-segment">
        <text class="status-seg {{form.transaction_type === 'PLATFORM' ? 'active' : ''}}" data-type="PLATFORM" bindtap="pickTransactionType">平台交易</text>
        <text class="status-seg {{form.transaction_type === 'PICKUP' ? 'active' : ''}}" data-type="PICKUP" bindtap="pickTransactionType">自提</text>
      </view>
      <text class="label-hint">自提没有服务费</text>
    </view>

    <!-- 无忧卖暂时下线(2026-09):开关隐藏,form.worry_free 恒为 false;恢复时解开注释即可
    <view class="form-group form-group--switch" wx:if="{{form.transaction_type === 'PLATFORM'}}">
      <text class="form-label">无忧卖（2.6% 手续费）</text>
      <switch checked="{{form.worry_free}}" bindchange="onWorryFreeChange" />
    </view>
    -->

    <view class="form-group" wx:if="{{form.transaction_type === 'PLATFORM'}}">
      <text class="form-label">闲鱼服务费</text>
      <input class="input input--price" placeholder="订单页上的服务费，还没出来先空着" type="digit" data-key="platform_fee" value="{{form.platform_fee}}" bindinput="onInput" />
    </view>

    <view class="form-group" wx:if="{{form.transaction_type === 'PLATFORM'}}">
      <text class="form-label">成交店铺<text class="req">*</text></text>
      <picker mode="selector" range="{{shopLabels}}" value="{{shopIndex}}" bindchange="onShopChange">
        <view class="picker-field {{form.shop_name ? '' : 'picker-field--placeholder'}}">
          <text>{{form.shop_name || (shopLabels.length ? '请选择成交店铺' : '暂无可用店铺') }}</text>
          <text class="picker-arrow">▾</text>
        </view>
      </picker>
    </view>

    <view class="form-row form-row--short">
      <view class="form-group">
        <text class="form-label">买家昵称</text>
        <input class="input" placeholder="选填" data-key="buyer_name" value="{{form.buyer_name}}" bindinput="onInput" />
      </view>
      <view class="form-group">
        <text class="form-label">买家手机号</text>
        <input class="input" placeholder="选填" type="number" maxlength="11" value="{{form.buyer_phone}}" bindinput="onPhoneInput" />
      </view>
    </view>
  </view>

  <!-- ③ 物流与凭证 -->
  <view class="card manual-card">
    <view class="manual-step">
      <text class="manual-step-no">3</text>
      <text class="manual-step-title">物流与凭证</text>
      <text class="manual-step-opt">选填</text>
    </view>

    <view class="form-row form-row--short">
      <view class="form-group form-group--code">
        <text class="form-label">快递运单号</text>
        <input class="input input--code" placeholder="邮寄发货填写" data-key="tracking_no" value="{{form.tracking_no}}" bindinput="onInput" />
      </view>
      <view class="form-group">
        <text class="form-label">快递费</text>
        <input class="input input--price" placeholder="0.00" type="digit" data-key="express_fee" value="{{form.express_fee}}" bindinput="onInput" />
      </view>
    </view>

    <view class="upload-section">
      <text class="label-hint">成交凭证<text class="req">*</text>（聊天 / 收款截图，图片或视频，已传 {{form.evidence_urls.length}} 个）</text>
      <view class="upload-zone {{form.evidence_urls.length ? 'upload-zone--compact' : ''}}" bindtap="uploadEvidence">
        <block wx:if="{{!form.evidence_urls.length}}">
          <view class="uz-camera"></view>
          <view class="uz-text">上传成交凭证</view>
          <view class="uz-hint">图片 / 视频 · 可多次追加（最多 3 个）</view>
        </block>
        <block wx:else>
          <media-gallery urls="{{form.evidence_urls}}" display-urls="{{evidenceDisplayUrls}}" thumb-size="medium" />
          <view class="upload-replace-hint">点击继续追加</view>
        </block>
      </view>
    </view>

    <view class="form-group">
      <text class="form-label">备注</text>
      <textarea class="input input--textarea" auto-height="{{true}}" placeholder="可选" data-key="remark" value="{{form.remark}}" bindinput="onInput" />
    </view>
  </view>

  <!-- 底部固定操作栏 -->
  <view class="manual-footer">
    <view class="footer-amount">
      <text class="footer-amount-label">成交价</text>
      <text class="footer-amount-num">¥{{form.sale_price || '0.00'}}</text>
    </view>
    <button
      class="btn-primary footer-submit"
      bindtap="submit"
      loading="{{submitting}}"
    >确认成交并出库</button>
  </view>
</view>
