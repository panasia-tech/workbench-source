<wxs module="fmt" src="../../../utils/format.wxs" />

<view class="page-wrap page-wrap--no-tab sales-ship-page">
  <view class="card" wx:if="{{order}}">
    <view class="card-head">订单发货</view>
    <view class="ship-order-info">
      <view class="ship-order-title">{{order.product_title || order.order_no}}</view>
      <view class="ship-order-sub" wx:if="{{order.product_spec}}">{{order.product_spec}}</view>
      <view class="ship-order-sub">
        买家 {{order.buyer_name || '—'}} · ¥{{fmt.money(order.amount)}} · {{fmt.platformLabel(order.shop_name, order.platform)}}
      </view>
    </view>

    <view class="section-label">发货方式</view>
    <view class="status-segment ship-mode-seg">
      <text
        class="status-seg {{deliveryMode === 'express' ? 'active' : ''}}"
        data-mode="express"
        bindtap="onDeliveryMode"
      >快递发货</text>
      <text
        class="status-seg {{deliveryMode === 'pickup' ? 'active' : ''}}"
        data-mode="pickup"
        bindtap="onDeliveryMode"
      >买家自提</text>
    </view>
    <view class="form-note" wx:if="{{deliveryMode === 'express'}}">填写快递运单号后提交出库</view>
    <view class="form-note" wx:else>买家到店自提，无需运单号</view>

    <view class="form-group form-group--code">
      <text class="form-label">SKU 货号<text class="req">*</text></text>
      <view class="code-input-field">
        <input
          class="input input--code"
          placeholder="扫描或输入货号"
          value="{{skuCode}}"
          bindinput="onSkuInput"
          bindconfirm="checkSku"
        />
        <button class="btn btn-outline btn-sm btn-block code-input-scan" bindtap="scanSku">扫码填入</button>
      </view>
    </view>

    <view class="match-box" wx:if="{{match}}">
      <view class="match-box__text">
        已匹配 {{match.product_name || '—'}} · {{match.spec || '—'}} · 库位 {{match.location_code || '—'}}
      </view>
    </view>
    <view class="match-err tip" wx:elif="{{matchError}}">{{matchError}}</view>
    <navigator wx:if="{{match}}" class="ship-review-entry" url="/pages/sales/review/index?code={{skuCode}}" hover-class="none">发货前复核：看入库视频照片、核对实物 ›</navigator>

    <block wx:if="{{deliveryMode === 'express'}}">
      <view class="form-group form-group--code">
        <text class="form-label">快递运单号<text class="req">*</text></text>
        <input
          class="input input--code"
          placeholder="发货后粘贴运单号"
          value="{{trackingNo}}"
          bindinput="onTrackingInput"
        />
      </view>
      <view class="form-group form-group--code">
        <text class="form-label">手机后四位</text>
        <input
          class="input input--code input--phone-suffix"
          placeholder="顺丰查询选填，收/寄件人手机号后 4 位"
          type="number"
          maxlength="4"
          value="{{trackingPhoneSuffix}}"
          bindinput="onPhoneSuffixInput"
        />
      </view>
    </block>

    <button
      class="btn-success btn-block submit-btn"
      bindtap="confirmShip"
      disabled="{{!match}}"
      loading="{{submitting}}"
    >确认出库发货</button>
  </view>

  <view class="card" wx:elif="{{standalonePickup}}">
    <view class="card-head">扫码出库（自提）</view>
    <view class="form-note">未关联闲鱼订单，请使用下方「买家自提出库」完整流程</view>
    <button class="btn-primary btn-block" bindtap="goPickupForm">前往自提出库</button>
  </view>
</view>
