var STATUS_LABEL = {
  'PENDING_INSPECT': '待验货',
  'IN_STOCK': '在库',
  'SHIPPED': '已出库',
  'LOSS': '报损',
  'SPLIT': '已拆分',
  'CANCELLED': '已撤销',
  'PENDING': '待处理',
  'DONE': '已完成',
  'COMPLETED': '已完成',
}

var INSPECTION_ACTION_LABEL = {
  'INBOUND': '已入库',
  'REJECT': '已拒签',
}

var INSPECTION_RESULT_LABEL = {
  'PASSED': '验货通过',
  'MISMATCH': '货不对板',
}

var STOCK_EVENT_LABEL = {
  'PURCHASE': '采购下单',
  'INSPECT': '验货',
  'INBOUND': '入库上架',
  'NEGOTIATE': '议价定价',
  'OUTBOUND': '销售出库',
  'RETURN': '退货入库',
  'LOSS': '报损',
  'OVERFLOW': '盘盈',
  'REJECT': '验货拒签',
  'RFID_BIND': '绑定 RFID',
  'RFID_UNBIND': '解绑 RFID',
  'RECODE': '货号迁移',
  'BARCODE_SET': '69码更换',
  'SPLIT': '库存拆分',
}

var RETURN_STATUS_LABEL = {
  'RETURNING': '退货中',
  'PENDING_INBOUND': '待入库',
  'ABNORMAL': '退回异常',
  'DONE': '已完成',
  'CANCELLED': '已取消',
}

var RETURN_STATUS_TAG = {
  'RETURNING': 'tag-warning',
  'PENDING_INBOUND': 'tag-info',
  'ABNORMAL': 'tag-danger',
  'DONE': 'tag-success',
  'CANCELLED': 'tag-pending',
}

var STATUS_TAG = {
  'PENDING_INSPECT': 'tag-warning',
  'IN_STOCK': 'tag-success',
  'SHIPPED': 'tag-info',
  'LOSS': 'tag-danger',
  'CANCELLED': 'tag-pending',
}

var SALE_STATUS_LABEL = {
  'PENDING': '待发货',
  'SHIPPED': '待签收',
  'COMPLETED': '已完成',
}

var SALE_STATUS_TAG = {
  'PENDING': 'tag-warning',
  'SHIPPED': 'tag-info',
  'COMPLETED': 'tag-success',
}

var ROLE_LABEL = {
  'PURCHASER': '采购员',
  'WAREHOUSE': '仓管员',
  'NEGOTIATOR': '议价员',
  'SALES': '销售员',
  'FINANCE': '财务',
  'ADMIN': '管理员',
}

var WAREHOUSE_PHASE_LABEL = {
  'pending_negotiation': '待议价',
  'pending_inbound': '待填表',
  'pending_create': '待建品',
  'listing': '上架中',
  'on_sale': '在售',
  'locked': '锁单',
  'shipped': '已出库',
}

var WAREHOUSE_PHASE_TAG = {
  'pending_negotiation': 'tag-warning',
  'pending_inbound': 'tag-pending',
  'pending_create': 'tag-warning',
  'listing': 'tag-info',
  'on_sale': 'tag-success',
  'locked': 'tag-warning',
  'shipped': 'tag-info',
}

var RESERVE_SOURCE_LABEL = {
  'SWITCH': '切单占用',
  'PLATFORM_SOLD': '待发货',
}

var LISTING_STATUS_LABEL = {
  'DRAFT': '草稿',
  'READY': '待创建',
  'CREATED': '已建品',
  'PUBLISHING': '上架中',
  'PUBLISHED': '已发布',
  'FAILED': '失败',
}

var SHOP_LISTING_LABEL = {
  'PENDING': '待上架',
  'LISTING': '上架中',
  'LISTED': '在架',
  'SOLD': '已售',
  'DELISTED': '已下架',
  'FAILED': '失败',
}

function statusLabel(s) {
  return STATUS_LABEL[s] || s
}

function statusTag(s) {
  return STATUS_TAG[s] || 'tag-pending'
}

function roleLabel(r) {
  return ROLE_LABEL[r] || r
}

function saleStatusLabel(s) {
  return SALE_STATUS_LABEL[s] || s
}

function saleStatusTag(s) {
  return SALE_STATUS_TAG[s] || 'tag-pending'
}

function price(val) {
  if (val === undefined || val === null || val === '') return '—'
  return val
}

// 整数部分每三位插入千分符，兼容负号与小数部分（WXS 无 toLocaleString）
function addThousands(text) {
  var neg = text.charAt(0) === '-'
  var body = neg ? text.slice(1) : text
  var dot = body.indexOf('.')
  var intPart = dot >= 0 ? body.slice(0, dot) : body
  var rest = dot >= 0 ? body.slice(dot) : ''
  var grouped = ''
  var count = 0
  for (var i = intPart.length - 1; i >= 0; i--) {
    grouped = intPart.charAt(i) + grouped
    count++
    if (count % 3 === 0 && i > 0) grouped = ',' + grouped
  }
  return (neg ? '-' : '') + grouped + rest
}

// 金额展示：整数不带 .00，小数保留两位，千分符分组
function money(val) {
  if (val === undefined || val === null || val === '') return '—'
  var n = parseFloat(val)
  if (isNaN(n)) return val
  var rounded = Math.round(n * 100) / 100
  var text = rounded === Math.round(rounded) ? Math.round(rounded) + '' : rounded.toFixed(2)
  return addThousands(text)
}

function toStr(val) {
  if (val === undefined || val === null) return ''
  return val + ''
}

function trimDecimalZero(text) {
  var len = text.length
  if (len >= 2 && text.slice(len - 2, len) === '.0') {
    return text.slice(0, len - 2)
  }
  return text
}

// 统计卡片用：大金额压缩为「万/亿」，避免三列卡片溢出
function statMoney(val) {
  if (val === undefined || val === null || val === '') return '0'
  var n = parseFloat(val)
  if (isNaN(n)) return toStr(val)
  if (n >= 100000000) {
    var yi = n / 100000000
    return addThousands(trimDecimalZero(yi.toFixed(1))) + '亿'
  }
  if (n >= 100000) {
    var wan = n / 10000
    return addThousands(trimDecimalZero(wan.toFixed(1))) + '万'
  }
  return money(n)
}

// 按字符长度返回字号档位 class（用于 ws-num / st-num）
function numScale(val) {
  var len = toStr(val).length
  if (len <= 6) return 'num--lg'
  if (len <= 9) return 'num--md'
  if (len <= 12) return 'num--sm'
  return 'num--xs'
}

var OSS_PREFIX = '__OSS_UNAVAILABLE__|'

function isArchived(url) {
  if (!url) return false
  return toStr(url).indexOf(OSS_PREFIX) === 0
}

function datetime(val) {
  if (val == null || val === '') return ''
  var text = toStr(val).replace('T', ' ')
  if (text.length >= 19) return text.slice(0, 19)
  return text
}

function inspectionActionLabel(actionType) {
  return INSPECTION_ACTION_LABEL[actionType] || ''
}

function inspectionResultLabel(result) {
  return INSPECTION_RESULT_LABEL[result] || ''
}

function stockEventLabel(eventType) {
  return STOCK_EVENT_LABEL[eventType] || eventType || '—'
}

function productLine(title, spec) {
  var t = toStr(title).trim()
  var s = toStr(spec).trim()
  if (!t) return s || '—'
  if (!s) return t
  return t + ' · ' + s
}

function displayMoney(val) {
  return money(val)
}

function platformLabel(shopName, platform) {
  var name = toStr(shopName).trim()
  if (name) return name
  return toStr(platform) || '闲鱼'
}

function iconChar(title) {
  var t = toStr(title).trim()
  if (!t) return '单'
  return t.substring(0, 1)
}

function warehousePhaseLabel(phase) {
  return WAREHOUSE_PHASE_LABEL[phase] || phase || '—'
}

function warehousePhaseTag(phase) {
  return WAREHOUSE_PHASE_TAG[phase] || 'tag-pending'
}

function warehouseItemLabel(item) {
  if (!item) return '—'
  if (item.status === 'SPLIT') return '已拆分'
  if (item.reserve_source) {
    return RESERVE_SOURCE_LABEL[item.reserve_source] || warehousePhaseLabel(item.warehouse_phase)
  }
  return warehousePhaseLabel(item.warehouse_phase) || statusLabel(item.status)
}

function warehouseItemTag(item) {
  if (!item) return 'tag-pending'
  if (item.reserve_source === 'PLATFORM_SOLD') return 'tag-warning'
  if (item.reserve_source === 'SWITCH') return 'tag-pending'
  return warehousePhaseTag(item.warehouse_phase) || statusTag(item.status)
}

/**
 * 历史迁移商品「待核验」判定:老系统迁入(LEGACY_IMPORT)且关键资料
 * (序列号/实拍图/定位图/库位)任一缺失。仓库在编辑页补齐后自动消除。
 */
function legacyPendingVerify(item) {
  if (!item || !item.tags || item.tags.indexOf('LEGACY_IMPORT') < 0) return false
  if (!item.serial_number) return true
  if (!item.images || !item.images.length) return true
  if (!item.location_images || !item.location_images.length) return true
  if (!item.location_code) return true
  return false
}

function listingStatusLabel(s) {
  return LISTING_STATUS_LABEL[s] || s || '—'
}

function listingStatusTag(s) {
  if (!s || s === 'DRAFT') return 'tag-warning'
  if (s === 'READY' || s === 'CREATED') return 'tag-info'
  if (s === 'PUBLISHING') return 'tag-warning'
  if (s === 'PUBLISHED') return 'tag-success'
  if (s === 'FAILED') return 'tag-danger'
  return 'tag-pending'
}

function shopListingLabel(s) {
  return SHOP_LISTING_LABEL[s] || s || '—'
}

// 新群控异步:结合 gc_pending 展示「处理中」态。
// LISTING=上架中(处理中);LISTED+pending=下架中(处理中);LISTED=在架;DELISTED=已下架。
function shopStateLabel(s, pending) {
  if (s === 'LISTED' && pending) return '下架中'
  return SHOP_LISTING_LABEL[s] || s || '—'
}

function shopStateTag(s, pending) {
  if (s === 'LISTING') return 'tag-info'
  if (s === 'LISTED') return pending ? 'tag-info' : 'tag-success'
  if (s === 'SOLD') return 'tag-info'
  if (s === 'FAILED') return 'tag-danger'
  return 'tag-pending'
}

function returnStatusLabel(s) {
  return RETURN_STATUS_LABEL[s] || s || '—'
}

function returnStatusTag(s) {
  return RETURN_STATUS_TAG[s] || 'tag-pending'
}

module.exports = {
  statusLabel: statusLabel,
  statusTag: statusTag,
  saleStatusLabel: saleStatusLabel,
  saleStatusTag: saleStatusTag,
  price: price,
  money: money,
  statMoney: statMoney,
  numScale: numScale,
  roleLabel: roleLabel,
  isArchived: isArchived,
  datetime: datetime,
  inspectionActionLabel: inspectionActionLabel,
  inspectionResultLabel: inspectionResultLabel,
  stockEventLabel: stockEventLabel,
  productLine: productLine,
  displayMoney: displayMoney,
  platformLabel: platformLabel,
  iconChar: iconChar,
  warehousePhaseLabel: warehousePhaseLabel,
  warehousePhaseTag: warehousePhaseTag,
  warehouseItemLabel: warehouseItemLabel,
  warehouseItemTag: warehouseItemTag,
  legacyPendingVerify: legacyPendingVerify,
  listingStatusLabel: listingStatusLabel,
  listingStatusTag: listingStatusTag,
  shopListingLabel: shopListingLabel,
  shopStateLabel: shopStateLabel,
  shopStateTag: shopStateTag,
  returnStatusLabel: returnStatusLabel,
  returnStatusTag: returnStatusTag,
}
