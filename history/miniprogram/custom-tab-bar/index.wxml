<view class="tab-bar" wx:if="{{tabs.length}}">
  <view
    wx:for="{{tabs}}"
    wx:key="key"
    class="tab-item {{selected === index ? 'active' : ''}}"
    data-path="{{item.pagePath}}"
    data-index="{{index}}"
    bindtap="onSwitch"
    hover-class="tab-item--pressed"
    hover-stay-time="80"
  >
    <view class="tab-icon-wrap">
      <view class="tab-icon tab-icon--{{item.key}}"></view>
    </view>
    <text class="tab-text">{{item.text}}</text>
  </view>
</view>
