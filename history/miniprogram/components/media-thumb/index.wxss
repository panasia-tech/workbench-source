.media-thumb {
  position: relative;
  overflow: hidden;
  border-radius: 12rpx;
  background: #F9FAFB;
  border: 1rpx solid #E5E7EB;
  flex-shrink: 0;
}

.media-thumb--small {
  width: 120rpx;
  height: 120rpx;
}

.media-thumb--medium {
  width: 160rpx;
  height: 160rpx;
}

.media-thumb--large {
  width: 240rpx;
  height: 240rpx;
}

.media-thumb--fill {
  width: 100%;
  height: 320rpx;
}

.media-thumb__img,
.media-thumb__video {
  width: 100%;
  height: 100%;
  display: block;
}

.media-thumb__video-wrap {
  width: 100%;
  height: 100%;
  position: relative;
}

.media-thumb__badge {
  position: absolute;
  right: 8rpx;
  bottom: 8rpx;
  padding: 4rpx 12rpx;
  font-size: 20rpx;
  color: #fff;
  background: rgba(0, 0, 0, 0.55);
  border-radius: 8rpx;
}

.media-thumb--archived {
  border-style: dashed;
  border-color: #9CA3AF;
  background: #F9FAFB;
}

.media-thumb__archived {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  padding: 12rpx;
  text-align: center;
}

.media-thumb__archived-icon {
  font-size: 40rpx;
  line-height: 1;
  opacity: 0.85;
}

.media-thumb__archived-text {
  font-size: 24rpx;
  font-weight: 700;
  color: #6B7280;
}

.media-thumb__archived-hint {
  font-size: 20rpx;
  color: #9CA3AF;
}

.media-thumb__placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #9CA3AF;
  font-size: 28rpx;
}
