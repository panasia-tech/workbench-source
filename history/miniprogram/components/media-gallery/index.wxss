.media-gallery {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 16rpx;
}

.media-gallery__item {
  flex-shrink: 0;
  position: relative;
}

.media-gallery__remove {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.65);
  color: #fff;
  font-size: 26rpx;
  line-height: 36rpx;
  text-align: center;
  z-index: 2;
}
