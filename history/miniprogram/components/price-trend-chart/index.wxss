.ptc {
  display: block;
  width: 100%;
}

.ptc-stage-wrap {
  position: relative;
  width: 100%;
}

.ptc-stage {
  position: relative;
  width: 100%;
  overflow: hidden;
  border-radius: 20rpx;
}

.ptc-img {
  display: block;
  width: 100%;
  height: auto;
  animation: ptc-fade 0.4s ease-out both;
}

@keyframes ptc-fade {
  from { opacity: 0; transform: translateY(8rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* 十字线 */
.ptc-cross {
  position: absolute;
  width: 2rpx;
  background: linear-gradient(180deg, rgba(18, 174, 248, 0) 0%, rgba(18, 174, 248, 0.55) 18%, rgba(18, 174, 248, 0.55) 82%, rgba(18, 174, 248, 0) 100%);
  transform: translateX(-50%);
  pointer-events: none;
}

/* 当前点：外圈柔光 + 内圈实心 */
.ptc-dot-ring,
.ptc-dot {
  position: absolute;
  border-radius: 50%;
  transform: translate(-50%, -50%);
  pointer-events: none;
}

.ptc-dot-ring {
  width: 40rpx;
  height: 40rpx;
  background: rgba(18, 174, 248, 0.16);
  box-shadow: 0 0 0 2rpx rgba(18, 174, 248, 0.12);
}

.ptc-dot {
  width: 16rpx;
  height: 16rpx;
  background: #12AEF8;
  border: 4rpx solid #FFFFFF;
  box-shadow: 0 4rpx 10rpx rgba(18, 174, 248, 0.35);
}

/* 深色浮层，和 H5 ECharts 的 tooltip 保持同一套观感 */
.ptc-tip {
  position: absolute;
  box-sizing: border-box;
  padding: 14rpx 16rpx;
  border-radius: 16rpx;
  color: #FFFFFF;
  background: rgba(15, 23, 42, 0.92);
  box-shadow: 0 12rpx 30rpx rgba(15, 23, 42, 0.24);
  backdrop-filter: blur(6rpx);
  pointer-events: none;
  animation: ptc-tip-in 0.16s ease-out both;
}

@keyframes ptc-tip-in {
  from { opacity: 0; transform: translateY(6rpx) scale(0.98); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}

.ptc-tip-date {
  font-size: 19rpx;
  color: rgba(255, 255, 255, 0.58);
}

.ptc-tip-price {
  margin-top: 2rpx;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1.15;
  font-variant-numeric: tabular-nums;
}

.ptc-tip-yen {
  margin-right: 2rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.ptc-tip-count {
  margin-top: 2rpx;
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.66);
}

.ptc-hint {
  position: absolute;
  right: 14rpx;
  bottom: 12rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  font-size: 18rpx;
  color: #12AEF8;
  background: rgba(255, 255, 255, 0.86);
  box-shadow: 0 2rpx 8rpx rgba(18, 174, 248, 0.12);
  pointer-events: none;
}

.ptc-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 300rpx;
  padding: 30rpx;
  box-sizing: border-box;
  border: 1rpx dashed #DDE5F2;
  border-radius: 20rpx;
  font-size: 23rpx;
  line-height: 1.6;
  text-align: center;
  color: #9CA3AF;
  background: #F8FAFD;
}
