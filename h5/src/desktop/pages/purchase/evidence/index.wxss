/* 验货凭证（电脑版模板 index.wxml 用；手机模板里没有 pe-dk- 类名） */
.pe-dk-split {
  grid-template-columns: minmax(0, 1fr) 380px;
}

.pe-dk-col {
  display: flex;
  flex-direction: column;
  gap: 16px;
  min-width: 0;
}

.pe-dk-warn {
  padding: 10px 14px;
  border-radius: 8px;
  border: 1px solid #fde68a;
  background: #fffbeb;
  color: #b45309;
  font-size: 13px;
}

.pe-dk-zoom {
  cursor: zoom-in;
}

.pe-dk-video {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 12px;
  margin-bottom: 8px;
  border: 1px solid #e5e7eb;
  border-radius: 6px;
  font-size: 13px;
  cursor: pointer;
}

.pe-dk-video:hover {
  border-color: #2563eb;
}

.pe-dk-video__play {
  width: 28px;
  height: 28px;
  flex: none;
  border-radius: 50%;
  background: #eff4ff;
  color: #2563eb;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 12px;
}

.pe-dk-video__warn {
  margin-top: 2px;
  font-size: 12px;
  color: #b45309;
}

.pe-dk-gallery {
  margin-top: 8px;
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

/* image 默认 320×240，放进网格要改成占满格子的正方形 */
.pe-dk-gallery .dk-gallery__item {
  width: 100%;
  height: auto;
  min-width: 0;
  display: block;
}

.pe-dk-photos {
  flex-wrap: nowrap;
  gap: 6px;
}

/* 异常处理：一张异常一块，平台售后和留货提议能直接改 */
.pe-dk-exc {
  padding: 12px 0;
  border-bottom: 1px solid #f3f4f6;
}

.pe-dk-exc:first-child {
  padding-top: 0;
}

.pe-dk-exc:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.pe-dk-exc__head {
  align-items: center;
  gap: 8px;
  font-size: 14px;
}

.pe-dk-facts {
  display: flex;
  flex-wrap: wrap;
  gap: 6px 18px;
  margin-top: 6px;
  font-size: 13px;
  color: #6b7280;
}

.pe-dk-v {
  color: #111827;
  font-weight: 600;
}

.pe-dk-hint {
  margin-top: 6px;
  padding: 6px 10px;
}

.pe-dk-gapline {
  margin-top: 8px;
  align-items: center;
  font-size: 13px;
}

.pe-dk-offer {
  margin-top: 2px;
  font-size: 13px;
  color: #374151;
}

.pe-dk-form {
  margin-top: 10px;
  padding: 12px 14px;
  border: 1px solid #e5e7eb;
  border-radius: 8px;
  background: #fafafa;
}

.pe-dk-line {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 10px;
}

.pe-dk-line:first-child {
  margin-top: 0;
}

.pe-dk-line--sep {
  padding-top: 10px;
  border-top: 1px dashed #e5e7eb;
}

.pe-dk-k {
  width: 64px;
  flex: none;
  margin: 0;
}

.pe-dk-chips {
  flex-wrap: wrap;
  gap: 6px;
}

.pe-dk-chip {
  padding: 4px 12px;
  border: 1px solid #d1d5db;
  border-radius: 6px;
  background: #fff;
  font-size: 13px;
  white-space: nowrap;
  cursor: pointer;
}

.pe-dk-chip--now {
  border-style: dashed;
}

.pe-dk-chip--on {
  border-color: #2563eb;
  border-style: solid;
  background: #eff6ff;
  color: #2563eb;
}

.pe-dk-pick {
  min-width: 130px;
}

.pe-dk-amt {
  width: 100px;
  flex: none;
}
