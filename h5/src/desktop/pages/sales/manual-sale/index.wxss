/* 手动销售成交（电脑版模板 index.wxml 用；通用样式在 src/styles/desktop.css） */
.ms-dk-tag {
  margin-left: 8px;
  vertical-align: middle;
  font-weight: 400;
}

.ms-dk-col {
  display: flex;
  flex-direction: column;
  gap: 16px;
  min-width: 0;
}

.ms-dk-headlink {
  font-size: 13px;
  font-weight: 400;
}

.ms-dk-empty {
  padding: 20px 8px;
}

.ms-dk-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #9ca3af;
  font-size: 18px;
}

.ms-dk-gap {
  margin-top: 12px;
}

.ms-dk-err {
  padding: 8px 12px;
  border-radius: 6px;
  background: #fef2f2;
  color: #b91c1c;
  font-size: 13px;
}

.ms-dk-warn {
  padding: 8px 12px;
  border-radius: 6px;
  background: #fffbeb;
  color: #b45309;
  font-size: 13px;
}

.ms-dk-evidence {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8px;
}

.ms-dk-add {
  width: 96px;
  height: 96px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2px;
  border: 1px dashed #d1d5db;
  border-radius: 6px;
  background: #fff;
  color: #6b7280;
  font-size: 12px;
  cursor: pointer;
}

.ms-dk-add:hover {
  border-color: #2563eb;
  color: #2563eb;
}

.ms-dk-add__plus {
  font-size: 22px;
  line-height: 1;
}

/* textarea 默认 300px 宽（同小程序），电脑上撑满 */
.ms-dk-textarea {
  width: 100%;
  height: 72px;
}

.ms-dk-amount {
  margin-right: 8px;
  font-size: 20px;
  font-weight: 600;
  color: #dc2626;
  font-variant-numeric: tabular-nums;
}

/* 内容不满一屏时操作条也贴在底部 */
.ms-dk-bar {
  margin-top: auto;
}
