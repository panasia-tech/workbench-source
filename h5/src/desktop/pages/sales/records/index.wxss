/* 销售记录（电脑版模板 index.wxml 用；通用样式在 src/styles/desktop.css） */
.rec-dk-thumb-wrap {
  position: relative;
  flex: none;
}

.rec-dk-loc-badge {
  position: absolute;
  left: 0;
  bottom: 0;
  padding: 0 4px;
  border-radius: 0 4px 0 4px;
  background: rgba(17, 24, 39, 0.7);
  color: #fff;
  font-size: 10px;
  line-height: 16px;
}

.rec-dk-thumb-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #9ca3af;
  font-size: 13px;
}

.rec-dk-name {
  max-width: 260px;
}
